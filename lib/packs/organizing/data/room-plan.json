 "donation": [
  { "id": "donate", "always": true, "title": "Donations", "line": "Ask the client where donations go, and call the store first: each store sets its own list and may decline items that aren't clean and sellable.", "src": ["habitat", "mers"] },
  { "id": "recycle", "always": true, "title": "Recycling", "line": "Recycling rules differ by city and hauler: check your city's recycling page before anything goes in the bin.", "src": [], "judgment": true },
  { "id": "receipt", "always": true, "title": "Donation receipt", "line": "Ask the charity for a donation receipt and pass it to the client. The charity doesn't set a value on the items; the client records what they gave.", "src": ["goodwill_sc"] },
  { "id": "refused", "words": ["mattress", "box spring", "crib", "car seat", "stroller", "tv", "television", "futon", "sofa bed", "pull-out", "broken", "damaged"], "rooms": ["bedroom", "kids", "basement"], "title": "Items most stores refuse", "line": "Mattresses and box springs, cribs and car seats, old CRT TVs, paint and chemicals, and damaged furniture are on most donation stores' do-not-take lists. Call first, and check your city for bulk pickup.", "src": ["goodwill_tx", "mers", "goodwill_sc"] },
  { "id": "hhw", "words": ["chemical", "cleaner", "cleaning supplies", "solvent", "thinner", "pesticide", "weed killer", "bug spray", "motor oil", "antifreeze", "bleach", "propane", "aerosol", "gasoline", "old paint", "paint can"], "rooms": ["garage", "basement", "laundry"], "title": "Paint and chemicals", "line": "Paint, cleaners, oils and pesticides are household hazardous waste: keep them in their original containers, never mix them, and check your city or county for a drop-off day.", "src": ["epa_hhw"] },
  { "id": "batteries", "words": ["battery", "batteries", "charger", "power bank", "vape"], "rooms": ["garage", "office"], "title": "Batteries", "line": "Lithium-ion and button batteries never go in the trash or the recycling bin: tape the ends or bag each one and take them to a battery drop-off. Check your city about alkaline batteries.", "src": ["epa_batteries"] },
  { "id": "electronics", "words": ["electronic", "electronics", "phone", "laptop", "computer", "tablet", "tv", "television", "printer", "monitor", "camera", "cord", "cable", "router"], "rooms": ["office"], "title": "Electronics", "line": "Old phones and computers: the client deletes their personal data and the batteries come out first. Then check your city or state for a donation or recycling program.", "src": ["epa_electronics"] },
  { "id": "medicine", "words": ["medicine", "medication", "meds", "pill", "prescription", "vitamin"], "rooms": ["bathroom"], "title": "Medicines", "line": "Old medicines: a drug take-back site or a mail-back envelope first. Flush only what is on the FDA flush list; otherwise mix with coffee grounds or cat litter in a sealed bag. The client handles them, and you never take medicines away.", "src": ["fda"] },
  { "id": "papers", "words": ["papers", "paperwork", "mail", "file", "filing", "bill", "receipt", "statement", "document", "tax", "taxes", "shred"], "rooms": ["office"], "title": "Papers", "line": "The client decides what to keep. The IRS says to keep tax records until the period of limitations runs out (generally 3 years, longer in some cases), so tax papers wait for the client or their tax preparer. Shred account numbers only with the client's okay.", "src": ["irs"] },
  { "id": "clothes", "words": ["clothes", "clothing", "shirt", "pant", "jean", "dress", "coat", "jacket", "sweater", "shoe", "boot", "outgrown", "hand-me-down"], "rooms": ["reachin", "walkin", "bedroom", "kids", "entry"], "title": "Clothes and shoes", "line": "Clothes, shoes and accessories in clean condition can go to a donation store that lists them (the Goodwill stores we checked do). Check the store's list first.", "src": ["goodwill_tx", "goodwill_sc"] },
  { "id": "furniture", "words": ["furniture", "chair", "dresser", "bookcase", "bookshelf", "sofa", "couch", "lamp", "appliance", "lumber", "tile", "building material"], "rooms": ["garage", "basement"], "title": "Furniture and building materials", "line": "Furniture, appliances and leftover building materials in good shape can go to a Habitat ReStore. Call your ReStore to confirm, and ask about pickup for large items.", "src": ["habitat"] },
  { "id": "food", "words": ["food", "expired", "snack", "cereal", "canned", "jar", "spice", "leftover"], "rooms": ["kitchen", "pantry"], "title": "Food and packaging", "line": "Expired food goes in the trash or compost. Empty jars, cans and boxes go in recycling only if your city takes them: check your city.", "src": [], "judgment": true },
  { "id": "keepsakes", "words": ["keepsake", "photo", "album", "memorabilia", "sentimental", "heirloom", "inherited", "yearbook"], "rooms": ["basement"], "title": "Keepsakes", "line": "Keepsakes and photos never go in a donate pile without the client's yes. Set them aside in one labeled box to decide later.", "src": [], "judgment": true }
 ],
 "photo": {
  "permission": "Ask first, in writing: before photos, after photos, and whether you may ever share them. Without a written yes, take none.",
  "steps": [
   "Before photos at the start: one wide shot from the doorway, then one of each zone in today's plan.",
   "Mark where you stood (a strip of painter's tape on the floor works) so the after photo matches: same spot, same height, same angle, doors and drawers open the same way.",
   "Keep anything personal out of frame: faces, family photos, mail and papers, prescription labels, screens and the house number.",
   "After photos at the wrap-up, from the same marks.",
   "Store them privately, share only what the client approved in writing, and delete them when the client asks."
  ],
  "src": ["napo"]
 }
}

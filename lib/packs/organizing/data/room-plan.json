 "sources": {
  "everyday": { "publisher": "Everyday Organize", "url": "https://www.everydayorganize.com/blog/professional-organizer-cost-kansas-city", "says": "Room estimates by organizers and hours: playroom 2 for 4 to 6 hours; kitchen or pantry 2 for 5 to 8; kitchen and pantry 3 for 6 to 8; storage room 2 for 7 to 9; garage 3 for 6 to 7; primary closet 2 for 5 to 7; primary suite 3 for 6 to 8. Decluttering takes additional time because those decisions are personal.", "page_date": "2026-09-17", "checked": "2026-10-19" },
  "fixr": { "publisher": "Fixr", "url": "https://www.fixr.com/costs/professional-organizer", "says": "Closet $150 to $250; room $200 to $300; kitchen $250 to $400 as one 3-hour session including the pantry; home office $250 to $400; garage $1,000 to $2,500. Most projects cannot be completed properly in less than 3 hours, even for a single room or closet space.", "page_date": "2025-01-31", "checked": "2026-10-19" },
  "costhelper": { "publisher": "CostHelper", "url": "https://home.costhelper.com/professional-organizer.html", "says": "TAOrganizing estimates the average room takes 8 to 12 hours.", "checked": "2026-10-19" },
  "homeadvisor": { "publisher": "HomeAdvisor", "url": "https://www.homeadvisor.com/cost/storage-and-organization/hire-a-professional-organizer/", "says": "Most projects take between two and ten hours to complete.", "page_date": "2026-06-17", "checked": "2026-10-19" },
  "airtasker": { "publisher": "Airtasker", "url": "https://www.airtasker.com/us/costs/home-organizing/professional-organizer-cost/", "says": "Typical total task costs: small task of 1 to 2 hours $75 to $180; closet $100 to $275; pantry $120 to $300; garage or storage room $300 to $800.", "page_date": "2026-06-24", "checked": "2026-10-19" },
  "habitat": { "publisher": "Habitat for Humanity ReStore", "url": "https://www.habitat.org/restores/donate-goods", "says": "ReStores accept new or gently used furniture, appliances, housewares and building materials; many offer free pickup of large items; call your ReStore and confirm donation hours; each ReStore is unique.", "checked": "2026-10-19" },
  "goodwill_tx": { "publisher": "Goodwill Central Texas", "url": "https://www.goodwillcentraltexas.org/donate/donate-goods/", "says": "Accepts clothing, shoes, accessories and electronics; cannot accept cribs, strollers and car seats, mattresses and box springs, CRT or plasma TVs, damaged furniture, paint, solvents and pesticides.", "checked": "2026-10-19" },
  "mers": { "publisher": "MERS Goodwill", "url": "https://www.mersgoodwill.org/donate/", "says": "Store managers may decline a donation that is not in clean and sellable condition; no mattresses or box springs, CRT TVs, household chemicals or furniture over 40 inches.", "checked": "2026-10-19" },
  "goodwill_sc": { "publisher": "Goodwill (South Carolina)", "url": "https://www.goodwillsc.org/donate/goods/", "says": "Accepts clothes, shoes and boots; can't accept cribs, car seats, mattresses, hazardous liquids or CRT TVs; Goodwill can't establish or confirm the value of donated items.", "checked": "2026-10-19" },
  "epa_hhw": { "publisher": "U.S. EPA", "url": "https://www.epa.gov/hw/household-hazardous-waste-hhw", "says": "Paints, cleaners, oils, batteries and pesticides need special care; keep them in their original containers, never mix them, and check with your local agency for collection days.", "page_date": "2026-06-01", "checked": "2026-10-19" },
  "epa_batteries": { "publisher": "U.S. EPA", "url": "https://www.epa.gov/recycle/used-household-batteries", "says": "Tape lithium-ion battery terminals or bag each battery, and never put them in household garbage or recycling bins; check with your local or state solid waste authority about alkaline batteries.", "page_date": "2026-07-21", "checked": "2026-10-19" },
  "epa_electronics": { "publisher": "U.S. EPA", "url": "https://www.epa.gov/recycle/electronics-donation-and-recycling", "says": "Delete all personal information from your electronics, remove batteries, and check for recycling facilities in your state or community.", "page_date": "2025-12-19", "checked": "2026-10-19" },
  "fda": { "publisher": "U.S. FDA", "url": "https://www.fda.gov/drugs/safe-disposal-medicines/disposal-unused-medicines-what-you-should-know", "says": "Use a drug take-back location or a mail-back envelope first; flush only medicines on the flush list; otherwise mix them with cat litter or used coffee grounds in a sealed bag and scratch out personal information.", "page_date": "2024-10-31", "checked": "2026-10-19" },
  "irs": { "publisher": "IRS", "url": "https://www.irs.gov/businesses/small-businesses-self-employed/how-long-should-i-keep-records", "says": "Keep records until the period of limitations runs out: generally 3 years, longer in some cases (6 or 7 years).", "page_date": "2026-06-30", "checked": "2026-10-19" },

 "stages": {
  "labels": {
   "now": "Before your first customer",
   "later": "After your first customers",
   "when": "Only if it applies to you"
  },
  "rules": [
   {
    "match": "only once you hire|when you hire|employee|workers comp",
    "stage": "when",
    "why": "Only once you hire someone."
   },
   {
    "match": "if applicable|if you drive|commercial auto",
    "stage": "when",
    "why": "Only if your insurer or state requires it. Ask your insurance agent."
   },
   {
    "match": "\\bbond\\b",
    "stage": "when",
    "why": "When a client or your state asks for it."
   },
   {
    "match": "snow",
    "stage": "when",
    "why": "Only if you sell snow removal, and after the contracts are signed."
   },
   {
    "match": "\\(if |\\bif you\\b|if parents|if schools",
    "stage": "when",
    "why": "Only if this applies to you."
   },
   {
    "match": "\\boptional\\b|local services ads|\\bads\\b|advertis",
    "stage": "later",
    "why": "Optional. Start with people you know and your neighborhood first."
   },
   {
    "match": "scheduling|invoic|\\bcrm\\b|booking|field service software",
    "stage": "later",
    "why": "A free calendar and free invoices from your payment app work for your first customers."
   },
   {
    "match": "\\(later\\b|, later\\b",
    "stage": "later",
    "why": "Sources list this as a later buy. Wait until your jobs need it."
   },
   {
    "match": "water tank|generator|hot water unit|water-fed pole",
    "stage": "later",
    "why": "Use the customer's water and power at first. Buy it when your jobs need it."
   },
   {
    "match": "trailer|\\btruck\\b|\\bvan\\b|wrap|\\bplow\\b|zero-turn",
    "stage": "later",
    "why": "Wait until your customers need it and their payments can cover it."
   },
   {
    "match": "vehicle sign|magnetic|uniform|shirts|logo",
    "stage": "later",
    "why": "Nice to have. Your first customers come from people you talk to."
   }
  ],
  "aggregate": ", total$|\\btotal\\b"
 }

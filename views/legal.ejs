<%- include('partials/head') %>
<main class="wrap doc" style="padding:80px 24px">
  <div class="eyebrow">127 Group LLC</div>
  <% if (kind === 'membership') { %>
  <% if (process.env.MEMBERSHIP_TERMS_LIVE !== 'true') { %><div class="alert info" style="margin-bottom:24px">Draft for review. These terms are not in effect yet.</div><% } %>
  <%- include('partials/membership-terms') %>
  <% } else if (kind === 'cookies' || kind === 'earnings') { %>
  <%# Drafts from Legal (node scripts/build-membership-terms.js --cookies / --earnings) until Eli approves: COOKIE_NOTICE_LIVE / EARNINGS_DISCLAIMER_LIVE. %>
  <% if (process.env[kind === 'cookies' ? 'COOKIE_NOTICE_LIVE' : 'EARNINGS_DISCLAIMER_LIVE'] !== 'true') { %><div class="alert info" style="margin-bottom:24px">Draft for review. This page is not in effect yet.</div><% } %>
  <%- include(kind === 'cookies' ? 'partials/cookie-notice' : 'partials/earnings-disclaimer') %>
  <% if (kind === 'cookies') { %><p style="margin-top:24px"><a href="/cookies" class="btn ghost sm" data-cookie-settings>Cookie settings</a></p><% } %>
  <% } else if (kind === 'circle') { %>
  <% if (process.env.CIRCLE_AGREEMENT_LIVE !== 'true') { %><div class="alert info" style="margin-bottom:24px">Draft for review. This agreement is not in effect yet.</div><% } %>
  <%- include('partials/circle-agreement') %>
  <% } else if ((kind === 'privacy' && process.env.PRIVACY_LIVE === 'true') || (kind === 'terms' && process.env.TERMS_LIVE === 'true')) { %>
  <%# Legal's 01 and 02, built by scripts/build-membership-terms.js --terms / --privacy. Live only once Eli approves the final text (Legal handoff item 1). %>
  <%- include(kind === 'privacy' ? 'partials/privacy-policy' : 'partials/terms-of-service') %>
  <% } else { %>
  <h1><%= kind === 'privacy' ? 'Privacy' : 'Terms' %></h1>
  <div class="alert info">Placeholder. Replace with a reviewed <%= kind === 'privacy' ? 'privacy policy' : 'terms of service, refund and cancellation policy' %> before launch.</div>
  <% if (kind === 'privacy') { %>
  <p>We collect only what we need to run your account and personalize your roadmap: your name, email, onboarding answers, progress, and billing status (handled by Stripe; we never see your full card number).</p>
  <p>We don't sell your data. You can delete your account anytime from Settings. We keep limited billing and consent records afterward, as the law requires.</p>
  <% } else { %>
  <p>Memberships renew monthly until cancelled. You can cancel anytime from the billing page and keep access until the end of the paid period.</p>
  <p>Content and AI output are educational and are not legal, tax or financial advice.</p>
  <% } %>
  <% } %>
</main>
<%- include('partials/foot') %>

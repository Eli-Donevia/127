<%- include('../partials/head') %>
<%# The verticals board (lib/verticals.js board()): visit -> free signup -> pack -> Builder per vertical, with verdicts
    from content/verticals/_rules.json. Counts only: no emails or names. %>
<% var pct = function (x) { return x ? (x * 100).toFixed(x < 0.1 ? 1 : 0) + '%' : '0%'; }; var usd = function (x) { return x == null ? '·' : '$' + Math.round(x); }; %>
<main class="vt vb">
  <div class="wrap">
    <h1 class="vb-h1">Verticals</h1>
    <p class="vb-sub">Visits and free starts are counted once per visitor per day. A signup is a new account or a founding list join from someone who came in on the vertical. Paid is a pack bought plus a Builder start. Switch: <b>VERTICALS=<%= setting %></b>. <a href="/admin/verticals/week">This week's readout</a> · <a href="/for">The pages</a></p>
    <nav class="vb-tabs" aria-label="Range">
      <a href="/admin/verticals?range=7"<% if (span === '7') { %> aria-current="page"<% } %>>7 days</a>
      <a href="/admin/verticals?range=30"<% if (span === '30') { %> aria-current="page"<% } %>>30 days</a>
      <a href="/admin/verticals?range=all"<% if (span === 'all') { %> aria-current="page"<% } %>>All time</a>
    </nav>
    <div class="vb-totals">
      <span><b><%= totals.visits %></b>visits</span><span><b><%= totals.starts %></b>free starts</span><span><b><%= totals.signups %></b>signups</span><span><b><%= totals.packs %></b>packs</span><span><b><%= totals.builders %></b>Builder</span><span><b><%= usd(totals.spend) %></b>spend</span>
    </div>
    <% if (problems.length) { %><div class="vb-problems"><b><%= problems.length %> problem<%= problems.length === 1 ? '' : 's' %>, those verticals stay off:</b><br><%= problems.slice(0, 8).join(' · ') %></div><% } %>
    <table class="vb-table">
      <thead><tr><th>Vertical</th><th>Verdict</th><th>Visits</th><th>Free starts</th><th>Signups</th><th>Packs</th><th>Builder</th><th>Paid / 100 visits</th><th>Spend</th><th>$ / paid</th></tr></thead>
      <tbody>
        <% rows.forEach(function (r) { %>
        <tr<% if (r.verdict === 'off') { %> class="is-off"<% } %>>
          <td><a href="/admin/verticals/<%= r.slug %>"><%= r.name %></a><small><%= r.group %> · <%= r.status %><% if (r.wave) { %> · wave <%= r.wave %><% } %></small></td>
          <td data-l="Verdict"><span class="vb-v <%= r.verdict %>"><%= { double: 'Double down', kill: 'Kill', keep: 'Keep testing', early: 'Too early', off: 'Off' }[r.verdict] %></span><span class="vb-why"><%= r.why %></span></td>
          <td data-l="Visits"><%= r.visits %></td>
          <td data-l="Free starts"><%= r.starts %> <span class="vb-dim"><%= pct(r.startRate) %></span></td>
          <td data-l="Signups"><%= r.signups %> <span class="vb-dim"><%= pct(r.signupRate) %></span></td>
          <td data-l="Packs"><%= r.packs %><% if (r.packRevenue) { %> <span class="vb-dim">$<%= Math.round(r.packRevenue) %></span><% } %></td>
          <td data-l="Builder"><%= r.builders %></td>
          <td data-l="Paid/100"><%= r.paidPer100.toFixed(1) %></td>
          <td data-l="Spend"><%= r.spend ? usd(r.spend) : '·' %></td>
          <td data-l="$ / paid"><%= usd(r.costPerPaid) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="vb-sub">Verdict lines: <%= rules.minVisits %> visits before judging; kill under <%= pct(rules.killSignupRate) %> signups, or <%= rules.killSignupsNoPaid %> signups with nobody paying, or $<%= rules.killSpendNoPaid %> spent with nobody paying; double down at <%= rules.doubleMinPaid %>+ paid, <%= pct(rules.doubleSignupRate) %>+ signups and <%= rules.doubleVsMedian %>x the median paid per 100 visits. Change them in content/verticals/_rules.json.</p>
  </div>
</main>
<%- include('../partials/foot') %>

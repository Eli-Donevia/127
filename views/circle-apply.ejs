<%- include('partials/doc-start') %>
<body class="bare">
  <div class="bare-top"><a href="/" class="mark"><img src="/img/127-emerald.png" srcset="/img/127-emerald.png 2x, /img/127-emerald@3x.png 3x" width="46" height="24" alt="127" class="logo"></a><a href="/login?next=/app/circle" class="small link">Have an account? Sign in</a></div>
  <main class="auth-card fade-in">
    <div class="eyebrow" style="color:var(--gold)">Founder's Circle · By application</div>
    <h1 style="margin-top:12px">Apply for a seat</h1>
    <p class="muted" style="margin:0 0 28px">First, your account. The six-question application is on the next screen.</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="post" action="/circle/apply">
      <label class="field"><span>Name</span><input class="input" name="name" required autocomplete="name" maxlength="80" value="<%= form.name || '' %>" autofocus></label>
      <label class="field"><span>Email</span><input class="input" type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>"></label>
      <label class="field"><span>Password</span><input class="input" type="password" name="password" minlength="8" required autocomplete="new-password" placeholder="At least 8 characters"></label>
      <label class="check" style="margin:4px 0 18px"><input type="checkbox" name="optin" <%= form.optin ? 'checked' : '' %>> Send me founder emails and the weekly digest. Unsubscribe anytime.</label>
      <p class="consent-line" style="margin:0 0 18px">By creating an account, you confirm you're 18 or older and agree to the <a href="/terms" target="_blank">Terms</a> and <a href="/privacy" target="_blank">Privacy Policy</a>.</p>
      <button class="btn gold block">Continue to the application</button>
    </form>
  </main>
</body>
</html>

<%# PACKS (SHOP_PACKS, lib/shop.js): one-tap checkout on the homepage. Each Buy posts straight to Stripe Checkout
    (no account needed); a cancelled checkout comes back to #packs. Builder includes every pack (builderGetsAll). %>
<% var hp = packs; var paidPacks = hp.list.filter(function (p) { return !p.free; }); var starter = hp.list.find(function (p) { return p.free; }); %>
<section class="hp" id="packs" aria-labelledby="hp-h">
  <div class="wrap">
    <div class="hp-head">
      <p class="lbl" data-reveal>Packs</p>
      <h2 class="h2" id="hp-h" data-reveal>Take the files.<br><span class="dim">Pay once.</span></h2>
      <p class="sub" data-reveal>Site designs, motion, prompts and templates, bundled by job. One payment, yours to keep<% if (hp.builderGetsAll) { %>, and every pack comes with Builder<% } %>.</p>
    </div>
    <ul class="hp-row">
      <% paidPacks.forEach(function (p) { %>
      <li class="hp-card hp-<%= p.art %>" data-reveal>
        <a class="hp-link" href="/packs/<%= p.slug %>"><span class="hp-t"><%= p.name %></span><span class="hp-s"><%= p.line %></span><span class="hp-c"><%= p.count %> files</span></a>
        <div class="hp-buy"><span class="hp-price">$<%= p.price %></span><%- include('../packs/buy', { p: p, ownedList: hp.owned, buyFrom: '/#packs', buyLabel: 'Buy' }) %></div>
      </li>
      <% }) %>
    </ul>
    <div class="hp-foot" data-reveal>
      <% if (hp.bundle) { %><form method="post" action="/packs/<%= hp.bundle.slug %>/buy" class="hp-all"><input type="hidden" name="from" value="/#packs"><button class="btn ghost sm" type="submit">All paid packs · $<%= hp.bundle.price %></button></form><% } %>
      <% if (starter) { %><a class="hp-starter" href="/packs/starter">The <%= starter.name %> is free with an account <span class="arrow"></span></a><% } %>
      <a class="hp-starter" href="/packs">See every pack <span class="arrow"></span></a>
    </div>
  </div>
</section>

<%
  // Plan cards in three states (conversion/pages/pricing.md): A before doors open, B founding window, C evergreen.
  // No "Most members" flag and no reference price; the founding note is lilac, gold stays on the Circle.
  // plansEvent / plansState override the Plausible event and its state prop (the homepage sends home_pricing_cta, A1/A2/B/C).
  // plansAnchor (the pricing page) shows the Circle first on desktop as the price anchor (offer.md section 6, v2 playbook 2.2.8);
  // phones keep Free, Builder, Circle. Plan clicks then carry order: circle-first, so the change can be measured.
  var ps = launch.prelaunch ? 'A' : launch.foundingOpen ? 'B' : 'C';
  var fp = ps !== 'C' && launch.foundingPrice ? launch.foundingPrice : null;
  var rcP = typeof resourceCount !== 'undefined' ? resourceCount : (typeof resources !== 'undefined' ? resources.length : 18);
  var cap = launch.cap;
  var anchor = typeof plansAnchor !== 'undefined' && plansAnchor;
  var CARDS = {
    free: {
      flag: 'Start here',
      line: "Your personalized roadmap, starter playbooks and a taste of Eli's Playbook.",
      items: ['The assessment and weeks 1 and 2 of your roadmap, with the playbooks and templates those weeks use', 'The Idea Test, the interview scripts and the content calendar', PLANS.free.aiRunsPerMonth + " Eli's Playbook messages a month", 'Progress, milestones and the wins board'],
    },
    builder: {
      flag: fp ? 'Founding price' : 'Full roadmap',
      line: 'The full library, every AI tool, and a roadmap that grows with you.',
      items: ['All 4 weeks of your roadmap', 'All ' + rcP + ' playbooks, worksheets and tools', 'Every AI tool and about ' + PLANS.builder.aiRunsPerMonth + ' Playbook messages a month', 'Saved worksheets and AI feedback on your answers', 'New resources every month'],
    },
    circle: {
      flag: 'With Eli',
      line: 'Four founders. A weekly call with Eli. Two in-person gatherings a year.',
      items: PLANS.circle.features,
    },
  };
  // While the workspace offer shows (lib/hq-offer.js, offer.md section 1A), the cards sell HQ. Prices, flags and buttons stay.
  var hqCards = typeof hqOffer !== 'undefined' && hqOffer && hqOffer.show ? hqOffer.cards : null;
  var hqKeep = hqCards && hqOffer.keep ? ' ' + hqOffer.keep : '';
  if (hqCards) {
    CARDS.free.line = hqCards.free.line;
    CARDS.free.items = hqCards.free.items;
    CARDS.builder.flag = fp ? 'Founding price' : hqCards.builder.flag;
    CARDS.builder.line = hqCards.builder.line;
    CARDS.builder.items = hqCards.builder.items;
    CARDS.circle.items = hqCards.circle.items;
  }
  // The Store, once it's on for every member (lib/hq-offer.js): Builder comes with all of it (Eli, Oct 20).
  var hqStore = typeof hqOffer !== 'undefined' && hqOffer && hqOffer.store ? hqOffer.store : null;
  if (hqStore && !hqCards) CARDS.builder.items.splice(2, 0, 'Everything in the Store, ' + hqStore.count + ' templates so far');
  if (circleCapacity !== 4) CARDS.circle.line = circleCapacity + ' founders. A weekly call with Eli. Two in-person gatherings a year.';
%>
<div class="plans plans-v5<%= anchor ? ' plans-anchor' : '' %>">
  <% ['free','builder','circle'].forEach(function(k){ var p = PLANS[k]; var c = CARDS[k]; %>
  <div class="plan plan-<%= k %> <%= k==='builder' ? 'featured' : '' %> <%= k==='circle' ? 'dark' : '' %>">
    <div class="plan-flag"><%= c.flag %></div>
    <h3><%= p.name %></h3>
    <% if (k === 'builder' && fp) { %>
      <div class="price"><span class="amt">$<%= fp %></span><span class="per">/ month</span></div>
      <div class="founding-note"><%= ps === 'A' ? 'Founding price for the first ' + cap + (launch.launchDate ? ' · opens ' + launch.launchDate : '') + '. Locked as long as you stay.' : 'Founding price, locked as long as you stay' %></div>
      <div class="plan-small"><%= ps === 'A' ? '($29 for new Builders after ' + (launch.closesDate || 'the founding window') + ')' : 'Ends ' + (launch.closesDate ? launch.closesDate + ', ' + launch.closesTime : 'at the founding close') + '. ($29 for new Builders after that.)' %></div>
    <% } else if (k === 'free') { %>
      <div class="price"><span class="amt">$0</span><span class="per">No card</span></div>
    <% } else if (k === 'circle') { %>
      <div class="price"><span class="amt">$<%= p.price %></span><span class="per">/ month</span></div>
      <div class="plan-small"><%= circleCapacity %> seats · by application</div>
    <% } else { %>
      <div class="price"><span class="amt">$<%= p.price %></span><span class="per">/ month</span></div>
    <% } %>
    <div class="tag"><%= c.line %></div>
    <ul><% c.items.forEach(function(f){ %><li><%= f %></li><% }) %></ul>
    <% if (k === 'builder' && ps !== 'C') { %>
    <div class="plan-extras"><div class="eyebrow">Founding extras</div><p>Founding number and badge · The founding call with Eli, December 1 · Locked price, even if you switch plans</p></div>
    <% } %>
    <% var cur = user && user.tier === k; var above = user && PLANS[user.tier] && PLANS[user.tier].rank > p.rank; var tr = function (plan) { return " data-track=\"" + (typeof plansEvent !== 'undefined' ? plansEvent : 'Plan Click') + "\" data-props='" + JSON.stringify(Object.assign({ plan: plan, state: typeof plansState !== 'undefined' ? plansState : ps }, anchor ? { order: 'circle-first' } : {})) + "'"; }; %>
    <% if (cur) { %>
      <span class="btn ghost block is-current" aria-disabled="true">Your plan</span>
    <% } else if (above) { %>
      <span class="btn ghost block is-current" aria-disabled="true">Included in your plan</span>
    <% } else if (k==='free') { %>
      <% if (user) { %><a href="/app" class="btn ghost block">Go to my roadmap</a>
      <% } else if (ps === 'A') { %><a href="/founding" class="btn ghost block"<%- tr('free') %>>Join the founding list</a>
      <% } else { %><a href="/start?ref=pricing" class="btn ghost block"<%- tr('free') %>>Start free</a><% } %>
    <% } else if (k==='builder') { %>
      <% var bLabel = ps === 'B' ? (fp ? 'Lock $' + fp + ' a month' : 'Lock the founding price') : 'Become a Builder'; %>
      <% if (user) { %>
      <form method="post" action="/app/billing/checkout/builder"><button class="btn block"<%- tr('builder') %>><%= bLabel %></button></form>
      <% } else if (ps === 'A') { %>
      <a href="/founding" class="btn block"<%- tr('builder') %>>Join the founding list</a>
      <% } else { %>
      <a href="<%= ps === 'B' ? '/founding/lock' : '/start?ref=pricing' %>" class="btn block"<%- tr('builder') %>><%= bLabel %></a>
      <% } %>
      <% if (ps !== 'A') { %><div class="plan-under">14 days to change your mind.<%= hqKeep %></div><% } %>
    <% } else { %>
      <% if (ps === 'A' && !user) { %>
      <a href="/founding" class="btn light block"<%- tr('circle') %>>Join the founding list</a>
      <div class="plan-under">The founding list hears first when seats open.</div>
      <% } else { %>
      <a href="/circle" class="btn light block"<%- tr('circle') %>>Apply for the Circle</a>
      <% } %>
    <% } %>
  </div>
  <% }) %>
</div>
<%- include('track-clicks') %>

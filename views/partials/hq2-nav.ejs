<%# HQ v2 tabs and Talk to 127 (the orb and the ask bar). Locals: tab, inboxCount, usage. %>
<% var tabs = [['today', '/app/hq', 'Today'], ['start', '/app/hq/start', 'Start'], ['inbox', '/app/hq/inbox', 'Inbox'], ['pipeline', '/app/hq/pipeline', 'Pipeline'], ['runs', '/app/hq/runs', 'Runs'], ['library', '/app/hq/library', 'Library'], ['numbers', '/app/hq?v1=1', 'Numbers'], ['brain', '/app/hq/brain', 'Your business'], ['setup', '/app/hq/setup', 'Set up']];
   var F = typeof flags !== 'undefined' && flags ? flags : {};
   // The workspace pages, each behind its own flag (lib/harness/flags.js).
   if (F.HQ_AGENT) tabs.splice(1, 0, ['ask', '/app/hq/ask', 'Ask 127']);
   if (F.HQ_SKILLS) tabs.splice(tabs.length - 2, 0, ['skills', '/app/hq/skills', 'Skills']);
   if (F.HQ_TEAM) tabs.splice(tabs.length - 2, 0, ['team', '/app/hq/team', 'AI team']);
   if (F.HQ_SITE_AGENT) tabs.splice(tabs.length - 2, 0, ['site-chat', '/app/hq/site-chat', 'Site chat']);
   if (F.HQ_PROMPTS) tabs.splice(tabs.length - 2, 0, ['prompts', '/app/hq/prompts', 'Prompts']);
   if (F.HQ_SCRIPTS) tabs.splice(tabs.length - 2, 0, ['scripts', '/app/hq/scripts', 'AI scripts']);
   if (F.HQ_ACTIVITY) tabs.splice(tabs.length - 1, 0, ['activity', '/app/hq/activity', 'Activity']);
   // The Store (lib/store.js): just before Library, as W9 orders the tabs.
   if (F.STORE_V2) tabs.splice(tabs.findIndex(function (t) { return t[0] === 'library'; }), 0, ['store', '/app/hq/store', 'Store']);
   // Native tools (lib/tools, HQ_TOOLS): before the Store.
   if (F.HQ_TOOLS) tabs.splice(tabs.findIndex(function (t) { return t[0] === 'library'; }), 0, ['tools', '/app/hq/tools', 'Tools']);
   var here = tab === 'tool' ? 'tools' : tab === 'workflow' ? 'start' : tab === 'run' ? 'runs' : tab === 'brain-doc' ? 'brain' : tab === 'team-role' ? 'team' : tab === 'prompt' ? 'prompts' : tab === 'brief' || tab === 'briefs' || tab === 'script' ? 'scripts' : tab; %>
<% if (typeof ws === 'undefined' || !ws) { %>
<nav class="h2-tabs" aria-label="HQ">
  <% tabs.forEach(function (t) { %><a href="<%= t[1] %>" class="<%= here === t[0] ? 'on' : '' %>"<%- here === t[0] ? ' aria-current="page"' : '' %>><%= t[2] %><% if (t[0] === 'inbox' && inboxCount) { %><span class="n" aria-label="<%= inboxCount %> waiting"><%= inboxCount %></span><% } %></a><% }) %>
  <span class="h2-credits" title="Credits left this month"><%= usage.left.toLocaleString('en-US') %> / <%= usage.allowance.toLocaleString('en-US') %> credits</span>
</nav>
<% } %>
<% var P = typeof ws !== 'undefined' && ws && ws.premium; %>
<% if (P) { %><div class="hqp-hz" aria-hidden="true" data-hz><i></i></div><% } %>
<div class="h2-talk">
  <div>
    <button type="button" class="orb" id="orb" data-state="idle" aria-label="Talk to 127"><span class="dust"></span><span class="ring"></span><span class="core"></span></button>
    <div class="orb-status" id="orb-status" aria-hidden="true">Talk</div>
  </div>
  <form id="talk" method="post" action="/app/hq/talk" autocomplete="off">
    <input name="text" id="talk-in" placeholder="Tell 127 what you want done" aria-label="Tell 127 what you want done" maxlength="500" enterkeyhint="go">
    <button class="go">Go</button>
  </form>
</div>
<div class="h2-say" id="say" role="status" aria-live="polite"></div>
<% if (P && tab === 'today') { var n = ws.shelf || {}, has = {}; ws.groups.forEach(function (g) { g.items.forEach(function (i) { has[i.id] = 1; }); }); %>
<p class="hqp-uses">127 plans from <% [['workflows', 'workflows', '/app/hq/start'], ['prompts', 'prompts', '/app/hq/prompts'], ['store', 'templates', '/app/hq/store'], ['connections', 'apps', '/app/hq/connect']].forEach(function (k) { if (!n[k[0]] || !has[k[0]]) return; %><a href="<%= k[2] %>"><b data-count="<%= n[k[0]] %>"><%= n[k[0]] %></b> <%= k[1] %></a><% }) %><span>and your Brain</span></p>
<% } %>

<%- include('doc-start') %>
<body>
<% if (!stripeLive && user && user.demoBilling) { %><div class="banner">Demo billing: Stripe isn't connected yet, so upgrades are simulated.</div><% } %>
<%
  var I = {
    home: '<svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>',
    lib: '<svg viewBox="0 0 24 24"><path d="M4 4h5v16H4zM10 4h5v16h-5z"/><path d="M16 5l4 1-3 14-4-1"/></svg>',
    ai: '<svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/></svg>',
    win: '<svg viewBox="0 0 24 24"><path d="M8 4h8v5a4 4 0 01-8 0z"/><path d="M8 6H5v1a3 3 0 003 3M16 6h3v1a3 3 0 01-3 3M12 13v4M8 20h8"/></svg>',
    circle: '<svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="3"/><circle cx="16" cy="10" r="2.5"/><path d="M3 19c0-3 3-5 6-5s6 2 6 5M14 15c3 0 6 1.5 6 4"/></svg>',
    card: '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>',
    gear: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>',
    admin: '<svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>',
    hq: '<svg viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>',
    sell: '<svg viewBox="0 0 24 24"><path d="M4 7h16l-1.5 12h-13z"/><path d="M9 7a3 3 0 016 0"/></svg>',
    market: '<svg viewBox="0 0 24 24"><path d="M4 9h16l-1.4 11H5.4z"/><path d="M8.5 9V7a3.5 3.5 0 017 0v2"/><path d="M12 12.5l.8 1.7 1.7.8-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8z"/></svg>',
    invite: '<svg viewBox="0 0 24 24"><circle cx="10" cy="8" r="3.5"/><path d="M3 20c0-3.5 3-6 7-6s7 2.5 7 6M19 8v6M16 11h6"/></svg>'
  };
  var nav = [['/app','Dashboard',I.home],['/app/library','Library',I.lib],['/app/tools','AI tools',I.ai],['/app/wins','Wins',I.win],['/app/circle',"Founder's Circle",I.circle],['/app/billing','Membership',I.card],['/app/settings','Settings',I.gear]];
  // 127 HQ (lib/hq.js), after Dashboard, only while HQ_LIVE=true.
  if (typeof hqLive !== 'undefined' && hqLive) nav.splice(1, 0, ['/app/hq','HQ',I.hq]);
  // The member marketplace and the Invite page, each behind its switch (lib/market.js MARKETPLACE, lib/referrals.js REFERRALS).
  var wi = nav.findIndex(function (n) { return n[0] === '/app/wins'; }) + 1;
  if (typeof referralsOn !== 'undefined' && referralsOn) nav.splice(wi, 0, ['/app/invite','Invite',I.invite]);
  if (typeof marketOn !== 'undefined' && marketOn) nav.splice(wi, 0, ['/app/sell','Sell',I.sell]);
  // The AI marketplace (/market), after Library, while SHOP_PACKS or MARKETPLACE is on for this member.
  if (typeof aiMarketOn !== 'undefined' && aiMarketOn) nav.splice(nav.findIndex(function (n) { return n[0] === '/app/library'; }) + 1, 0, ['/market','AI marketplace',I.market]);
  if (isAdmin) { nav.push(['/admin','Admin',I.admin]); nav.push(['/admin/ops','Ops',I.admin]); if (typeof marketOn !== 'undefined' && marketOn) nav.push(['/admin/market','Market review',I.admin]); }
%>
<%# HQ as a workspace (HQ_WORKSPACE=on, lib/harness/nav.js): on HQ pages its rail takes the side menu's place. %>
<% var hasWs = typeof ws !== 'undefined' && ws; %>
<% if (!hasWs) { %>
<div class="mobile-top">
  <a href="/app" class="mark"><img src="/img/127-lockup-steel.svg" alt="127" class="logo"></a>
  <button class="btn ghost sm" onclick="document.getElementById('side').classList.toggle('open')">Menu</button>
</div>
<% } %>
<div class="shell<%= hasWs ? ' hqws' : '' %><%= hasWs && ws.premium ? ' hqp' : '' %>">
<% if (hasWs) { %>
  <%- include('hq2-ws') %>
<% } else { %>
  <aside class="side" id="side">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <a href="/" class="mark"><img src="/img/127-lockup-steel.svg" alt="127" class="logo"></a>
      <button class="btn ghost sm" style="display:none" id="closeSide" onclick="document.getElementById('side').classList.remove('open')">Close</button>
    </div>
    <nav>
      <% nav.forEach(function(n){ var on = n[0]==='/app' ? path==='/app' : n[0]==='/admin' ? path==='/admin' : path.indexOf(n[0])===0 || (n[0]==='/app/library' && path.indexOf('/app/templates')===0); %>
        <a href="<%= n[0] %>" class="<%= on ? 'on' : '' %>"><%- n[2] %><%= n[1] %><% if (n[0]==='/app/circle' && userPlan.key!=='circle') { %><span class="lock">Apply</span><% } %><% if (n[0]==='/app/hq' && userPlan.key==='free' && !(pauseInfo && pauseInfo.paused) && !(typeof hq2ForMe !== 'undefined' && hq2ForMe)) { %><span class="lock" style="color:var(--accent)">Builder</span><% } %></a>
      <% }) %>
    </nav>
    <div class="side-foot">
      <div class="who"><%= user.name || user.email %></div>
      <div class="muted small" style="margin-bottom:12px"><%= pauseInfo && pauseInfo.paused ? 'Builder member · paused' : userPlan.name + ' member' %></div>
      <% if (userPlan.key === 'free' && !pauseInfo) { %><form method="post" action="/app/billing/checkout/builder" class="side-upgrade" data-upgrade="sidebar" data-price="<%= builderOffer.price %>"><button class="btn sm block"><%= builderOffer.founding ? 'Lock $' + builderOffer.price + '/month' : 'Become a Builder' %></button><%- include('renewal-line', { rlClass: 'tiny' }) %></form><% } %>
      <form method="post" action="/logout"><button class="link small" style="background:none;border:0;padding:0;cursor:pointer;color:var(--muted)">Sign out</button></form>
    </div>
  </aside>
<% } %>
  <main class="main">
    <% if (user.tier !== 'free' && (user.paymentIssue || user.subscriptionStatus === 'past_due')) { var retry = user.paymentIssue && fmtDate(user.paymentIssue.retryAt); %>
    <div class="alert error pay-banner">
      <span>Your last payment didn't go through. Update your card<%= retry ? ' by ' + retry : '' %> to keep <%= userPlan.name %>.<%= user.foundingPrice && launch.foundingPrice ? ' If the plan ends, so does your $' + launch.foundingPrice + ' founding price.' : '' %></span>
      <form method="post" action="/app/billing/portal"><button class="btn light sm">Update card</button></form>
    </div>
    <% } %>
    <% if (ageReview) { %><div class="alert info age-pause" role="status"><%= agePauseMessage %></div><% } %>
    <% if (pauseInfo && pauseInfo.paused && path !== '/app/billing') { %><div class="alert info">Paused until <%= fmtDate(pauseInfo.resumesAt) %>. Your roadmap and price are saved. <a class="link" href="/app/billing#pause">Resume now</a></div><% } %>
    <% if (checkoutCancelled) { %><div class="alert info">No charge was made.<%= builderOffer.founding ? ' Your founding price is here until ' + builderOffer.closesDate + '.' : '' %></div><% } %>
    <% if (flash) { %><div class="alert <%= flash.type %>" data-flash="<%= flash.type %>"><%= flash.text %></div><% } %>

<%# Perks and grants rows (lib/perks), shared by HQ (views/app/hq2/perks.ejs) and the open page (views/perks.ejs). Locals:
    hq (bool), shelves, sba, fmt, readLine, and in HQ admin and might. Legal L100: every row keeps its official link,
    its read date, the amount as a ceiling or "Not listed", Costs, who it's for and not for; every page keeps the
    honesty line, the Grants line, the SBA quote and the footer. Never a total, never "127 gives" or "unlocks". %>
<% var when = function (p) {
     if (p.status === 'closed') return 'Closed for now';
     if (p.status === 'rolling') return 'Apply any time';
     var d = p.left === 0 ? 'today' : fmt(p.due);
     if (p.deadline.kind === 'monthly') return 'This month\u2019s round closes ' + d;
     if (p.deadline.kind === 'quarterly') return 'This quarter\u2019s round closes ' + d;
     return 'Closes ' + d;
   };
   var might = typeof might !== 'undefined' && might ? might : {};
   var admin = typeof admin !== 'undefined' && admin; %>
  <% shelves.forEach(function (s, si) { %>
  <section class="pk-shelf" id="shelf-<%= s.id %>" aria-labelledby="pk-<%= s.id %>-h" data-shelf>
    <header class="pk-shelf-h">
      <span class="pk-num" aria-hidden="true"><%= String(si + 1).padStart(2, '0') %></span>
      <h2 id="pk-<%= s.id %>-h" class="pk-h"><%= s.title %></h2>
      <p class="pk-shelf-l"><%= s.line %></p>
    </header>
    <% if (s.id === 'grants') { %>
    <blockquote class="pk-sba">
      <p>&ldquo;<%= sba.quote %>&rdquo;</p>
      <footer><a href="<%= sba.url %>" rel="noopener noreferrer" target="_blank">SBA.gov</a>, read <%= fmt(sba.checked) %>. If someone says they're the SBA and offers you a grant, it isn't the SBA.</footer>
    </blockquote>
    <% } %>
    <ul class="pk-rows">
      <% s.items.forEach(function (p) { %>
      <li class="pk-row" id="<%= p.id %>" data-id="<%= p.id %>" data-fits="<%= p.fits.join(' ') %>" data-due="<%= p.due || '' %>" data-name="<%= p.name %>" data-url="<%= p.url %>">
        <details>
          <summary>
            <span class="pk-n"><%= p.name %><span class="pk-by"><%= p.by %></span></span>
            <span class="pk-lead" aria-hidden="true"></span>
            <span class="pk-amt<%= p.amount ? '' : ' none' %>"><%= p.amount || 'Not listed' %></span>
            <span class="pk-when<%= p.status === 'closed' ? ' shut' : '' %>"><%= when(p) %></span>
            <% if (hq && might[p.id]) { %><span class="pk-might">Might fit. <%= might[p.id] %></span><% } %>
          </summary>
          <div class="pk-body">
            <% if (p.amountNote) { %><p class="pk-note"><%= p.amountNote %></p><% } %>
            <% if (p.statusNote) { %><p class="pk-note"><%= p.statusNote %></p><% } %>
            <dl class="pk-facts">
              <div><dt>Who it's for</dt><dd><ul><% p.who.forEach(function (w) { %><li><%= w %></li><% }) %></ul></dd></div>
              <% if (p.notFor) { %><div><dt>Not for</dt><dd><%= p.notFor %></dd></div><% } %>
              <% if (p.fee) { %><div><dt>Costs</dt><dd><%= p.fee %></dd></div><% } %>
              <% if (p.ready && p.ready.length) { %><div><dt>Have ready</dt><dd><ul><% p.ready.forEach(function (w) { %><li><%= w %></li><% }) %></ul></dd></div><% } %>
              <% if (p.answer) { %><div><dt>After you apply</dt><dd><%= p.answer %></dd></div><% } %>
            </dl>
            <div class="pk-acts">
              <a class="pk-go" href="<%= p.url %>" rel="noopener noreferrer" target="_blank">Official page<span class="sr-only"> for <%= p.name %>, opens in a new tab</span></a>
              <% if (hq) { %><button type="button" class="pk-save" aria-pressed="false" data-save hidden>Save</button><% } %>
              <% if (hq && p.draft) { %><a class="pk-link" href="/app/hq/perks/<%= p.id %>/draft">Draft an answer</a><% } %>
              <span class="pk-checked"><%= readLine(p) %><% if (hq && admin && p.expired) { %>, <b>hidden from members, reread it</b><% } else if (hq && admin && p.stale) { %>, <b>recheck</b><% } %></span>
            </div>
          </div>
        </details>
      </li>
      <% }) %>
    </ul>
  </section>
  <% }) %>

  <p class="pk-empty" hidden data-empty>Nothing here fits that mix yet. Tap a choice again to take it off.</p>

  <footer class="pk-foot">
    <p>127 isn't part of these programs and earns nothing when you apply. No link on this page is an affiliate link. You apply on each program's own site, and the decision is theirs.</p>
  </footer>

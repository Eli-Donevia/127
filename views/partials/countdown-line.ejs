<%# One-line mono countdown. cdTarget (ms), cdLabel ("DOORS OPEN IN"), cdShort (true = "3D 11H 08M"). Hides once the target passes. %>
<% var cdT = typeof cdTarget !== 'undefined' ? cdTarget : launch.launchAt; var cdS = typeof cdShort !== 'undefined' && cdShort; %>
<% if (cdT && cdT > Date.now()) { var cdLeft = cdT - Date.now(); var p2 = function (n) { return String(n).padStart(2, '0'); }; %>
<div class="cd-line mono" data-target="<%= cdT %>" data-short="<%= cdS ? 1 : 0 %>"><% if (typeof cdLabel !== 'undefined' && cdLabel) { %><%= cdLabel %> <% } %><span data-cd><%= cdS
  ? Math.floor(cdLeft / 864e5) + 'D ' + p2(Math.floor(cdLeft / 36e5) % 24) + 'H ' + p2(Math.floor(cdLeft / 6e4) % 60) + 'M'
  : Math.floor(cdLeft / 864e5) + ' DAYS · ' + p2(Math.floor(cdLeft / 36e5) % 24) + ' HRS · ' + p2(Math.floor(cdLeft / 6e4) % 60) + ' MIN' %></span></div>
<script>
(function(){var el=document.currentScript.previousElementSibling,t=+el.getAttribute('data-target'),s=el.getAttribute('data-short')==='1',o=el.querySelector('[data-cd]');function p(n){return String(n).padStart(2,'0')}
function tick(){var l=Math.max(0,t-Date.now()),d=Math.floor(l/864e5),h=p(Math.floor(l/36e5)%24),m=p(Math.floor(l/6e4)%60);o.textContent=s?d+'D '+h+'H '+m+'M':d+' DAYS · '+h+' HRS · '+m+' MIN';}
tick();setInterval(tick,15000);})();
</script>
<% } %>

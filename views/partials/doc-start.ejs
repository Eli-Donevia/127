<!doctype html>
<%# HQ's light look (HQ_PREMIUM, lib/harness/theme.js): only on HQ workspace pages. Light is set here; System is set by
    the script below before paint and follows the device when it changes. Without scripts, System stays dark. %>
<% var hqLook = typeof ws !== 'undefined' && ws && ws.premium ? ((typeof user !== 'undefined' && user && (user.hqTheme === 'light' || user.hqTheme === 'dark')) ? user.hqTheme : 'system') : null; %>
<html lang="en"<%- hqLook === 'light' ? ' class="hq-light"' : '' %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' && title ? title + ' · 127' : '127 · Build with purpose' %></title>
<% var desc = (typeof description !== 'undefined' && description) || 'Answer a few questions and get a 30-day roadmap to launch your first business, with the playbooks, AI tools and templates for each step. Weeks 1 and 2 are free.'; var fullTitle = typeof title !== 'undefined' && title ? title + ' · 127' : '127 · Build with purpose'; %>
<meta name="description" content="<%= desc %>">
<link rel="canonical" href="<%= canonical %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="127">
<meta property="og:title" content="<%= fullTitle %>">
<meta property="og:description" content="<%= desc %>">
<meta property="og:url" content="<%= canonical %>">
<% var og = (typeof ogImage !== 'undefined' && ogImage) || '/og.png'; %>
<meta property="og:image" content="<%= baseUrl %><%= og %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= fullTitle %>">
<meta name="twitter:description" content="<%= desc %>">
<meta name="twitter:image" content="<%= baseUrl %><%= og %>">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex"><% } %>
<meta name="theme-color" content="<%= hqLook === 'light' ? '#f6f6f8' : '#060607' %>">
<% if (hqLook === 'system') { %><script>(function(){var m=window.matchMedia&&matchMedia('(prefers-color-scheme: light)');if(!m)return;var d=document.documentElement,t=document.querySelector('meta[name="theme-color"]');function set(){if(d.hasAttribute('data-look'))return;d.classList.toggle('hq-light',m.matches);if(t)t.setAttribute('content',m.matches?'#f6f6f8':'#060607');}set();if(m.addEventListener)m.addEventListener('change',set);else if(m.addListener)m.addListener(set);})();</script><% } %>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/favicon-180.png">
<% if (typeof heroImg !== 'undefined' && heroImg) { %><link rel="preload" as="image" href="<%= heroImg[0] %>" media="(max-width: 760px)" fetchpriority="high">
<link rel="preload" as="image" href="<%= heroImg[1] %>" media="(min-width: 761px)" fetchpriority="high">
<% } %>
<link rel="preload" href="/fonts/Geist-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
<% if (typeof css !== 'undefined' && css) { [].concat(css).forEach(function (href) { %><link rel="stylesheet" href="<%= href %>">
<% }) } %>
<% if (plausible) { %>
<script defer data-domain="<%= plausible %>" src="https://plausible.io/js/script.js"></script>
<script>window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
<% (trackEvents || []).forEach(function (e) { %>plausible(<%- JSON.stringify(e.name) %><%- e.props ? ', { props: ' + JSON.stringify(e.props).replace(/</g, '\\u003c') + ' }' : '' %>);
<% }) %></script>
<% } %>
<%# Ad pixels load only after "Accept" (Legal L7, legal/08-cookie-notice.md Part C). Plausible above is cookieless and runs without a banner. %>
<%- typeof adConsentScript !== 'undefined' ? adConsentScript : '' %>
</head>

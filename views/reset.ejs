<%- include('partials/doc-start') %>
<body class="bare">
  <div class="bare-top"><a href="/" class="mark"><img src="/img/127-lockup-steel.svg" alt="127" class="logo"></a><a href="/login" class="small link">Back to sign in</a></div>
  <main class="auth-card fade-in">
    <div class="eyebrow">Password</div>
    <h1 style="margin-top:12px">Choose a new password</h1>
    <% if (!ok) { %>
      <p class="muted" style="margin:0 0 20px">This link has expired or was already used.</p>
      <a class="btn block" href="/forgot">Send a new link</a>
    <% } else { %>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="post" action="/reset">
        <input type="hidden" name="u" value="<%= u %>"><input type="hidden" name="t" value="<%= t %>">
        <label class="field"><span>New password</span><input class="input" type="password" name="password" required minlength="8" autocomplete="new-password" autofocus></label>
        <button class="btn block" style="margin-top:8px">Save password</button>
      </form>
    <% } %>
  </main>
</body>
</html>

<%- include('partials/head') %>
<%# Prefilled share text (founding.md status page; legal/03 section 5 asks sharers to say they get a reward). %>
<% var shareText = "I'm on the 127 founding list. I get a free month if you join with my link: " + entry.link; %>
<%
  var P = launch.foundingPrice ? '$' + launch.foundingPrice : null;
  var PM = P ? P + ' a month' : 'the founding price';
  var R = launch.referralsForReward;
  var chHref = '/challenge?ref=' + encodeURIComponent(entry.code) + (entry.firstName ? '&first_name=' + encodeURIComponent(entry.firstName) : '');
%>
<main class="fm">
  <section class="hero plain founding-hero">
    <div class="wrap narrow">
      <% if (q.confirmed || entry.confirmed) { %>
        <h1><span class="grad">You're confirmed<%= entry.firstName ? ', ' + entry.firstName : '' %>.</span></h1>
        <% if (launch.prelaunch) { %>
        <p class="lede">Doors open <%= launch.launchDay ? launch.launchDay + ' at ' + launch.launchTime : 'soon' %>. Builder is <%= PM %> for the first <%= launch.cap %>, locked while you stay.</p>
        <% } else if (launch.foundingOpen) { %>
        <p class="lede">Builder is <%= PM %> for the first <%= launch.cap %>, locked while you stay.</p>
        <% } else { %>
        <p class="lede">Thank you to our founding members. Builder is $29 a month, and the free plan is still free.</p>
        <% } %>
      <% } else { %>
        <h1><span class="grad">You're on the list.</span></h1>
        <% if (entry.confirmSent) { %>
        <p class="lede">Check your email and tap <b style="color:var(--ink)">Confirm</b>. It makes your friends' sign-ups count toward your free month, and it's how we reach you on launch day.<%= q.back && entry.confirmJustSent ? ' (You were already on the list, so we sent a fresh link.)' : '' %></p>
        <% } else { %>
        <%# No confirm email went out (unticked box, or email isn't connected), so don't promise one. %>
        <p class="lede">Your spot is saved.<%= launch.prelaunch && launch.launchDay ? ' Doors open ' + launch.launchDay + ' at ' + launch.launchTime + '.' : '' %></p>
        <% } %>
        <% if (devConfirm) { %><div class="alert info">Email isn't connected yet, so here is the confirm link: <a class="link" href="<%= devConfirm %>">confirm my spot</a></div><% } %>
      <% } %>

      <% if (!launch.prelaunch && launch.foundingOpen) { %>
      <div class="hero-cta" style="margin-top:8px">
        <a href="/founding/lock" class="btn light" data-track="Founding Lock Click" data-props='{"placement":"status"}'><%= P ? 'Lock ' + PM : 'Lock the founding price' %> <span class="arrow"></span></a>
      </div>
      <% } %>

      <% if (!launch.prelaunch && !launch.foundingOpen) { %>
      <%# After the founding close the link stops counting, so the share block becomes the final count. %>
      <div class="card pad-lg share-card">
        <div class="ref-progress" style="margin:0;padding:0;border:0">
          <div class="dots"><% for (var j = 0; j < R; j++) { %><span class="<%= j < entry.count ? 'on' : '' %>"></span><% } %></div>
          <div><b><%= Math.min(entry.count, R) %> of <%= R %></b> confirmed<%= entry.count >= R ? '. Your first month of Builder is free.' : '.' %></div>
        </div>
        <% if (entry.friends && entry.friends.length) { %><ul class="ref-friends" aria-label="Friends who confirmed"><% entry.friends.forEach(function (n) { %><li><%= n %></li><% }) %></ul><% } %>
      </div>
      <% } else { %>
      <div class="card pad-lg share-card">
        <h3 class="fm-h3s">Bring <%= R %>, get a month.</h3>
        <p class="muted" style="margin:6px 0 0">When <%= R %> friends confirm with your link, your first month of Builder is free.<%= launch.closesDate ? ' Your link keeps counting until ' + launch.closesDate + ', and if you\'ve already paid, the month comes as credit.' : '' %></p>
        <div class="share-link"><code id="reflink"><%= entry.link.replace(/^https?:\/\//, '') %></code><button type="button" class="btn sm" data-copy-text="<%= entry.link %>" data-track="Referral Share" data-channel="copy">Copy</button></div>
        <div class="share-row">
          <a class="btn ghost sm" href="sms:?&body=<%= encodeURIComponent(shareText) %>" data-track="Referral Share" data-channel="messages">Messages</a>
          <a class="btn ghost sm" href="https://wa.me/?text=<%= encodeURIComponent(shareText) %>" target="_blank" rel="noopener" data-track="Referral Share" data-channel="whatsapp">WhatsApp</a>
          <button type="button" class="btn ghost sm" data-copy-text="<%= entry.link %>" data-open="instagram://story-camera" data-track="Referral Share" data-channel="instagram">Instagram story</button>
          <a class="btn ghost sm" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(shareText) %>" target="_blank" rel="noopener" data-track="Referral Share" data-channel="x">X</a>
        </div>
        <p class="small muted ref-say">Share it with people you know, in your own words, and say you get a free month if they join.</p>
        <div class="ref-progress">
          <div class="dots"><% for (var i = 0; i < R; i++) { %><span class="<%= i < entry.count ? 'on' : '' %>"></span><% } %></div>
          <div><b><%= Math.min(entry.count, R) %> of <%= R %></b> confirmed<%= entry.count >= R ? '. Your first month is free.' : '' %></div>
        </div>
        <% if (entry.friends && entry.friends.length) { %><ul class="ref-friends" aria-label="Friends who confirmed"><% entry.friends.forEach(function (n) { %><li><%= n %></li><% }) %></ul><% } %>
        <p class="tiny muted" style="margin:14px 0 0">Bookmark this page to check your count. You'll see each friend's first name when they confirm, never their email.</p>
      </div>
      <% } %>

      <% if (launch.prelaunch) { %>
      <div class="fm-status-extra">
        <%- include('partials/challenge-card', { chHref: chHref, chFrom: 'status' }) %>
        <div class="eyebrow fm-label" style="margin:36px 0 4px">How it works</div>
        <%- include('partials/founding-timeline', { tlTicked: true }) %>
        <%- include('partials/countdown-line', { cdTarget: launch.launchAt, cdLabel: 'DOORS OPEN IN', cdShort: false }) %>
        <% if (launch.launchAt) { %><div style="margin-top:20px"><a class="btn ghost sm" href="/founding/doors-open.ics">Add doors open to my calendar</a></div><% } %>
      </div>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/track-clicks') %>
<script>
document.addEventListener('click', function (e) {
  var c = e.target.closest('[data-copy-text]');
  if (!c) return;
  var t = c.getAttribute('data-copy-text');
  (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(function () {
    var o = c.textContent; c.textContent = 'Copied'; setTimeout(function () { c.textContent = o; }, 1500);
  }).catch(function () {});
  var open = c.getAttribute('data-open'); if (open) setTimeout(function () { location.href = open; }, 300);
});
</script>
<%- include('partials/foot') %>

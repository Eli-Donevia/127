<%- include('partials/doc-start') %>
<body class="bare">
  <div class="bare-top"><a href="/" class="mark"><img src="/img/127-lockup-steel.svg" alt="127" class="logo"></a><a href="/login" class="small link">Back to sign in</a></div>
  <main class="auth-card fade-in">
    <div class="eyebrow">Password</div>
    <h1 style="margin-top:12px">Reset your password</h1>
    <% if (sent) { %>
      <p class="muted" style="margin:0 0 20px">If that email has an account, a reset link is on its way. It works for 1 hour. Check spam if you don't see it.</p>
      <% if (devLink) { %><div class="alert info">Email isn't connected yet, so here is the link: <a class="link" href="<%= devLink %>">reset password</a></div><% } %>
    <% } else { %>
      <p class="muted" style="margin:0 0 28px">Enter your email and we'll send you a link to choose a new one.</p>
      <form method="post" action="/forgot">
        <label class="field"><span>Email</span><input class="input" type="email" name="email" required autocomplete="email" autofocus></label>
        <button class="btn block" style="margin-top:8px">Send reset link</button>
      </form>
    <% } %>
    <%- include('partials/legal-footer', { privacyTerms: true }) %>
  </main>
</body>
</html>

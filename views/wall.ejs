<%- include('partials/head') %>
<%# /wall (lib/wall.js, WALL=on): sites and things members made that they chose to show, each approved by 127 and named
    the way the member agreed, with their connection line when they have one. No amounts. Legal's wall line (L98 NU20)
    sits right under the heading; member links are rel="ugc nofollow" and each entry has a Report link. Locals: entries, line. %>
<main class="wall">
  <header class="wall-head wrap">
    <h1>Built with 127.</h1>
    <p>Sites members shipped and things they made. <%= line %></p>
  </header>
  <div class="wrap">
    <% if (!entries.length) { %><p class="wall-empty">The first ones go up soon.</p><% } %>
    <ol class="wall-list">
      <% entries.forEach(function (e) { var host = ''; try { host = e.url ? new URL(e.url).hostname.replace(/^www\./, '') : ''; } catch (x) {} %>
      <li class="<%= e.kind %>">
        <% if (e.kind === 'site') { %><a href="<%= e.url %>" target="_blank" rel="ugc nofollow noopener noreferrer"><b><%= e.title %></b><span class="u"><%= host %></span></a><% } else { %><b><%= e.title %></b><% } %>
        <% if (e.note) { %><p><%= e.note %></p><% } %>
        <span class="by"><%= e.by %></span>
        <% if (e.connection) { %><span class="cn"><%= e.connection %></span><% } %>
        <a class="rp" href="<%= e.report %>">Report</a>
      </li>
      <% }) %>
    </ol>
  </div>
</main>
<style>
  .wall { padding: 96px 0 120px; }
  .wall-head h1 { margin: 0; font-size: clamp(48px, 8vw, 104px); line-height: .92; letter-spacing: -0.06em; font-weight: 700; color: var(--ink); }
  .wall-head p { max-width: 52ch; margin: 18px 0 48px; font-size: 18px; color: var(--ink-2); }
  .wall-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); border-top: 1px solid var(--line); }
  .wall-list li { display: grid; gap: 8px; align-content: start; padding: 22px 22px 26px 0; border-bottom: 1px solid var(--line); }
  .wall-list a { display: grid; gap: 4px; color: var(--ink); text-decoration: none; }
  .wall-list b { font-size: 22px; letter-spacing: -0.03em; font-weight: 600; color: var(--ink); }
  .wall-list a:hover b { text-decoration: underline; text-decoration-color: #7cebf6; text-underline-offset: 5px; }
  .wall-list .u { font: 13px var(--mono); color: var(--muted); }
  .wall-list p { margin: 0; color: var(--ink-2); }
  .wall-list .by { font-size: 13px; color: var(--muted); }
  .wall-list .cn { font-size: 13px; color: var(--ink-2); }
  .wall-list .rp { justify-self: start; font-size: 12px; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .wall-list .rp:hover { color: var(--ink); }
  .wall-empty { color: var(--muted); }
</style>
<%- include('partials/foot') %>

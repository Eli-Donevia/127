<%- include('partials/head') %>
<main>
  <section class="band" style="padding:110px 0 96px">
    <div class="wrap founder" style="align-items:end">
      <div>
        <div class="eyebrow">Founder's Circle · By application</div>
        <h1 class="serif" style="font-size:clamp(48px,6.4vw,84px);line-height:.95;letter-spacing:-.055em;margin:18px 0 0"><span class="grad">A small room for</span> <span style="color:var(--gold)">driven</span> <span class="grad">founders.</span></h1>
      </div>
      <div>
        <p style="font-size:19px;margin:0 0 28px">Up to <%= circleCapacity %> heavily committed, driven founders. One focused call every week with Eli, real hot seats, clear commitments, and two in-person gatherings a year.</p>
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <a href="<%= user ? '/app/circle' : '/start' %>" class="btn light"><%= circleSeatsLeft > 0 ? 'Apply for a seat' : 'Join the waitlist' %> <span class="arrow"></span></a>
          <span class="small" style="color:var(--on-dark-2)">$299 / month · <%= circleSeatsLeft %> of <%= circleCapacity %> seats open</span>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="section-head"><div class="eyebrow">The weekly call</div><h2>45 minutes. No fluff.</h2></div>
      <div class="steps">
        <div class="step"><div class="n">05′</div><h4>Wins</h4><p>Each member shares what moved since last week.</p></div>
        <div class="step"><div class="n">30′</div><h4>Hot seats</h4><p>Two or three members go deep on their biggest question, submitted in advance.</p></div>
        <div class="step"><div class="n">10′</div><h4>Commitments</h4><p>Everyone leaves with one or two specific commitments for the week.</p></div>
        <div class="step"><div class="n">+</div><h4>Notes</h4><p>A summary and action items land in your inbox after every call.</p></div>
      </div>
    </div>
  </section>
  <section style="padding-top:24px">
    <div class="wrap g-2 grid" style="gap:48px">
      <div>
        <div class="eyebrow">It's for you if</div>
        <ul class="check-list">
          <li><span class="tick on"></span>You've started, and you're ready to be held to a higher standard.</li>
          <li><span class="tick on"></span>You'll show up weekly and do the work between calls.</li>
          <li><span class="tick on"></span>You want honest feedback, not cheerleading.</li>
          <li><span class="tick on"></span>You know nobody is self-made, and you want peers who'll push you.</li>
        </ul>
      </div>
      <div>
        <div class="eyebrow">Good to know</div>
        <ul class="check-list">
          <li><span class="tick"></span>It's group guidance, not unlimited one-to-one consulting.</li>
          <li><span class="tick"></span>Includes everything in Builder.</li>
          <li><span class="tick"></span>Two in-person gatherings a year with the group.</li>
          <li><span class="tick"></span>Billed monthly. Seats are capped so every member gets airtime.</li>
        </ul>
      </div>
    </div>
  </section>
</main>
<%- include('partials/foot') %>

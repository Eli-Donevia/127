<%- include('head') %>
<body class="cx">
<header class="cx-nav">
  <a href="/coach/dashboard" class="cx-mark"><span class="cx-127">127</span><span class="cx-sub">Coach</span></a>
  <% if (typeof coach !== 'undefined' && coach) { %>
  <nav>
    <a href="/coach/dashboard" class="<%= path === '/coach/dashboard' || (path || '').startsWith('/coach/clients') ? 'on' : '' %>">Clients</a>
    <a href="/coach/programs" class="<%= (path || '').startsWith('/coach/programs') ? 'on' : '' %>">Programs</a>
    <a href="/coach/review" class="<%= (path || '').startsWith('/coach/review') ? 'on' : '' %>">Check-ins<% if (queueCount) { %> <b class="cx-count"><%= queueCount %></b><% } %></a>
    <a href="/coach/challenges" class="<%= (path || '').startsWith('/coach/challenges') ? 'on' : '' %>">Challenges</a>
    <a href="/coach/brand" class="<%= (path || '').startsWith('/coach/brand') ? 'on' : '' %>">Brand</a>
  </nav>
  <a class="btn ghost sm" href="/c/<%= coach.slug %>" target="_blank" rel="noopener">View my site ↗</a>
  <% } %>
</header>
<main class="cx-main">
<%- include('flash') %>

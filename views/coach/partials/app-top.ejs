<%- include('brand-top', { bodyClass: 'cb-app' + (typeof hero !== 'undefined' && hero ? ' has-hero' : '') }) %>
<% var coachPhoto = c.brand.photo ? '/c/' + c.slug + '/brand-photo?v=' + c.brand.photo.slice(-6) : null; %>
<header class="ca-top">
  <a href="/c/<%= c.slug %>/app" class="ca-brand"><% if (coachPhoto) { %><img class="ca-logo img" src="<%= coachPhoto %>" alt=""><% } else { %><span class="ca-logo"><%= c.brand.initials %></span><% } %><span class="ca-name"><%= c.brand.name %></span></a>
  <span class="ca-me" aria-label="Signed in as <%= me.name %>"><%= (me.name || '?').split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase() %></span>
</header>
<main class="ca-main">
<%- include('flash') %>

<%- include('partials/top') %>
<div class="cx-head"><div><div class="eyebrow">Program builder</div><h1>Programs</h1></div><a class="btn accent" href="/coach/programs/new">New program</a></div>
<div class="cards">
<% programs.forEach(function (x) { %>
  <a class="card prog" href="/coach/programs/<%= x.p.id %>">
    <h3><%= x.p.name %></h3>
    <p class="muted small"><%= x.p.goal %></p>
    <p class="small"><%= x.p.weeks.length %> weeks · <%= x.p.weeks[0].days.length %> days/week · <%= x.p.weeks[0].days.reduce(function (a, d) { return a + d.exercises.length; }, 0) %> exercises in week 1</p>
    <span class="pill"><%= x.assigned %> assigned</span>
  </a>
<% }) %>
<% if (!programs.length) { %><p class="muted">No programs yet.</p><% } %>
</div>
<%- include('partials/bottom') %>

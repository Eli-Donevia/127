<!doctype html>
<%# Site chat, inside a member's website (lib/harness/site-chat.js). Legal L76 S2: the opening shows before the visitor can type, and the line under the box stays on. No 127 tracking, fonts or other scripts. Locals: key, business, privacy, page, lines. %>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Chat with <%= business %></title>
<style>
  :root { --bg: #fff; --ink: #16171a; --dim: #5d6168; --line: #e3e5e9; --me: #16171a; --me-ink: #fff; --ai: #f2f3f5; }
  @media (prefers-color-scheme: dark) { :root { --bg: #111214; --ink: #eef0f3; --dim: #a1a6ae; --line: #2a2c31; --me: #eef0f3; --me-ink: #111214; --ai: #1d1f23; } }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 15px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  .wrap { display: flex; flex-direction: column; height: 100%; }
  .log { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 8px; }
  .m { max-width: 85%; padding: 9px 12px; border-radius: 14px; white-space: pre-wrap; word-wrap: break-word; }
  .ai { background: var(--ai); align-self: flex-start; border-bottom-left-radius: 4px; }
  .me { background: var(--me); color: var(--me-ink); align-self: flex-end; border-bottom-right-radius: 4px; }
  .note { color: var(--dim); font-size: 13px; align-self: center; text-align: center; }
  form { margin: 0; }
  .say { display: flex; gap: 8px; padding: 10px 12px 6px; border-top: 1px solid var(--line); }
  textarea, input { flex: 1; font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 9px 11px; resize: none; }
  button { font: inherit; border: 0; border-radius: 999px; padding: 9px 16px; background: var(--me); color: var(--me-ink); cursor: pointer; }
  button[disabled] { opacity: .5; cursor: default; }
  .linkbtn { background: none; color: var(--ink); padding: 0; text-decoration: underline; border-radius: 0; font-size: 13px; }
  .under { padding: 0 12px 10px; color: var(--dim); font-size: 12px; }
  .under a { color: inherit; }
  .contact { display: none; flex-direction: column; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--line); }
  .contact.open { display: flex; }
  .contact p { margin: 0; color: var(--dim); font-size: 13px; }
  .row { display: flex; gap: 8px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
</head>
<body>
<div class="wrap" id="chat" data-key="<%= key %>" data-page="<%= page %>">
  <div class="log" id="log" role="log" aria-live="polite">
    <div class="m ai"><%= lines.opening(business) %></div>
  </div>
  <form class="contact" id="contact" autocomplete="on">
    <p><%= lines.contact(business) %></p>
    <label class="sr" for="c-name">Your name</label><input id="c-name" name="name" maxlength="120" placeholder="Your name">
    <div class="row"><label class="sr" for="c-email">Email</label><input id="c-email" name="email" type="email" maxlength="200" placeholder="Email"><label class="sr" for="c-phone">Phone</label><input id="c-phone" name="phone" type="tel" maxlength="40" placeholder="Phone"></div>
    <div class="row"><button type="submit">Send my details</button><button type="button" class="linkbtn" id="c-cancel">Not now</button></div>
  </form>
  <form class="say" id="say">
    <label class="sr" for="text">Your message</label>
    <textarea id="text" name="text" rows="1" maxlength="1000" placeholder="Ask a question" required></textarea>
    <button type="submit">Send</button>
  </form>
  <div class="under">AI assistant · Saved for <%= business %> · <a href="/site-chat" target="_blank" rel="noopener">Run by 127</a> · <a href="<%= privacy %>" target="_blank" rel="noopener">Privacy</a><span id="leave-wrap"> · <button type="button" class="linkbtn" id="leave">Leave your details</button></span></div>
</div>
<script src="/js/site-chat.js" defer></script>
</body>
</html>

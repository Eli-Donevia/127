<%- include('partials/head') %>
<%
  // Three states (conversion/pages/pricing.md): A before doors open, B founding window, C evergreen.
  var ps = launch.prelaunch ? 'A' : launch.foundingOpen ? 'B' : 'C';
  var fp = launch.foundingPrice;
  var cap = launch.cap;
  // The founding call row comes off after the call (December 1, 8pm ET).
  var showCallRow = Date.now() < Date.parse('2026-12-02T05:00:00Z');
  // The workspace offer (lib/hq-offer.js, offer.md section 1A) once HQ is on for members; until then, the roadmap.
  var hqo = typeof hqOffer !== 'undefined' && hqOffer && hqOffer.show ? hqOffer : null;
  // The Store once it's on for every member: Builder comes with all of it (Eli, Oct 20). hqo has its own row for it.
  var hqStore = !hqo && typeof hqOffer !== 'undefined' && hqOffer && hqOffer.store ? hqOffer.store : null;
  // The page's own design: the plan on the table. The hero is the real Start roadmap, printed and open on the Circle's
  // marble (an illustration, rendered: page-redesign/render/table.py --cam note); weeks 1 and 2 are the free page, 3 and 4
  // Builder's. Then the plans as one ledger (phones show one plan at a time, with tabs under the thumb that also pick the
  // compare column), the founding close, straight answers and questions. Copy and launch states are unchanged.
  // where each page lands on the render, in % of the wide (w) and phone (t) frames, from the render's camera
  var PPINS = {"free":{"w":[53.4,59.53],"t":[36.65,58.25]},"builder":{"w":[72.36,67.71],"t":[60.64,61.02]}};
  var tabName = { free: 'Free', builder: 'Builder', circle: 'Circle' };
  var tabPrice = { free: '$0', builder: '$' + (ps !== 'C' && fp ? fp : PLANS.builder.price), circle: '$' + PLANS.circle.price };
%>
<main class="prc">
  <script>(function(){document.documentElement.classList.add('js');var m=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches,c=navigator.connection&&navigator.connection.saveData;if(!m&&!c)document.currentScript.parentNode.classList.add('prc-intro');})();</script>
  <section class="prc-hero">
    <% if (hqo) { %>
    <%# While the workspace offer sells HQ, the hero is Brand's night desk (brand/v2/hyperreal, desk): the 127 and HQ open on
        the screen. One callout on the screen. %>
    <div class="prc-scene prc-scene-hq" data-scene data-iw="2400" data-ih="1350" data-tw="1080" data-th="1350">
      <div class="prc-frame" data-frame>
        <picture>
          <source media="(max-width: 760px)" type="image/webp" srcset="/img/pricing/hq-desk-tall-720.webp 720w, /img/pricing/hq-desk-tall-1080.webp 1080w" sizes="100vw">
          <source media="(max-width: 760px)" srcset="/img/pricing/hq-desk-tall-1080.jpg">
          <source type="image/webp" srcset="/img/pricing/hq-desk-wide-1200.webp 1200w, /img/pricing/hq-desk-wide-2400.webp 2400w" sizes="100vw">
          <img class="prc-room" src="/img/pricing/hq-desk-wide-1920.jpg" alt="Illustration of a desk at night: a chrome 127 in front of a laptop with HQ open on the screen" width="1920" height="1080" fetchpriority="high" decoding="async">
        </picture>
        <div class="prc-pins" aria-hidden="true">
          <span class="prc-pin" style="--xw:86%;--yw:30%;--xt:72%;--yt:50%;--n:0"><b>Your HQ</b></span>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="prc-scene" data-scene data-iw="1920" data-ih="1080" data-tw="1080" data-th="1350">
      <div class="prc-frame" data-frame>
        <picture>
          <source media="(max-width: 760px)" type="image/webp" srcset="/img/pricing/note-tall-720.webp 720w, /img/pricing/note-tall-1080.webp 1080w" sizes="100vw">
          <source media="(max-width: 760px)" srcset="/img/pricing/note-tall-1080.jpg">
          <source type="image/webp" srcset="/img/pricing/note-wide-1280.webp 1280w, /img/pricing/note-wide-1920.webp 1920w" sizes="100vw">
          <img class="prc-room" src="/img/pricing/note-wide-1920.jpg" alt="Illustration of the 30-day roadmap, printed out on a dark marble table, week 1 ticked off, candles behind" width="1920" height="1080" fetchpriority="high" decoding="async">
        </picture>
        <div class="prc-pins" aria-hidden="true">
          <span class="prc-pin" style="--xw:<%= PPINS.free.w[0] %>%;--yw:<%= PPINS.free.w[1] %>%;--xt:<%= PPINS.free.t[0] %>%;--yt:<%= PPINS.free.t[1] %>%;--n:0"><b><span>Weeks 1 and 2 · </span>free</b></span>
          <span class="prc-pin" style="--xw:<%= PPINS.builder.w[0] %>%;--yw:<%= PPINS.builder.w[1] %>%;--xt:<%= PPINS.builder.t[0] %>%;--yt:<%= PPINS.builder.t[1] %>%;--n:1"><b><span>Weeks 3 and 4 · </span>Builder</b></span>
        </div>
      </div>
    </div>
    <% } %>
    <div class="wrap prc-hero-copy">
      <% if (hqo && hqo.preview) { %><p class="hqs-preview mono">Admin preview. Members see this page once HQ is on for everyone and HQ_OFFER=on.</p><% } %>
      <% if (hqo) { %>
      <h1 class="prc-h1 prc-h1-hq">Run your business from one screen.</h1>
      <p class="prc-lede"><%= hqo.line %> Start free, no card. Upgrade when it's earned it. Cancel anytime.</p>
      <% } else { %>
      <h1 class="prc-h1">Start free. Grow into it.</h1>
      <p class="prc-lede">Every plan starts with the free assessment and a 30-day roadmap in your account, built for you, with weeks 1 and 2 free. Upgrade when it's earned it. Cancel anytime.</p>
      <% } %>
      <a class="prc-jump" href="#plans">See the plans</a>
    </div>
  </section>
  <section class="prc-plans" id="plans" data-plans-wrap>
    <div class="wrap">
      <% if (ps === 'A' && fp) { %>
      <div class="pr-offer"><%- include('partials/founding-offer') %>
        <p class="consent-line honor-line">If checkout breaks on our side before the close, email <a href="mailto:hello@127group.io">hello@127group.io</a> within 48 hours and we'll honor the founding price.</p>
      </div>
      <% } %>
      <% if (ps === 'B') { %>
      <div class="pr-bar">
        <%- include('partials/countdown-line', { cdTarget: launch.closesAt, cdLabel: 'FOUNDING PRICE ENDS IN', cdShort: true }) %>
        <% if (launch.spotsLeft <= 25) { %><span class="mono pr-spots">· <%= launch.spotsLeft %> SPOTS LEFT</span><% } %>
        <span class="pr-bar-copy">Builder is <%= fp ? '$' + fp + ' a month' : 'at the founding price' %>, locked for as long as you stay. No Black Friday sale.</span>
      </div>
      <% } %>
      <div class="prc-tabs" role="tablist" aria-label="Plans" data-tabs hidden>
        <% ['free', 'builder', 'circle'].forEach(function (k) { %><button type="button" role="tab" id="tab-<%= k %>" aria-controls="plan-<%= k %>" aria-selected="<%= k === 'builder' ? 'true' : 'false' %>" data-tab="<%= k %>" class="<%= k === 'circle' ? 'is-circle' : '' %>"><span><%= tabName[k] %></span><b><%= tabPrice[k] %></b></button><% }) %>
      </div>
      <%- include('partials/plans', { plansAnchor: true, plansLedger: true }) %>
      <div class="prc-compare-head"><h2>What each plan includes.</h2><p class="prc-compare-note">Showing <b data-compare-name>Builder</b> next to every feature. Switch plans with the tabs.</p></div>
      <div class="card scroll-x pr-compare prc-compare" data-compare data-show="builder">
        <table class="t">
          <thead><tr><th></th><th>Free</th><th>Builder</th><th>Founder's Circle</th></tr></thead>
          <tbody>
            <% if (hqo) hqo.compare.forEach(function (r) { %><tr><td><%= r[0] %></td><td><%= r[1] %></td><td><%= r[2] %></td><td><%= r[3] %></td></tr><% }) %>
            <tr><td>Founder assessment and 30-day roadmap</td><td>Weeks 1 and 2</td><td>Full</td><td>Full</td></tr>
            <tr><td>Playbooks, worksheets and calculators</td><td>Starter 3, plus what weeks 1 and 2 use</td><td>All <%= resourceCount %></td><td>All <%= resourceCount %></td></tr><% if (hqStore) { %>
            <tr><td>Templates in the Store</td><td><%= hqStore.free %></td><td>All <%= hqStore.count %></td><td>All <%= hqStore.count %></td></tr><% } %>
            <tr><td>Eli's Playbook (AI)</td><td>Chat + Idea Validator · <%= PLANS.free.aiRunsPerMonth %> messages/mo</td><td>Every tool · about <%= PLANS.builder.aiRunsPerMonth %>/mo</td><td>Every tool · about <%= PLANS.circle.aiRunsPerMonth %>/mo</td></tr>
            <tr><td>AI feedback on your worksheets</td><td>Within your <%= PLANS.free.aiRunsPerMonth %></td><td>✓</td><td>✓</td></tr>
            <tr><td>Progress, milestones and badges</td><td>✓</td><td>✓</td><td>✓</td></tr>
            <tr><td>Member wins board</td><td>✓</td><td>✓</td><td>✓</td></tr>
            <tr><td>Weekly founder-led group call</td><td>–</td><td>–</td><td>✓</td></tr>
            <tr><td>Private member group</td><td>–</td><td>–</td><td>✓</td></tr>
            <tr><td>Recap of decisions and commitments</td><td>–</td><td>–</td><td>✓</td></tr>
            <% if (showCallRow) { %><tr><td>Founding call with Eli (Dec 1)</td><td>–</td><td>Founding members</td><td>Founding members</td></tr><% } %>
            <tr><td>14 days to change your mind</td><td>–</td><td>✓</td><td>See the Circle terms</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <% if (hqo) { %><%- include('partials/hq-stack') %><% } %>
  <% if (ps === 'B') { %>
  <section class="pr-close">
    <div class="wrap narrow center">
      <div class="pr-offer"><%- include('partials/founding-offer') %></div>
      <% if (user && user.tier !== 'free') { %>
      <% } else if (user) { %>
      <form method="post" action="/app/billing/checkout/builder"><button class="btn" data-track="Plan Click" data-props='<%- JSON.stringify({ plan: "builder", state: ps }) %>'><%= fp ? 'Lock $' + fp + ' a month' : 'Lock the founding price' %></button></form>
      <% } else { %>
      <a href="/founding/lock" class="btn" data-track="Plan Click" data-props='<%- JSON.stringify({ plan: "builder", state: ps }) %>'><%= fp ? 'Lock $' + fp + ' a month' : 'Lock the founding price' %></a>
      <% } %>
      <p class="consent-line honor-line">If checkout breaks on our side before the close, email <a href="mailto:hello@127group.io">hello@127group.io</a> within 48 hours and we'll honor the founding price.</p>
    </div>
  </section>
  <% } %>
  <section class="pr-trust prc-trust"><div class="wrap narrow"><%- include('partials/trust-block') %></div></section>
  <section class="prc-faq"><div class="wrap"><h2>Good to know.</h2><%- include('partials/faq') %></div></section>
  <script src="/js/pricing.js" defer></script>
</main>
<%- include('partials/foot') %>

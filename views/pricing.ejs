<%- include('partials/head') %>
<%
  // Three states (conversion/pages/pricing.md): A before doors open, B founding window, C evergreen.
  var ps = launch.prelaunch ? 'A' : launch.foundingOpen ? 'B' : 'C';
  var fp = launch.foundingPrice;
  var cap = launch.cap;
  // The founding call row comes off after the call (December 1, 8pm ET).
  var showCallRow = Date.now() < Date.parse('2026-12-02T05:00:00Z');
%>
<main>
  <section style="padding-bottom:48px">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Membership</div>
        <h1 style="font-size:clamp(44px,6vw,72px)">Start free. Grow into it.</h1>
        <p>Every plan starts with the free assessment and a 30-day roadmap built for you. Upgrade when it's earned it. Cancel anytime.</p>
        <% if (ps === 'A' && fp) { %><p class="pr-line">Doors open<%= launch.launchDate ? ' ' + launch.launchDate : ' soon' %>. The first <%= cap %> Builders pay $<%= fp %> a month, locked while they stay.</p>
        <p class="consent-line honor-line">If checkout breaks on our side before the close, email <a href="mailto:hello@127group.io">hello@127group.io</a> within 48 hours and we'll honor the founding price.</p><% } %>
      </div>
      <% if (ps === 'B') { %>
      <div class="pr-bar">
        <%- include('partials/countdown-line', { cdTarget: launch.closesAt, cdLabel: 'FOUNDING PRICE ENDS IN', cdShort: true }) %>
        <% if (launch.spotsLeft <= 25) { %><span class="mono pr-spots">· <%= launch.spotsLeft %> SPOTS LEFT</span><% } %>
        <span class="pr-bar-copy">Builder is <%= fp ? '$' + fp + ' a month' : 'at the founding price' %>, locked while you stay. No Black Friday sale.</span>
      </div>
      <% } %>
      <%- include('partials/plans') %>
    </div>
  </section>
  <section style="padding-top:24px">
    <div class="wrap">
      <div class="section-head"><div class="eyebrow">Compare</div><h2>What each plan includes.</h2></div>
      <div class="card scroll-x pr-compare" style="padding:8px 8px">
        <table class="t">
          <thead><tr><th></th><th>Free</th><th>Builder</th><th>Founder's Circle</th></tr></thead>
          <tbody>
            <tr><td>Founder assessment and 30-day roadmap</td><td>Weeks 1 and 2</td><td>Full</td><td>Full</td></tr>
            <tr><td>Playbooks, worksheets and calculators</td><td>Starter 3, plus what weeks 1 and 2 use</td><td>All <%= resourceCount %></td><td>All <%= resourceCount %></td></tr>
            <tr><td>Eli's Playbook (AI)</td><td>Chat + Idea Validator · <%= PLANS.free.aiRunsPerMonth %> messages/mo</td><td>Every tool · about <%= PLANS.builder.aiRunsPerMonth %>/mo</td><td>Every tool · about <%= PLANS.circle.aiRunsPerMonth %>/mo</td></tr>
            <tr><td>AI feedback on your worksheets</td><td>Within your <%= PLANS.free.aiRunsPerMonth %></td><td>✓</td><td>✓</td></tr>
            <tr><td>Progress, milestones and badges</td><td>✓</td><td>✓</td><td>✓</td></tr>
            <tr><td>Member wins board</td><td>✓</td><td>✓</td><td>✓</td></tr>
            <tr><td>Weekly founder-led group call</td><td>–</td><td>–</td><td>✓</td></tr>
            <tr><td>Private member group</td><td>–</td><td>–</td><td>✓</td></tr>
            <tr><td>Recap of decisions and commitments</td><td>–</td><td>–</td><td>✓</td></tr>
            <% if (showCallRow) { %><tr><td>Founding call with Eli (Dec 1)</td><td>–</td><td>Founding members</td><td>Founding members</td></tr><% } %>
            <tr><td>14 days to change your mind</td><td>–</td><td>✓</td><td>See the Circle terms</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <% if (ps === 'B') { %>
  <section class="pr-close">
    <div class="wrap narrow center">
      <h2 class="h2"><%= fp ? '$' + fp + ' a month.' : 'The founding price.' %><%= fp && fp * 12 / 365 < 1 ? ' Less than a dollar a day.' : '' %></h2>
      <p class="sub" style="margin-left:auto;margin-right:auto">Founding members keep it for as long as they stay. It ends <%= launch.closesDay ? launch.closesDay + ' at ' + launch.closesTime : 'at the founding close' %>, or when <%= cap %> founding members join. There's no Black Friday sale.</p>
      <% if (user && user.tier !== 'free') { %>
      <% } else if (user) { %>
      <form method="post" action="/app/billing/checkout/builder"><button class="btn" data-track="Plan Click" data-props='<%- JSON.stringify({ plan: "builder", state: ps }) %>'><%= fp ? 'Lock $' + fp + ' a month' : 'Lock the founding price' %></button></form>
      <% } else { %>
      <a href="/founding/lock" class="btn" data-track="Plan Click" data-props='<%- JSON.stringify({ plan: "builder", state: ps }) %>'><%= fp ? 'Lock $' + fp + ' a month' : 'Lock the founding price' %></a>
      <% } %>
      <p class="consent-line honor-line">If checkout breaks on our side before the close, email <a href="mailto:hello@127group.io">hello@127group.io</a> within 48 hours and we'll honor the founding price.</p>
    </div>
  </section>
  <% } %>
  <section class="pr-trust"><div class="wrap narrow"><%- include('partials/trust-block') %></div></section>
  <section style="padding-top:24px"><div class="wrap"><div class="section-head"><div class="eyebrow">Questions</div><h2>Good to know.</h2></div><%- include('partials/faq') %></div></section>
</main>
<%- include('partials/foot') %>

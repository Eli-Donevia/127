<script type="module">
// The glass 127. On the brand hero it's First Light, live (public/js/first-light.js), or with water the liquid 127
// (public/js/liquid-127.js); in run mode it's the loop, fading in
// over its poster in the hook. Reduced motion and Save-Data keep the posters. Phones get smaller files.
const mm = (q) => matchMedia(q).matches;
const still = mm('(prefers-reduced-motion: reduce)') || !!(navigator.connection || {}).saveData;
const phone = mm('(max-width: 760px)');
const box = document.querySelector('.hx-mark');
const fl = document.querySelector('[data-fl]');
if (fl) {
  const day = fl.querySelector('[data-fl-day]');
  day.textContent = 'Day 001 · ' + new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }).replace(/,/g, '');
  const water = fl.hasAttribute('data-fl-water'), hover = mm('(hover: hover)');
  if (water || !hover) fl.querySelector('[data-fl-hint]').textContent = water ? (hover ? 'Move through the water' : 'Drag through the water') : 'Drag to light it';
  if (!still) {
    // The poster is the first paint. The live hero starts only once the page has loaded and the browser is idle, so
    // its passes and shader never compete with the poster, the copy or a first tap; it then picks up at rest. A slow
    // device that can't keep it smooth hands back to the poster.
    // With water, if the still pond is showing (is-pond, set at the top of the hero) the 127 rises out of it; the
    // choice is made the moment it starts drawing, so the poster's 5 s fallback can't fire in between.
    const pond = () => fl.classList.contains('is-pond');
    // With the pin (is-scrub), the rise follows how far the page has scrolled through it.
    const pin = fl.parentElement.classList.contains('fl-scrub') ? fl.parentElement : null;
    const scrub = () => { const r = pin.getBoundingClientRect(), top = parseFloat(getComputedStyle(fl).top) || 0; return (top - r.top) / Math.max(1, r.height - fl.offsetHeight); };
    const unpin = () => { clearTimeout(fl.flPond); fl.classList.remove('is-pond'); if (pin) pin.classList.remove('is-scrub'); };
    const opts = { small: phone, get reveal() { clearTimeout(fl.flPond); return pond(); }, onSlow: () => { fl.classList.remove('is-live'); if (pin) pin.classList.remove('is-scrub'); } };
    if (pin && pond()) opts.scrub = scrub;
    const live = () => (water
      ? import('/js/liquid-127.js').then(({ liquid127 }) => liquid127(fl.querySelector('.fl-stage'), opts))
      : import('/js/first-light.js').then(({ firstLight }) => firstLight(fl.querySelector('.fl-stage'), { ...opts, base: '/img/fl/' })))
      .then((r) => { if (r.reveal) fl.classList.add('is-reveal'); fl.classList.add('is-live'); fl.classList.remove('is-pond'); })
      .catch(unpin);
    const later = () => ('requestIdleCallback' in window ? requestIdleCallback(live, { timeout: pond() ? 400 : 2500 }) : setTimeout(live, 300));
    document.readyState === 'complete' ? later() : addEventListener('load', later, { once: true });
  }
}
function loop() {
  const name = phone ? 'first-light-loop-phone' : 'first-light-loop';
  const v = document.createElement('video');
  Object.assign(v, { muted: true, loop: true, playsInline: true, autoplay: true, className: 'hx-loop' });
  v.setAttribute('muted', ''); v.setAttribute('playsinline', ''); v.setAttribute('aria-hidden', 'true');
  v.poster = '/img/' + (phone ? 'first-light-phone' : 'first-light') + '.jpg';
  v.innerHTML = '<source src="/video/' + name + '.webm" type="video/webm"><source src="/video/' + name + '.mp4" type="video/mp4">';
  v.addEventListener('playing', () => box.classList.add('is-playing'), { once: true });
  box.appendChild(v);
  const p = v.play(); if (p && p.catch) p.catch(() => {});
}
const go = () => (still || !box ? null : loop());
const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1500 }) : setTimeout(go, 200));
document.readyState === 'complete' ? idle() : addEventListener('load', idle, { once: true });
</script>
<% if (run) { %>
<script>
(function () {
  // Run-mode hero. "Something else" opens First 25 without running it, so they can say what they sell first.
  var f = document.querySelector('[data-h5r-form]');
  if (f) f.addEventListener('submit', function () { var p = f.querySelector('input[name=pack]:checked'); f.querySelector('input[name=go]').disabled = !!(p && p.value === 'other'); });
  // The sample sheet counts to 25 and types the first message once. Reduced motion shows the finished sheet.
  var d = document.querySelector('[data-h5r-demo]');
  if (!d || (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
  var n = d.querySelector('[data-h5r-n]'), t = d.querySelector('[data-h5r-type]'), full = t.textContent;
  d.classList.add('is-run'); n.textContent = '0'; t.textContent = '';
  var k = 0, iv = setInterval(function () { n.textContent = ++k; if (k >= 25) clearInterval(iv); }, 60);
  var j = 0; setTimeout(function step() { j += 2; t.textContent = full.slice(0, j); if (j < full.length) setTimeout(step, 16); }, 1500);
})();
</script>
<% } %>
<script>
(function () {
  // Below-the-fold photo backgrounds and the looping clips load only when they get near the screen,
  // and the clips pause again when they leave it.
  var els = document.querySelectorAll('.verse-block, .cta-photo');
  var vids = document.querySelectorAll('video.lazy-loop');
  var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var save = navigator.connection && navigator.connection.saveData;
  function startVid(v) { if (still || save) return; if (!v.src) v.src = v.getAttribute('data-src'); var p = v.play(); if (p && p.catch) p.catch(function () {}); }
  if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('bg-in'); }); document.querySelectorAll('video[data-poster]').forEach(function (v) { v.poster = v.getAttribute('data-poster'); }); vids.forEach(startVid); return; }
  var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('bg-in'); io.unobserve(e.target); } }); }, { rootMargin: '800px 0px' });
  els.forEach(function (e) { io.observe(e); });
  // video posters below the fold wait the same way, so they don't compete with the hero on a slow connection
  var po = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.poster = e.target.getAttribute('data-poster'); po.unobserve(e.target); } }); }, { rootMargin: '800px 0px' });
  document.querySelectorAll('video[data-poster]').forEach(function (v) { po.observe(v); });
  var vo = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) startVid(e.target); else if (e.target.src) e.target.pause(); }); }, { rootMargin: '200px 0px' });
  vids.forEach(function (v) { vo.observe(v); });

  // FAQ opens (home_faq_open, prop q).
  document.querySelectorAll('.home-faq details').forEach(function (d) {
    d.addEventListener('toggle', function () { if (d.open && window.plausible) window.plausible('home_faq_open', { props: { q: d.getAttribute('data-q') } }); });
  });

  // State A: inline founding-list form (posts to /api/waitlist with source "home").
  var f = document.querySelector('[data-home-join]');
  if (!f) return;
  var done = document.querySelector('[data-home-joined]');
  var err = f.querySelector('.hj-error');
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = f.email.value.trim(), box = f.optin.checked, btn = f.querySelector('button');
    err.hidden = true;
    if (!email || !f.email.checkValidity()) { err.textContent = 'Enter a valid email.'; err.hidden = false; f.email.focus(); return; }
    btn.disabled = true;
    var body = { email: email, optin: box, source: 'home' };
    try { var u = JSON.parse(localStorage.getItem('127-utm') || 'null'); if (u) ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (k) { if (u[k]) body[k] = u[k]; }); } catch (x) {}
    fetch('/api/waitlist', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (r) {
        btn.disabled = false;
        if (!r.ok || !r.j.ok) { err.textContent = r.j.error || 'Something went wrong. Try again.'; err.hidden = false; return; }
        if (window.plausible) window.plausible('home_waitlist_submit', { props: { flag: f.getAttribute('data-flag'), box: box } });
        done.querySelector('[data-ref-link]').textContent = r.j.referral_link || '';
        f.hidden = true; done.hidden = false; done.focus();
      })
      .catch(function () { btn.disabled = false; err.textContent = 'Something went wrong. Try again.'; err.hidden = false; });
  });
  var copy = done.querySelector('[data-ref-copy]');
  copy.addEventListener('click', function () {
    var t = done.querySelector('[data-ref-link]').textContent;
    var ok = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy link'; }, 1600); };
    if (navigator.clipboard) navigator.clipboard.writeText(t).then(ok, function () {}); else ok();
  });
})();
</script>

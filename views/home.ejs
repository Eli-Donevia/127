<%
  // Homepage, v2 of the platform (v2/design in the project files). One button in the hero, the end result up top,
  // real outputs instead of feature tables. States from conversion/pages/homepage.md section 1: A1/A2 before doors
  // open (A1 while Day One Challenge sign-ups are open), B the founding window, C evergreen. All from server time.
  var st = hState;
  var S = st.charAt(0); // A, B or C
  var L = launch;
  var PM = L.foundingPrice ? '$' + L.foundingPrice + ' a month' : 'the founding price';
  var doorsAt = L.launchAbbr ? L.launchAbbr + ' at ' + L.launchTime : null; // "Tue, Nov 17 at 10am ET"
  var closesAt = L.closesAbbr ? L.closesAbbr + ' at ' + L.closesTime : null; // "Tue, Nov 24 at 11:59pm ET"
  var doorsLine = doorsAt ? 'Doors open ' + doorsAt + '.' : 'Doors open soon.';
  var rc = resources.length;
  var rFree = resources.filter(function (r) { return r.tier === 'free'; }).length;
  var refN = L.referralsForReward;
  // Plausible click goals (section 14): state only, never personal data.
  var tk = function (ev, extra) { var p = { state: st }; for (var k in (extra || {})) p[k] = extra[k]; return " data-track=\"" + ev + "\" data-props='" + JSON.stringify(p) + "'"; };
  // One way in (Homepage clarity review), labeled by state as conversion/pages/homepage.md does:
  // A joins the founding list, B gets the roadmap, C starts free.
  var cta = S === 'A' ? ['/founding', 'Join the founding list'] : S === 'B' ? ['/start', 'Get my roadmap'] : ['/start', 'Start free'];
  // The B "3-line version" (sections 10 and 12), word for word.
  var bLines = [
    'Builder is ' + PM + ' for founding members, locked for as long as you stay.',
    'It ends ' + (L.closesDay ? L.closesDay + ' at ' + L.closesTime : 'at the founding close') + ', or when ' + L.cap + ' founding members join.',
    '14 days to change your mind. No Black Friday sale.'
  ];
  // O23: no still-watch (reads as luxury) or eli-plane (travel next to money messaging).
  var reel = ['eli-stage-full', 'eli-popup-01', 'desk-overhead', 'eli-stockroom-square', 'eli-award-night', 'eli-hotel-corner', 'eli-gym-portrait', 'eli-popup-02', 'still-timer', 'hotel-desk', 'eli-headphones'];
  // Ticker: Eli's credentials as he set them (Oct 16), worded per Legal L49 (legal/handoffs/eli-credentials.md).
  // The valuation is a money figure, so the static earnings line sits under the ticker (compliance-review C13).
  var proof = [
    'Top 3 of 6,000+ sales agents',
    '4x founder',
    '$1M+ fintech startup valuation',
    'AI, software & e-commerce founder',
    '25M+ views across social',
    '100K+ followers built',
    'Fintech category winner at Best of the Midwest (Iowa Startup Week)'
  ];
  // What day 30 looks like: one demo member's outputs, labeled as a sample (voice section 7: never invent results).
  // Jordan edits videos for local gyms (voice section 15's local-service example).
  var made = [
    { week: 1, plan: 'Free', title: 'A tested idea.', tool: 'The Idea Test' },
    { week: 2, plan: 'Free', title: 'Proof from real people.', tool: 'Validation Interview Scripts' },
    { week: 3, plan: 'Builder', title: 'A price and a first offer.', tool: 'The One-Page Offer' },
    { week: 4, plan: 'Builder', title: 'A launch date.', tool: 'Launch Checklist Generator' }
  ];
  // The AI tools (lib/ai.js TOOLS), each with the finished thing it hands back.
  var outputs = {
    'ask': 'One next action, every time',
    'offer-validator': 'A scored idea before you spend a dollar',
    'interview-synthesizer': 'The patterns, your buyers\' exact words and a straight verdict',
    'offer-stack': 'A one-page offer: the promise, what\'s included, the price',
    'hook-writer': '10 first lines for your next post, and the 2 to test first',
    'content-planner': 'A week of posts built around your offer',
    'outreach-writer': 'A first message, 2 follow-ups and your replies',
    'sales-call-prep': 'The questions, the price line and honest answers to objections',
    'launch-planner': 'A dated, day-by-day launch plan',
    'campaign-planner': 'A small, capped campaign with a stop rule',
    'workflow-recommender': 'What to automate or hand off first'
  };
  var order = ['ask', 'offer-validator', 'interview-synthesizer', 'offer-stack', 'hook-writer', 'content-planner', 'outreach-writer', 'sales-call-prep', 'launch-planner', 'campaign-planner', 'workflow-recommender'];
  var toolList = order.map(function (s) { return tools.filter(function (t) { return t.slug === s; })[0]; }).filter(Boolean);
  var hqOn = process.env.HQ_LIVE === 'true'; // HQ goes on the homepage only when it's live for every member.
-%>
<%- include('partials/head', { hbState: st === 'C' ? null : st }) %>
<main class="v5" data-state="<%= st %>">

  <!-- HERO: the bio's promise, one button, the 3D 127 under a halo -->
  <section class="h5">
    <%# The halo ring sits behind the mark. The live 3D mark runs on desktop; phones, reduced motion and low-power devices get the pre-rendered loop (or its poster) instead. %>
    <div class="hx-mark" aria-hidden="true">
      <div class="h5-halo"></div>
      <canvas id="hero3d" data-fit="1.08"></canvas>
      <picture><source media="(max-width: 760px)" srcset="/img/hero-loop-mobile-poster.jpg" width="1080" height="1350"><img class="hx-poster" src="/img/hero-loop-16x9-poster.jpg" alt="" width="1920" height="1080" decoding="async"></picture>
    </div>
    <div class="wrap h5-copy">
      <p class="lbl">Make today day one</p>
      <h1 class="h5-title"><span class="dim"><span>Your</span> <span>business</span> <span>idea,</span></span> <span class="st"><span>launched</span> <span>with</span> <span>AI.</span></span></h1>
      <p class="h5-sub">30 days to a tested idea, a price, a first offer and a launch date, with AI at every step.</p>
      <a href="<%= cta[0] %>" class="btn light big h5-btn"<%- tk('home_hero_primary') %>><%= cta[1] %> <span class="arrow"></span></a>
      <p class="h5-note"><% if (S === 'A') { %><%= doorsLine %> No card to join.<% } else { %>No card. Under 5 minutes to start.<% } %><br>Built by Eli Christiansen, 4x founder.</p>
    </div>
    <div class="ticker" aria-label="About Eli">
      <div class="ticker-track"><% proof.concat(proof).forEach(function (p) { %><span><%= p %></span><% }) %></div>
      <p class="ticker-note">Eli's results aren't typical or a promise of what you'll earn. <a href="/earnings-disclaimer">Earnings disclaimer</a></p>
    </div>
  </section>

  <!-- THE HOOK -->
  <section class="pain">
    <div class="wrap">
      <p class="lit">You've saved 300 reels about starting a business.</p>
      <p class="lit">You have 5 ideas and 0 customers.</p>
      <p class="lit">You bought the program. You never finished it.</p>
      <p class="lit">You're waiting until you feel ready.</p>
      <p class="lit punch">Ready is a decision.<br><span>Make it today.</span></p>
    </div>
  </section>

  <!-- DAY 30: the end result, as the real things a member makes (a labeled sample) -->
  <section class="o5" id="how">
    <div class="wrap">
      <div class="o5-head">
        <p class="lbl" data-reveal>Your first 30 days</p>
        <h2 class="h2" data-reveal><span class="dim">You don't finish with notes.</span> You finish with these.</h2>
        <p class="sub" data-reveal>Every step ends with something you made. Here's a sample roadmap: Jordan, who edits videos for local gyms.</p>
      </div>
      <div class="o5-grid" data-o5-scroll>
        <% made.forEach(function (m, i) { %>
        <article class="o5-card" data-reveal>
          <div class="o5-top"><span>Week <%= m.week %></span><span class="o5-plan<%= m.plan === 'Free' ? ' is-free' : '' %>"><%= m.plan %></span></div>
          <h3><%= m.title %></h3>
          <div class="o5-art">
            <% if (i === 0) { %>
            <div class="art-row"><b>Video editing for local gyms</b><span class="art-score">72<small>/100</small></span></div>
            <div class="art-verdict">Promising</div>
            <% [['Will they pay', 8], ['Numbers and channel', 7], ['Edge', 6], ['Market direction', 8], ['Inside knowledge', 7]].forEach(function (c) { %>
            <div class="art-bar"><span><%= c[0] %></span><i style="--v:<%= c[1] * 10 %>%"></i><em><%= c[1] %></em></div>
            <% }) %>
            <% } else if (i === 1) { %>
            <div class="art-k">Screener</div>
            <p class="art-q">1. When was the last time you posted a video for the gym?</p>
            <p class="art-q">2. What did you do about it?</p>
            <div class="art-k">Conversations</div>
            <div class="art-tally"><% for (var n = 0; n < 10; n++) { %><i class="<%= n < 6 ? 'on' : '' %>"></i><% } %><em>6 of 10</em></div>
            <% } else if (i === 2) { %>
            <div class="art-k">The promise</div>
            <p class="art-q">4 short videos a month for your gym, edited and ready to post.</p>
            <div class="art-k">What's included</div>
            <p class="art-q">Filming plan · Edits · Captions · 1 revision</p>
            <div class="art-row art-price"><span>Pilot price</span><b>$150 for the first month</b></div>
            <% } else { %>
            <% [['Mon', 'Post the before and after'], ['Tue', 'Message 10 gym owners'], ['Wed', 'Send 2 follow-ups'], ['Thu', 'Prep the sales call'], ['Fri', 'Launch']].forEach(function (d, k) { %>
            <div class="art-day<%= k === 4 ? ' is-launch' : '' %>"><span><%= d[0] %></span><b><%= d[1] %></b></div>
            <% }) %>
            <% } %>
          </div>
          <div class="o5-foot"><span><%= m.tool %></span><span>Sample</span></div>
        </article>
        <% }) %>
      </div>
      <div class="o5-end" data-reveal>
        <p>Weeks 1 and 2 are free. Weeks 3 and 4 come with Builder.</p>
        <a href="<%= cta[0] %>" class="btn ink big"<%- tk('home_weeks_cta') %>><%= cta[1] %> <span class="arrow"></span></a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: four moves next to the real product (Video's walkthrough, demo member) -->
  <section class="w5">
    <div class="wrap w5-grid">
      <div class="w5-copy">
        <p class="lbl" data-reveal>How it works</p>
        <h2 class="h2" data-reveal>3 minutes to start.<br><span class="dim">Then one step at a time.</span></h2>
        <ol class="w5-steps">
          <li data-reveal><span class="n">01</span><div><h3>Tell us where you are.</h3><p>13 questions on your stage, goal, hours and budget. About 3 minutes, no account.</p></div></li>
          <li data-reveal><span class="n">02</span><div><h3>Get your 30-day roadmap.</h3><p>2 to 3 steps a week, built for your stage, on the Start, Build or Grow track.</p></div></li>
          <li data-reveal><span class="n">03</span><div><h3>Do each step with AI.</h3><p>Every step opens the playbook or AI tool that gets it done.</p></div></li>
          <li data-reveal><span class="n">04</span><div><h3>Get unstuck with Eli's Playbook.</h3><p>It's built on Eli's methods and works from your roadmap, so its answers fit where you are this week.</p></div></li>
        </ol>
      </div>
      <figure class="w5-film" data-reveal>
        <div class="w5-glow" aria-hidden="true"></div>
        <video class="lazy-loop" muted loop playsinline preload="none" poster="/img/walkthrough-9x16.jpg" data-src="/video/walkthrough-9x16-app.mp4" width="720" height="1280" aria-label="The 127 app on a phone: the assessment, a roadmap, the Idea Test and Eli's Playbook"></video>
        <figcaption>The real app. Demo member.</figcaption>
      </figure>
    </div>
  </section>

  <!-- THE AI TOOLS: what each one hands back -->
  <section class="t5" id="library">
    <img class="t5-art" src="/img/v2/glass-7.jpg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1200" height="1500">
    <div class="wrap">
      <div class="t5-head">
        <p class="lbl" data-reveal>AI tools</p>
        <h2 class="h2" data-reveal>Tools that hand you<br><span class="dim">the finished thing.</span></h2>
        <p class="sub" data-reveal>Each one works from your roadmap and ends with something you can use today.</p>
      </div>
      <ul class="t5-grid">
        <% toolList.forEach(function (t) { %>
        <li class="t5-tool" data-reveal>
          <div class="t5-name"><b><%= t.name %></b><span class="o5-plan<%= t.tier === 'free' ? ' is-free' : '' %>"><%= t.tier === 'free' ? 'Free' : 'Builder' %></span></div>
          <p><span aria-hidden="true">→</span> <%= outputs[t.slug] %></p>
        </li>
        <% }) %>
        <li class="t5-tool is-lib" data-reveal>
          <div class="t5-name"><b>The Library</b></div>
          <p><span aria-hidden="true">→</span> <%= rc %> playbooks, worksheets and templates. <%= rFree %> are free.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- WHAT $0 GETS YOU: the free plan, itemized like a receipt. Real items only, no made-up "values". -->
  <section class="r5">
    <div class="wrap r5-grid">
      <div class="r5-copy">
        <p class="lbl" data-reveal>The free plan</p>
        <h2 class="h2" data-reveal>Here's what $0 gets you.</h2>
        <p class="sub" data-reveal><% if (S === 'A') { %>All of it is free when doors open<%= L.launchAbbr ? ' ' + L.launchAbbr : '' %>. Join the founding list and we'll tell you when they do.<% } else { %>No card and no trial clock. Keep it as long as you like, and upgrade when Builder is worth it to you.<% } %></p>
        <a href="<%= cta[0] %>" class="btn light big"<%- tk('home_receipt_cta') %>><%= cta[1] %> <span class="arrow"></span></a>
      </div>
      <div class="r5-wrap" data-reveal>
        <figure class="r5-paper" aria-label="The free plan, itemized">
          <div class="r5-head"><div><b>127</b><span>Free plan</span></div><span class="r5-stamp" aria-hidden="true">Day 001</span></div>
          <ul>
            <li><span>1</span><b>Assessment, 13 questions</b><em>$0</em></li>
            <li><span>1</span><b>30-day roadmap, built from your answers</b><em>$0</em></li>
            <li><span>2</span><b>Weeks of steps, with their playbooks</b><em>$0</em></li>
            <li><span>1</span><b>The Idea Test</b><em>$0</em></li>
            <li><span>1</span><b>Validation Interview Scripts</b><em>$0</em></li>
            <li><span>1</span><b>30-Day Content Calendar</b><em>$0</em></li>
            <li><span>1</span><b>Idea &amp; Offer Validator, with AI</b><em>$0</em></li>
            <li><span><%= PLANS.free.aiRunsPerMonth %></span><b>Eli's Playbook messages a month</b><em>$0</em></li>
            <li><span>1</span><b>Progress, milestones and the wins board</b><em>$0</em></li>
          </ul>
          <div class="r5-total"><span>Total</span><b>$0.00</b></div>
          <p class="r5-foot">No card · Nothing to cancel</p>
        </figure>
      </div>
    </div>
  </section>

  <% if (hqOn) { %>
  <!-- 127 HQ: shown once HQ is live for every member (HQ_LIVE=true) -->
  <section class="q5">
    <div class="wrap q5-grid">
      <div>
        <p class="lbl" data-reveal>127 HQ</p>
        <h2 class="h2" data-reveal>Then run it<br><span class="dim">from one screen.</span></h2>
        <p class="sub" data-reveal>Your numbers in one place, filled in from Stripe and Shopify. HQ finds the leak and gives you one call for the week.</p>
      </div>
      <ul class="q5-list">
        <li data-reveal><b>Your North Number</b><span>The one number for this month, with a 12-week line.</span></li>
        <li data-reveal><b>The leak and the call</b><span>Your weakest step, then double down, pause or kill.</span></li>
        <li data-reveal><b>Numbers that fill themselves</b><span>Sales and revenue from Stripe and Shopify, plus your 127 link for anything else.</span></li>
        <li data-reveal><b>Read my week</b><span>Eli's Playbook reads 12 weeks and names one test to run.</span></li>
      </ul>
    </div>
  </section>
  <% } %>

  <!-- PHOTO REEL -->
  <section class="reel" aria-label="Photos of Eli building">
    <div class="reel-row r1"><div class="reel-track"><% reel.concat(reel).forEach(function (n) { %><img src="/img/wall/<%= n %>.jpg" alt="" loading="lazy" width="480" height="600"><% }) %></div></div>
    <div class="reel-row r2"><div class="reel-track"><% reel.slice().reverse().concat(reel.slice().reverse()).forEach(function (n) { %><img src="/img/wall/<%= n %>.jpg" alt="" loading="lazy" width="480" height="600"><% }) %></div></div>
    <div class="reel-copy wrap">
      <h2>Built in stockrooms and on stages.<br><span>Not in a classroom.</span></h2>
    </div>
  </section>

  <% if (video) { %>
  <!-- INTRO VIDEO: Video's Finovate highlight (public/video/intro.mp4) until Eli's "Why I built 127" clip -->
  <section class="video-sec">
    <div class="wrap">
      <h2 class="h2" data-reveal><%= video.title %></h2>
      <div class="video-frame" data-reveal>
        <video src="<%= video.src %>" poster="<%= video.poster %>" playsinline preload="metadata" muted></video>
        <button class="video-play" type="button" aria-label="Play the video"><span></span></button>
      </div>
    </div>
  </section>
  <% } %>

  <!-- FOUNDER (section 7) -->
  <section class="fx" id="why">
    <div class="wrap fx-grid">
      <div class="collage" aria-hidden="true">
        <figure class="cc c1" data-tilt><img src="/img/eli-founder.jpg" alt="" loading="lazy"></figure>
        <figure class="cc c2" data-tilt>
          <video class="lazy-loop" muted loop playsinline preload="none" poster="/img/finovate-stage-loop-16x9-bw.jpg" data-src="/video/finovate-stage-loop-16x9-bw.mp4" width="1920" height="1080"></video>
          <figcaption>Spoke on stage at Finovate Fall</figcaption>
        </figure>
        <figure class="cc c3" data-tilt><img src="/img/wall/eli-award-night.jpg" alt="" loading="lazy"><figcaption>Received a "Most Improved" award</figcaption></figure>
        <figure class="cc c4" data-tilt><img src="/img/wall/eli-popup-01.jpg" alt="" loading="lazy"><figcaption>Apparel pop-up</figcaption></figure>
      </div>
      <div class="fx-body">
        <%- include('partials/why-127') %>
        <%# The numbers: voice section 7 word for word, one per line, with the earnings line directly under them. %>
        <div class="stats" data-reveal>
          <div><b data-to="25" data-suf="M+">25M+</b><span>views across social</span></div>
          <div><b data-to="100" data-suf="K+">100K+</b><span>followers built</span></div>
          <div><b data-to="50" data-pre="$" data-suf="K">$50K</b><span>in gross sales from a part-time e-commerce brand; first drop sold out; customers in 35 of 50 states</span></div>
          <div><b data-to="3" data-pre="#">#3</b><span>in the country on a national vendor sales list of 6,000+ agents (2025); top 25 in his first 6 months (2024)</span></div>
        </div>
        <p class="stats-note">Eli's results aren't typical or a promise of what you'll earn. <a href="/earnings-disclaimer">Earnings disclaimer</a></p>
        <div class="signature">Eli</div>
        <div class="small muted">Eli Christiansen · @elichristiansen_</div>
      </div>
    </div>
  </section>

  <!-- THESIS (section 9) -->
  <div class="verse-block">
    <div class="wrap">
      <blockquote data-reveal>"Unless the Lord builds the house, the builders labor in vain."</blockquote>
      <cite>Psalm 127:1 (NIV)</cite>
      <p>It's why we're called 127. For Eli, building in vain means chasing a dollar sign while neglecting his faith and the people who matter. 127 is built the other way: trust and integrity first, purpose over profit. Faith is Eli's foundation. It's offered here, never required, and 127 is for everyone who wants to build with purpose.</p>
    </div>
  </div>

  <!-- PRICING TEASER (section 10) -->
  <section id="membership" class="p5">
    <div class="wrap">
      <div class="section-head center">
        <h2>Start free. Upgrade when it's earned it.</h2>
        <p>Every plan includes your roadmap, built from your answers.</p>
      </div>
      <%- include('partials/plans', { plansEvent: 'home_pricing_cta', plansState: st }) %>
      <% if (S === 'A') { %>
      <div class="price-state">
        <p><%= doorsLine %> Builder is <%= PM %> for the first <%= L.cap %> founding members, until <%= closesAt || 'the founding close' %>. The founding list gets you the reminders.</p>
        <a href="/founding" class="btn ghost"<%- tk('home_pricing_cta', { plan: 'list' }) %>>Join the founding list <span class="arrow"></span></a>
      </div>
      <% } else if (S === 'B') { %>
      <div class="price-state"><p class="three-lines"><% bLines.forEach(function (l) { %><span><%= l %></span><% }) %></p></div>
      <% } %>
      <div class="home-trust"><%- include('partials/trust-block') %></div>
    </div>
  </section>

  <!-- FAQ (section 11) -->
  <section class="home-faq-sec">
    <div class="wrap">
      <div class="section-head center"><h2>Good to know.</h2></div>
      <%- include('partials/home-faq', { hfState: S }) %>
    </div>
  </section>

  <!-- FINAL CTA (section 12) -->
  <section class="cta-photo" id="join">
    <div class="wrap">
      <h2>Make today day one.</h2>
      <% if (S === 'A') { var cc = consentCopy('founding'); %>
      <p><%= doorsLine %> Join the founding list and we'll tell you when they open.</p>
      <form class="home-join" data-home-join data-flag="<%= joinFlag %>" novalidate>
        <label class="sr-only" for="hj-email">Email</label>
        <input class="input" id="hj-email" type="email" name="email" placeholder="Email" autocomplete="email" required>
        <label class="check"><input type="checkbox" name="optin"> <%= cc.box %></label>
        <p class="consent-line"><%= cc.line %></p>
        <p class="consent-line"><%- cc.terms %></p>
        <p class="hj-error" role="alert" hidden></p>
        <button class="btn light big" type="submit">Join the founding list <span class="arrow"></span></button>
      </form>
      <div class="home-joined" data-home-joined hidden tabindex="-1">
        <p class="hj-lead"><b>You're on the founding list.</b> Check your email and tap Confirm.</p>
        <p><%= doorsLine %><%= closesAt ? ' Founding price ends ' + closesAt + '.' : '' %></p>
        <% if (L.launchAt) { %><a href="/founding/doors-open.ics" class="btn ghost"<%- tk('home_calendar_add') %>>Add doors open to my calendar</a><% } %>
        <div class="hj-ref">
          <p><b>Bring <%= refN %>, get a month.</b> When <%= refN %> friends confirm with your link, your first month of Builder is free. Your link keeps counting until <%= L.closesDate || 'the founding close' %>, and if you've already paid, you get a <%= L.foundingPrice ? '$' + L.foundingPrice : 'one-month' %> credit instead.</p>
          <div class="share-link"><code data-ref-link></code><button type="button" class="btn sm" data-ref-copy data-track="home_ref_copy">Copy link</button></div>
        </div>
      </div>
      <% } else if (S === 'B') { %>
      <p class="three-lines"><% bLines.forEach(function (l) { %><span><%= l %></span><% }) %></p>
      <div class="cta-row">
        <a href="/start" class="btn light big"<%- tk('home_final_primary') %>>Start free <span class="arrow"></span></a>
        <a href="/founding/lock" class="cta-alt"<%- tk('home_final_secondary') %>>Lock <%= PM %></a>
      </div>
      <p class="cta-under">$0 to start. No card.</p>
      <p class="consent-line cta-small">The 14 days cover your first paid Builder charge. One email refunds it in full. Cancel online anytime from Billing. No call or email needed.</p>

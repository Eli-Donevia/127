<%
  // Homepage, v2 of the platform (v2/design in the project files). One button in the hero, the end result up top,
  // real outputs instead of feature tables. States from conversion/pages/homepage.md section 1: A1/A2 before doors
  // open (A1 while Day One Challenge sign-ups are open), B the founding window, C evergreen. All from server time.
  var st = hState;
  var S = st.charAt(0); // A, B or C
  var L = launch;
  var PM = L.foundingPrice ? '$' + L.foundingPrice + ' a month' : 'the founding price';
  var doorsAt = L.launchAbbr ? L.launchAbbr + ' at ' + L.launchTime : null; // "Tue, Nov 17 at 10am ET"
  var closesAt = L.closesAbbr ? L.closesAbbr + ' at ' + L.closesTime : null; // "Tue, Nov 24 at 11:59pm ET"
  var doorsLine = doorsAt ? 'Doors open ' + doorsAt + '.' : 'Doors open soon.';
  var rc = resources.length;
  var rFree = resources.filter(function (r) { return r.tier === 'free'; }).length;
  var refN = L.referralsForReward;
  // Plausible click goals (section 14): state only, never personal data.
  var tk = function (ev, extra) { var p = { state: st }; for (var k in (extra || {})) p[k] = extra[k]; return " data-track=\"" + ev + "\" data-props='" + JSON.stringify(p) + "'"; };
  // One way in (Homepage clarity review), labeled by state as conversion/pages/homepage.md does:
  // A joins the founding list, B gets the roadmap, C starts free.
  var cta = S === 'A' ? ['/founding', 'Join the founding list'] : S === 'B' ? ['/start', 'Get my roadmap'] : ['/start', 'Start free'];
  // The B "3-line version" (sections 10 and 12), word for word.
  var bLines = [
    'Builder is ' + PM + ' for founding members, locked for as long as you stay.',
    'It ends ' + (L.closesDay ? L.closesDay + ' at ' + L.closesTime : 'at the founding close') + ', or when ' + L.cap + ' founding members join.',
    '14 days to change your mind. No Black Friday sale.'
  ];
  // O23: no still-watch (reads as luxury) or eli-plane (travel next to money messaging).
  var reel = ['eli-stage-full', 'eli-popup-01', 'desk-overhead', 'eli-stockroom-square', 'eli-award-night', 'eli-hotel-corner', 'eli-gym-portrait', 'eli-popup-02', 'still-timer', 'hotel-desk', 'eli-headphones'];
  // Ticker: Eli's credentials as he set them (Oct 16), worded per Legal L49 (legal/handoffs/eli-credentials.md).
  // The valuation is a money figure, so the static earnings line sits under the ticker (compliance-review C13).
  var proof = [
    'Top 3 of 6,000+ sales agents',
    '4x founder',
    '$1M+ fintech startup valuation',
    'AI, software & e-commerce founder',
    '25M+ views across social',
    '100K+ followers built',
    'Fintech category winner at Best of the Midwest (Iowa Startup Week)'
  ];
  // What day 30 looks like: one demo member's outputs, labeled as a sample (voice section 7: never invent results).
  // Maya edits videos for local gyms (voice section 15's local-service example; the same sample member as the shared golden path).
  var made = [
    { week: 1, plan: 'Free', title: 'A tested idea.', tool: 'The Idea Test' },
    { week: 2, plan: 'Free', title: 'Proof from real people.', tool: 'Validation Interview Scripts' },
    { week: 3, plan: 'Builder', title: 'A price and a first offer.', tool: 'The One-Page Offer' },
    { week: 4, plan: 'Builder', title: 'A launch date.', tool: 'Launch Checklist Generator' }
  ];
  // The AI tools (lib/ai.js TOOLS), each with the finished thing it hands back.
  var outputs = {
    'ask': 'One next action, every time',
    'offer-validator': 'A scored idea before you spend a dollar',
    'interview-synthesizer': 'The patterns, your buyers\' exact words and a straight verdict',
    'offer-stack': 'A one-page offer: the promise, what\'s included, the price',
    'hook-writer': '10 first lines for your next post, and the 2 to test first',
    'content-planner': 'A week of posts built around your offer',
    'outreach-writer': 'A first message, 2 follow-ups and your replies',
    'sales-call-prep': 'The questions, the price line and honest answers to objections',
    'launch-planner': 'A dated, day-by-day launch plan',
    'campaign-planner': 'A small, capped campaign with a stop rule',
    'workflow-recommender': 'What to automate or hand off first'
  };
  // The question in the visitor's head that each tool answers (problem first, then the tool, then what it hands back).
  var asks = {
    'ask': 'What do I do next?',
    'offer-validator': 'Is my idea any good?',
    'interview-synthesizer': 'What did those calls tell me?',
    'offer-stack': 'What exactly am I selling?',
    'hook-writer': 'Why does nobody stop on my posts?',
    'content-planner': 'What do I post this week?',
    'outreach-writer': 'What do I say in the first message?',
    'sales-call-prep': 'What if they say it costs too much?',
    'launch-planner': 'When do I actually launch?',
    'campaign-planner': 'Should I spend money on ads?',
    'workflow-recommender': 'What can I stop doing myself?'
  };
  var order = ['ask', 'offer-validator', 'interview-synthesizer', 'offer-stack', 'hook-writer', 'content-planner', 'outreach-writer', 'sales-call-prep', 'launch-planner', 'campaign-planner', 'workflow-recommender'];
  var toolList = order.map(function (s) { return tools.filter(function (t) { return t.slug === s; })[0]; }).filter(Boolean);
  var hqOn = process.env.HQ_LIVE === 'true'; // HQ goes on the homepage only when it's live for every member.
  var heroLive = process.env.HERO_LIVE === 'true'; // the live First Light hero (public/js/first-light.js); off keeps the loop hero
  // With it, the liquid 127: a real-time 3D glass 127 over a pond (public/js/liquid-127.js, poster in /img/liquid). Off keeps the standing mark.
  var heroWater = heroLive && process.env.HERO_WATER === 'true';
  var flDir = heroWater ? '/img/liquid/' : '/img/fl/';
  // Run mode (v2 playbook 2.2): the hero is First 25 itself, so the first screen shows the product doing the work.
  // Only on real business data (server.js), with Legal's First 25 wording (05 rule 6a): the list and the words, never clients.
  // The demo rows are First 25's own sample run (gyms, Des Moines): made-up businesses, labeled Sample.
  var run = typeof first25 !== 'undefined' && first25;
  var f25Packs = [['video', 'Short videos'], ['social', 'Social media'], ['web', 'Websites'], ['ai', 'AI booking'], ['email', 'Email'], ['photo', 'Photos'], ['other', 'Something else']];
  var f25Demo = [
    ['Iron Fitness', '4.6★ · 237 reviews', ['No video', 'No TikTok'], 87],
    ['Steadfast Strength', '4.5★ · 87 reviews', ['No video', 'No TikTok'], 87],
    ['Torch Performance', '4.1★ · 21 reviews', ['No video', '21 reviews'], 87],
    ['Cornerstone Fitness', '4.6★ · 90 reviews', ['No video', 'Few photos'], 82],
    ['Prairie Boxing', '4★ · 21 reviews', ['No video', '21 reviews'], 82]
  ];
-%>
<%# The hero's poster is the first thing to fetch on the brand hero (before the fonts), so slow 4G spends itself on it first. %>
<%- include('partials/head', { hbState: st === 'C' ? null : st, navQuiet: run, heroImg: run ? null : heroLive ? [flDir + 'rest-s.jpg', flDir + 'rest.jpg'] : ['/img/first-light-phone.jpg', '/img/first-light.jpg'] }) %>
<main class="v5" data-state="<%= st %>">

  <% if (run) { %>
  <!-- HERO, run mode: pick what you sell, type a city, and First 25 finds the 25, checks each site and writes the messages -->
  <section class="h5 h5r">
    <div class="wrap h5r-grid">
      <div class="h5r-copy">
        <p class="lbl">Top 3 free · All 25 with your email</p>
        <h1 class="h5-title h5r-title"><span class="st"><span>Your</span> <span>first</span> <span>25.</span></span> <span class="dim"><span>We</span> <span>find</span> <span>them.</span></span></h1>
        <p class="h5-sub">Tell 127 what you sell and your city. You get 25 local businesses that could use it, what each one's website is missing and the message to send each one.</p>
      </div>
      <div class="h5r-demo" aria-hidden="true">
        <div class="h5-halo"></div>
        <div class="h5r-sheet" data-h5r-demo>
          <div class="h5r-head"><span>Your first 25 · Sample</span><span class="h5r-count"><b data-h5r-n>25</b> / 25</span></div>
          <p class="h5r-where">Gyms in Des Moines.</p>
          <ol class="h5r-list">
            <% f25Demo.forEach(function (d, i) { %>
            <li style="--i:<%= i %>"><span class="h5r-rank">#<%= i + 1 %></span><span class="h5r-biz"><b><%= d[0] %></b><small><%= d[1] %></small></span><span class="h5r-gaps"><% d[2].forEach(function (g) { %><i><%= g %></i><% }) %></span><span class="h5r-score" style="--s:<%= d[3] %>%"><%= d[3] %></span></li>
            <% }) %>
          </ol>
          <div class="h5r-msg"><span class="h5r-k">DM for #1 <em>Message ready</em></span><p data-h5r-type>Hi Iron Fitness team. I'm [your name], and I make short videos for gyms in Des Moines. I was on your website and couldn't find any video of your classes. I'd like to make you one free 15-second reel from clips you already have. No cost, no catch. Want me to send it over?</p></div>
          <p class="h5r-foot">Sample businesses, made up to show how it works.</p>
        </div>
      </div>
      <form class="h5r-form" action="/first-25" method="get" data-h5r-form>
        <fieldset class="h5r-chips"><legend><span class="h5r-num">1</span>What do you sell?</legend>
          <div class="h5r-chip-row"><% f25Packs.forEach(function (pk, i) { %><label class="h5r-chip"><input type="radio" name="pack" value="<%= pk[0] %>"<%= i === 0 ? ' checked' : '' %>><span><%= pk[1] %></span></label><% }) %></div>
        </fieldset>
        <label class="h5r-step" for="h5r-place"><span class="h5r-num">2</span>Your city<span class="sr-only"> and state, or ZIP code</span></label>
        <div class="h5r-row">
          <input class="input" id="h5r-place" name="place" placeholder="Your city and state, or ZIP" autocomplete="address-level2" required minlength="2" maxlength="80">
          <input type="hidden" name="go" value="1">
          <button class="btn light big" type="submit"<%- tk('home_hero_primary', { cta: 'first25' }) %>>Find my first 25 <span class="arrow"></span></button>
        </div>
        <p class="h5r-step h5r-send"><span class="h5r-num">3</span>You approve every message and send it yourself.</p>
        <p class="h5-note">Not sure what to sell? <a href="/first-25">Answer 3 questions and we'll pick.</a><br>Built by Eli Christiansen, 4x founder.</p>
      </form>
    </div>
    <div class="ticker" role="region" aria-label="About Eli">
      <div class="ticker-track"><% proof.concat(proof).forEach(function (p) { %><span><%= p %></span><% }) %></div>
      <p class="ticker-note">Eli's results aren't typical or a promise of what you'll earn. <a href="/earnings-disclaimer">Earnings disclaimer</a></p>
    </div>
  </section>
  <% } else { %>
  <% if (heroLive) { %>
  <!-- HERO: the bio's promise and one button, set on the floor under the glass 127, lit live -->
  <%# With water the hero sits in .fl-scrub: where the rise can play, it holds still for a short scroll (is-scrub)
      while the 127 forms out of the pond, then the page scrolls on. %>
  <% if (heroWater) { %><div class="fl-scrub"><% } %>
  <section class="fl" data-fl<% if (heroWater) { %> data-fl-water<% } %>>
    <% if (heroWater) { %><%# With water the page opens on the still pond and the first bit of scroll raises the 127 out
        of it. Where that can play (a real GPU, motion welcome), the still water shows instead of the poster and the
        hero is pinned for the rise; if the live hero isn't drawing within 5 s, the poster fades in, the pin goes and
        the hero picks up at rest. Software WebGL (as in Lighthouse) keeps the poster from the start. %>
    <script>(function (s) { try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator.connection || {}).saveData) return;
      var g = document.createElement('canvas').getContext('webgl2', { failIfMajorPerformanceCaveat: true }); if (!g) return;
      var x = g.getExtension('WEBGL_debug_renderer_info'), l = g.getExtension('WEBGL_lose_context');
      var soft = x && /swiftshader|llvmpipe|softpipe|software|basic render|mesa offscreen/i.test(g.getParameter(x.UNMASKED_RENDERER_WEBGL));
      if (l) l.loseContext(); if (soft) return;
      var w = s.parentNode; s.classList.add('is-pond'); w.classList.add('is-scrub');
      s.flPond = setTimeout(function () { s.classList.remove('is-pond'); w.classList.remove('is-scrub'); }, 5000);
    } catch (e) {} })(document.currentScript.parentNode);</script>
    <% } %>
    <%# First Light, live (public/js/first-light.js): the poster is the lit mark at rest and shows at once. After load the
        same picture is drawn live over it, from the light passes in /img/fl, once the page is loaded and idle: the halo
        breathes and a soft light follows the pointer. Software WebGL (no GPU) keeps the poster. With HERO_WATER it's the liquid 127
        instead (public/js/liquid-127.js), a 3D scene drawn every frame. Reduced motion, Save-Data or no WebGL2 keep the poster. %>
    <div class="fl-stage" aria-hidden="true">
      <picture><source media="(max-width: 760px)" srcset="<%= flDir %>rest-s.jpg" width="960" height="540"><img src="<%= flDir %>rest.jpg" alt="" width="1600" height="900" fetchpriority="high"></picture>
    </div>
    <div class="fl-hud" aria-hidden="true"><span class="tl" data-fl-day>Day 001</span><span class="tr">Make today day one</span><span class="bl" data-fl-hint>Move to light it</span><span class="br">Scroll</span></div>
    <div class="wrap fl-copy">
      <h1 class="fl-title"><span class="dim"><span>Your</span> <span>business</span> <span>idea,</span></span> <span class="st"><span>launched</span> <span>with</span> <span>AI.</span></span></h1>
      <div class="fl-row">
        <%# Before doors open, /start sends people to /founding, so A says what they can do today. Once HQ_OFFER is on,
            Offer's line (offer.md 1A, res.locals.hqOffer) says what HQ is instead. %>
        <% var hqLine = typeof hqOffer !== 'undefined' && hqOffer && hqOffer.show && hqOffer.line; %>
        <p class="fl-sub"><% if (hqLine) { %><%= hqLine %><% } else { %>Validate it, build it and launch it with AI. <%= S === 'A' ? 'Joining the founding list is free, no card.' : 'Start free in under 5 minutes, no card.' %><% } %></p>
        <a href="<%= cta[0] %>" class="btn light big"<%- tk('home_hero_primary') %>><%= cta[1] %> <span class="arrow"></span></a>
      </div>
      <p class="fl-note"><% if (S === 'A') { %><%= doorsLine %> <% } %>Built by Eli Christiansen, 4x founder.</p>
    </div>
  <% } else { %>
  <!-- HERO: the bio's promise, one button, the 3D 127 under a halo -->
  <section class="h5">
    <%# First Light (v2/design/motion): the glass 127 under its halo. The poster is the loop's first frame and shows at once; the loop fades in over it after load, except with reduced motion or Save-Data. %>
    <div class="hx-mark" aria-hidden="true">
      <picture><source media="(max-width: 760px)" srcset="/img/first-light-phone.jpg" width="960" height="540"><img class="hx-poster" src="/img/first-light.jpg" alt="" width="1600" height="900" fetchpriority="high"></picture>
    </div>
    <div class="wrap h5-copy">
      <p class="lbl">Make today day one</p>
      <h1 class="h5-title"><span class="dim"><span>Your</span> <span>business</span> <span>idea,</span></span> <span class="st"><span>launched</span> <span>with</span> <span>AI.</span></span></h1>
      <%# Before doors open, /start sends people to /founding, so A says what they can do today. %>
      <p class="h5-sub">Validate it, build it and launch it with AI. <%= S === 'A' ? 'Joining the founding list is free, no card.' : 'Start free in under 5 minutes, no card.' %></p>
      <a href="<%= cta[0] %>" class="btn light big h5-btn"<%- tk('home_hero_primary') %>><%= cta[1] %> <span class="arrow"></span></a>
      <p class="h5-note"><% if (S === 'A') { %><%= doorsLine %><br><% } %>Built by Eli Christiansen, 4x founder.</p>
    </div>
  <% } %>
    <div class="ticker" role="region" aria-label="About Eli">
      <div class="ticker-track"><% proof.concat(proof).forEach(function (p) { %><span><%= p %></span><% }) %></div>
      <p class="ticker-note">Eli's results aren't typical or a promise of what you'll earn. <a href="/earnings-disclaimer">Earnings disclaimer</a></p>
    </div>
  </section>
  <% if (heroLive && heroWater) { %></div><% } %>
  <% } %>

  <% if (typeof doors !== 'undefined' && doors) { %>
  <!-- WHAT ARE YOU BUILDING? The front doors, one free tool per kind of business (FRONT_DOORS, lib/doors.js) -->
  <%- include('partials/doors', { doors: doors, doorEvent: 'home_door' }) %>
  <% } %>

  <!-- THE HOOK (in run mode the glass 127 moves here, under its halo: the brand moment after the demo) -->
  <section class="pain<%= run ? ' pain-mark' : '' %>">
    <% if (run) { %>
    <div class="hx-mark" aria-hidden="true">
      <picture><source media="(max-width: 760px)" srcset="/img/first-light-phone.jpg" width="960" height="540"><img class="hx-poster" src="/img/first-light.jpg" alt="" width="1600" height="900" decoding="async" loading="lazy"></picture>
    </div>
    <p class="lbl pain-lbl">Make today day one</p>
    <% } %>
    <div class="wrap">
      <p class="lit">You've saved 300 reels about starting a business.</p>
      <p class="lit">You have 5 ideas and 0 customers.</p>
      <p class="lit">You bought the program. You never finished it.</p>
      <p class="lit">You're waiting until you feel ready.</p>
      <p class="lit punch">Ready is a decision.<br><span>Make it today.</span></p>
    </div>
  </section>

  <!-- DAY 30: the end result, as the real things a member makes (a labeled sample) -->
  <section class="o5" id="how">
    <div class="wrap">
      <div class="o5-head">
        <p class="lbl" data-reveal>Your first 30 days</p>
        <h2 class="h2" data-reveal><span class="dim">You don't finish with notes.</span> You finish with these.</h2>
        <p class="sub" data-reveal>Your 30-day roadmap ends with a scored idea, a price, a first offer and a launch calendar. Every step ends with something you made. Here's a sample roadmap: Maya, who edits videos for local gyms.</p>
      </div>
      <div class="o5-grid" data-o5-scroll>
        <% made.forEach(function (m, i) { %>
        <article class="o5-card" data-reveal>
          <div class="o5-top"><span>By day <%= [7, 14, 21, 30][i] %></span><span class="o5-plan<%= m.plan === 'Free' ? ' is-free' : '' %>"><%= m.plan %></span></div>
          <h3><%= m.title %></h3>
          <div class="o5-art">
            <% if (i === 0) { %>
            <div class="art-row"><b>Video editing for local gyms</b><span class="art-score">72<small>/100</small></span></div>
            <div class="art-verdict">Promising</div>
            <% [['Will they pay', 8], ['Numbers and channel', 7], ['Edge', 6], ['Market direction', 8], ['Inside knowledge', 7]].forEach(function (c) { %>
            <div class="art-bar"><span><%= c[0] %></span><i style="--v:<%= c[1] * 10 %>%"></i><em><%= c[1] %></em></div>
            <% }) %>
            <% } else if (i === 1) { %>
            <div class="art-k">Screener</div>
            <p class="art-q">1. When was the last time you posted a video for the gym?</p>
            <p class="art-q">2. What did you do about it?</p>
            <div class="art-k">Conversations</div>
            <div class="art-tally"><% for (var n = 0; n < 10; n++) { %><i class="<%= n < 6 ? 'on' : '' %>"></i><% } %><em>6 of 10</em></div>
            <% } else if (i === 2) { %>
            <div class="art-k">The promise</div>
            <p class="art-q">4 short videos a month for your gym, edited and ready to post.</p>
            <div class="art-k">What's included</div>
            <p class="art-q">Filming plan · Edits · Captions · 1 revision</p>
            <div class="art-row art-price"><span>Pilot price</span><b>$150 for the first month</b></div>
            <% } else { %>
            <% [['Mon', 'Post the before and after'], ['Tue', 'Message 10 gym owners'], ['Wed', 'Send 2 follow-ups'], ['Thu', 'Prep the sales call'], ['Fri', 'Launch']].forEach(function (d, k) { %>
            <div class="art-day<%= k === 4 ? ' is-launch' : '' %>"><span><%= d[0] %></span><b><%= d[1] %></b></div>
            <% }) %>
            <% } %>
          </div>
          <div class="o5-foot"><span><%= m.tool %></span><span>Sample</span></div>
        </article>
        <% }) %>
      </div>
      <div class="o5-end" data-reveal>
        <p>Weeks 1 and 2 are free. Weeks 3 and 4 come with Builder.</p>
        <a href="<%= cta[0] %>" class="btn ink big"<%- tk('home_weeks_cta') %>><%= cta[1] %> <span class="arrow"></span></a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS: four moves next to the real product (Video's walkthrough, demo member) -->
  <section class="w5">
    <div class="wrap w5-grid">
      <div class="w5-copy">
        <p class="lbl" data-reveal>How it works</p>
        <h2 class="h2" data-reveal>3 minutes to start.<br><span class="dim">Then one step at a time.</span></h2>
        <ol class="w5-steps">
          <li data-reveal><span class="n">01</span><div><h3>Tell us where you are.</h3><p>13 questions on your stage, goal, hours and budget. About 3 minutes, no account.</p></div></li>
          <li data-reveal><span class="n">02</span><div><h3>Get your 30-day roadmap.</h3><p>2 to 3 steps a week, built for your stage, on the Start, Build or Grow track. Weeks 1 and 2 are free.</p></div></li>
          <li data-reveal><span class="n">03</span><div><h3>Do each step with AI.</h3><p>Every step opens the playbook or AI tool that gets it done.</p></div></li>
          <li data-reveal><span class="n">04</span><div><h3>Get unstuck with Eli's Playbook.</h3><p>It's built on Eli's methods and works from your roadmap, so its answers fit where you are this week.</p></div></li>
        </ol>
      </div>
      <figure class="w5-film" data-reveal>
        <div class="w5-glow" aria-hidden="true"></div>
        <video class="lazy-loop" muted loop playsinline preload="none" data-poster="/img/walkthrough-9x16.jpg" data-src="/video/walkthrough-9x16-app.mp4" width="720" height="1280" aria-label="The 127 app on a phone: the assessment, a roadmap, the Idea Test and Eli's Playbook"></video>
        <figcaption>The real app. Demo member.</figcaption>
      </figure>
    </div>
  </section>

  <!-- THE AI TOOLS: what each one hands back -->
  <section class="t5" id="library">
    <img class="t5-art" src="/img/v2/glass-7.jpg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1200" height="1500">
    <div class="wrap">
      <div class="t5-head">
        <p class="lbl" data-reveal>AI tools</p>
        <h2 class="h2" data-reveal>Tools that hand you<br><span class="dim">the finished thing.</span></h2>
        <p class="sub" data-reveal>Find the question you're stuck on. Each tool works from your roadmap and ends with something you can use today.</p>
      </div>
      <ul class="t5-grid">
        <% toolList.forEach(function (t) { %>
        <li class="t5-tool" data-reveal>
          <p class="t5-ask">“<%= asks[t.slug] %>”</p>
          <div class="t5-name"><b><%= t.name %></b><span class="o5-plan<%= t.tier === 'free' ? ' is-free' : '' %>"><%= t.tier === 'free' ? 'Free' : 'Builder' %></span></div>
          <p><span aria-hidden="true">→</span> <%= outputs[t.slug] %></p>
        </li>
        <% }) %>
        <li class="t5-tool is-lib" data-reveal>
          <p class="t5-ask">“Is there a template for this?”</p>
          <div class="t5-name"><b>The Library</b></div>
          <p><span aria-hidden="true">→</span> <%= rc %> playbooks, worksheets and templates. <%= rFree %> are free.</p>
        </li>
      </ul>
    </div>
  </section>


<script type="module">
// Hero mark. Desktop: the live 3D mark starts after the page has loaded, over its poster.
// Phones (unless HERO_MOBILE=3d), reduced motion and low-power devices: no WebGL. Phones and low-power get the
// pre-rendered loop; reduced motion keeps the still poster.
const mm = (q) => matchMedia(q).matches;
const still = mm('(prefers-reduced-motion: reduce)');
const phone = mm('(max-width: 760px)');
const phoneLoop = <%- JSON.stringify(heroMobile !== '3d') %>; // HERO_MOBILE=loop (default) or 3d
const c = navigator.connection || {};
const low = !!c.saveData || (navigator.deviceMemory && navigator.deviceMemory <= 2) || (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2);
const box = document.querySelector('.hx-mark');
function loop() {
  const name = phone ? 'hero-loop-mobile' : 'hero-loop-16x9';
  const v = document.createElement('video');
  Object.assign(v, { muted: true, loop: true, playsInline: true, autoplay: true, className: 'hx-loop' });
  v.setAttribute('muted', ''); v.setAttribute('playsinline', ''); v.setAttribute('aria-hidden', 'true');
  v.poster = '/img/' + name + '-poster.jpg';
  v.innerHTML = '<source src="/video/' + name + '.webm" type="video/webm"><source src="/video/' + name + '.mp4" type="video/mp4">';
  v.addEventListener('playing', () => box.classList.add('is-playing'), { once: true });
  box.appendChild(v);
  const p = v.play(); if (p && p.catch) p.catch(() => {});
}
const go = () => (still ? null : ((phone && phoneLoop) || low) ? loop() : import('/js/hero3d.js'));
const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1500 }) : setTimeout(go, 200));
document.readyState === 'complete' ? idle() : addEventListener('load', idle, { once: true });
</script>
<script>
(function () {
  // Below-the-fold photo backgrounds and the looping clips load only when they get near the screen,
  // and the clips pause again when they leave it.
  var els = document.querySelectorAll('.verse-block, .cta-photo');
  var vids = document.querySelectorAll('video.lazy-loop');
  var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var save = navigator.connection && navigator.connection.saveData;
  function startVid(v) { if (still || save) return; if (!v.src) v.src = v.getAttribute('data-src'); var p = v.play(); if (p && p.catch) p.catch(function () {}); }
  if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('bg-in'); }); vids.forEach(startVid); return; }
  var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('bg-in'); io.unobserve(e.target); } }); }, { rootMargin: '800px 0px' });
  els.forEach(function (e) { io.observe(e); });
  var vo = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) startVid(e.target); else if (e.target.src) e.target.pause(); }); }, { rootMargin: '200px 0px' });
  vids.forEach(function (v) { vo.observe(v); });

  // FAQ opens (home_faq_open, prop q).
  document.querySelectorAll('.home-faq details').forEach(function (d) {
    d.addEventListener('toggle', function () { if (d.open && window.plausible) window.plausible('home_faq_open', { props: { q: d.getAttribute('data-q') } }); });
  });

  // State A: inline founding-list form (posts to /api/waitlist with source "home").
  var f = document.querySelector('[data-home-join]');
  if (!f) return;
  var done = document.querySelector('[data-home-joined]');
  var err = f.querySelector('.hj-error');
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = f.email.value.trim(), box = f.optin.checked, btn = f.querySelector('button');
    err.hidden = true;
    if (!email || !f.email.checkValidity()) { err.textContent = 'Enter a valid email.'; err.hidden = false; f.email.focus(); return; }
    btn.disabled = true;
    var body = { email: email, optin: box, source: 'home' };
    try { var u = JSON.parse(localStorage.getItem('127-utm') || 'null'); if (u) ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (k) { if (u[k]) body[k] = u[k]; }); } catch (x) {}
    fetch('/api/waitlist', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (r) {
        btn.disabled = false;
        if (!r.ok || !r.j.ok) { err.textContent = r.j.error || 'Something went wrong. Try again.'; err.hidden = false; return; }
        if (window.plausible) window.plausible('home_waitlist_submit', { props: { flag: f.getAttribute('data-flag'), box: box } });
        done.querySelector('[data-ref-link]').textContent = r.j.referral_link || '';
        f.hidden = true; done.hidden = false; done.focus();
      })
      .catch(function () { btn.disabled = false; err.textContent = 'Something went wrong. Try again.'; err.hidden = false; });
  });
  var copy = done.querySelector('[data-ref-copy]');
  copy.addEventListener('click', function () {
    var t = done.querySelector('[data-ref-link]').textContent;
    var ok = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy link'; }, 1600); };
    if (navigator.clipboard) navigator.clipboard.writeText(t).then(ok, function () {}); else ok();
  });
})();
</script>

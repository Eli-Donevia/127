<%- include('../partials/app-head') %>
<% var rm = user.roadmap; var firstName = (user.name || '').split(' ')[0]; %>

<% if (q.welcome) { %><div class="alert win">Welcome to 127<%= firstName ? ', ' + firstName : '' %>. Your roadmap is ready, and you've earned your first badge: Blueprint drawn.</div><% } %>
<% if (q.retook) { %><div class="alert info">New roadmap generated from your updated answers.</div><% } %>
<% var demoNote = q.demo && user.demoBilling ? ' (Demo mode: no payment was taken.)' : ''; %>
<% if (foundingAlert) { %><div class="alert win">You're founding member #<%= user.foundingNumber %>. Everything is unlocked, and $<%= launch.foundingPrice %> a month is yours for as long as you stay.<%= launch.foundingCall ? ' The founding call with Eli is ' + launch.foundingCall + '. Your invite comes by email.' : '' %><%= demoNote %></div>
<% } else if (upgraded && user.tier === 'circle') { %><div class="alert win">You're in the Founder's Circle. Eli's team will email your call link and the private group invite today.<%= demoNote %></div>
<% } else if (upgraded) { %><div class="alert win">You're a <%= upgraded %>. Everything is unlocked.<%= demoNote %></div><% } %>
<% if (closedNotice) { %><div class="alert info closed-note" data-fb-closed><span>The founding price has closed. Builder is $<%= builderOffer.regular %> a month whenever you're ready.</span><button type="button" aria-label="Dismiss">×</button></div><% } %>
<% if (!user.emailVerified) { %>
  <div class="alert info verify-bar"><span>Confirm your email to unlock all your Playbook messages. We sent a link to <b style="font-weight:500"><%= user.email %></b>.<% if (devVerifyLink) { %> Email isn't connected yet, so here it is: <a class="link" href="<%= devVerifyLink %>">confirm email</a>.<% } %></span>
  <form method="post" action="/app/verify/resend"><button class="btn ghost sm">Resend link</button></form></div>
<% } %>

<div class="page-head">
  <div>
    <div class="eyebrow"><%= rm.trackName %> track · <%= level.name %></div>
    <h1><%= firstName ? 'Keep building, ' + firstName + '.' : 'Keep building.' %></h1>
  </div>
  <a href="/start?retake=1" class="btn ghost sm">Retake assessment</a>
</div>

<% if (builderOffer.founding) { %><%- include('../partials/founding-bar') %><% } %>
<% if (typeof nudge !== 'undefined' && nudge) { %><%- include('../partials/nudge') %><% } %>
<% if (typeof ffCard !== 'undefined' && ffCard) { %><%- include('../partials/founding-five-card', { c: ffCard, hq: false }) %><% } %>

<div class="grid g-main">
  <div class="grid" style="gap:16px">
    <% if (q.welcome && (user.challengeFinisher || (user.challenge && user.challenge.finished_at))) { %>
    <div class="card finisher-card">
      <div class="eyebrow">Day One · done</div>
      <% if (user.challenge && user.challenge.carried > 0) { %><p>Your week is in. Week 1 of your roadmap is ticked off, and everything you wrote in the challenge is saved.</p>
      <% } else { %><p>Your week is in. You earned the Day One badge, and everything you wrote in the challenge is saved.</p><% } %>
      <a class="btn ghost sm" href="/challenge/me">See what you wrote <span class="arrow"></span></a>
    </div>
    <% } %>
    <% if (next) { %>
    <div class="next-card">
      <div class="eyebrow">Your next step · Week <%= next.week %></div>
      <h2><%= next.title %></h2>
      <p><%= next.detail %><% if (q.welcome) { %><span class="first-visit-line">About 10 minutes. Mark it done and your roadmap moves.</span><% } %></p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <% if (next.resource) { %><a href="/app/library/<%= next.resource %>" class="btn light">Open <%= bySlug[next.resource].type.toLowerCase() %> <span class="arrow"></span></a><% } %>
        <% if (next.action) { %><a href="<%= next.action %>" class="btn light">Go <span class="arrow"></span></a><% } %>
        <% var nextTpl = tplForTask(next.id).filter(function(x){ return tplCanOpen(user, x); })[0]; if (nextTpl && !next.resource) { %><a href="/app/templates/<%= nextTpl.slug %>" class="btn light">Open <%= nextTpl.title %> <span class="arrow"></span></a><% } %>
        <form method="post" action="/app/task/<%= next.id %>"><button class="btn ghost" style="color:var(--on-dark);border-color:var(--dark-line)">Mark done · +<%= next.xp %> XP</button></form>
      </div>
    </div>
    <% } else if (progress.done === progress.total) { %>
    <div class="next-card"><div class="eyebrow">Roadmap complete</div><h2>You built all 30 days.</h2><p>Share it on the wins board, then retake the assessment for your next roadmap.</p><a class="btn light" href="/app/wins">Share your win</a></div>
    <% } else { %>
    <div class="next-card"><div class="eyebrow">Weeks 1 and 2 done</div><h2>Ready for weeks 3 and 4?</h2><p>Builder unlocks the rest of your roadmap, every playbook and every AI tool.<%= builderOffer.founding ? ' Founding price until ' + builderOffer.closesDate + ': $' + builderOffer.price + ' a month, locked while you stay.' : '' %></p><form method="post" action="/app/billing/checkout/builder" data-upgrade="weeks12" data-price="<%= builderOffer.price %>"><button class="btn light"><%= builderOffer.founding ? 'Lock $' + builderOffer.price + ' a month' : 'Become a Builder · $' + builderOffer.regular + '/month' %></button></form><%- include('../partials/renewal-line') %></div>
    <% } %>

    <div class="card pad-lg" id="roadmap">
      <div class="card-title">
        <div>
          <div class="eyebrow">Your 30-day roadmap</div>
          <h3 style="font-family:var(--display);font-weight:700;letter-spacing:-.045em;font-size:28px;margin:6px 0 0"><%= rm.headline %></h3>
        </div>
      </div>
      <% if (user.roadmapNote) { %><p style="color:var(--ink-2);margin:0 0 12px"><%= user.roadmapNote %></p><% } %>
      <p class="small muted" style="margin:0 0 6px">Focus: <%= rm.focus %></p>
      <% if (rm.outcome) { %><p class="small" style="margin:0 0 6px"><span class="muted">Your 12-month win:</span> “<%= rm.outcome %>”</p><% } %>
      <% rm.notes.forEach(function(n){ %><p class="small" style="margin:0 0 6px;color:var(--accent-ink)"><%= n %></p><% }) %>
      <div style="margin:22px 0 28px">
        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:8px"><span><%= progress.done %> of <%= progress.total %> steps</span><span class="muted"><%= progress.pct %>%</span></div>
        <div class="bar accent"><span style="width:<%= progress.pct %>%"></span></div>
      </div>

      <% rm.weeks.forEach(function(w){ var locked = !w.freeVisible && !canAccess(user, 'builder'); var wdone = w.tasks.filter(function(t){return user.completed && user.completed[t.id]}).length; %>
      <div class="week <%= locked ? 'locked-week' : '' %>">
        <div class="week-head"><h4>Week <%= w.week %> · <%= w.theme %></h4><span class="tiny muted"><%= wdone %>/<%= w.tasks.length %></span></div>
        <% w.tasks.forEach(function(t){ var done = user.completed && user.completed[t.id]; var res = t.resource && bySlug[t.resource]; %>
        <div class="task">
          <form method="post" action="/app/task/<%= t.id %>"><button class="tick <%= done ? 'on' : '' %>" aria-label="<%= done ? 'Mark not done' : 'Mark done' %>" <%= locked ? 'disabled' : '' %>></button></form>
          <div style="flex:1">
            <div class="t-title <%= done ? 'done-text' : '' %>"><%= t.title %></div>
            <% if (!done) { %><div class="t-detail"><%= t.detail %></div><% } %>
            <% if (res) { %><div class="t-meta"><a href="/app/library/<%= res.slug %>" class="chip line" style="text-decoration:none"><%= res.type %> · <%= res.title %></a><% if (!canOpen(res)) { %><span class="chip">Builder</span><% } %></div><% } %>
            <% var tpls = tplForTask(t.id); if (tpls.length) { %><div class="t-use"><span class="tiny muted">Use:</span><% tpls.forEach(function(x, i){ %><a href="/app/templates/<%= x.slug %>" class="link small"><%= x.title %></a><% if (!tplCanOpen(user, x)) { %><span class="tpl-lock" title="Builder template">Builder</span><% } %><% }) %></div><% } %>
          </div>
          <span class="xp">+<%= t.xp %> XP</span>
        </div>
        <% }) %>
        <% if (locked && w.week === 3) { %>
        <div class="unlock"><div class="card"><div class="eyebrow">Builder</div><h3 style="font-family:var(--display);font-weight:700;letter-spacing:-.045em;font-size:26px;margin:8px 0">Unlock weeks 3 and 4</h3><p class="small muted" style="margin:0 0 16px">Plus every playbook and AI tool.<%= builderOffer.founding ? ' $' + builderOffer.price + ' a month for founding members until ' + builderOffer.closesDate + '.' : '' %></p><form method="post" action="/app/billing/checkout/builder" data-upgrade="week3" data-price="<%= builderOffer.price %>"><button class="btn block"><%= builderOffer.founding ? 'Lock $' + builderOffer.price + ' a month' : 'Become a Builder · $' + builderOffer.regular + '/month' %></button></form><%- include('../partials/renewal-line') %></div></div>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>

  <div class="grid" style="gap:16px">
    <% if (typeof hqCard !== 'undefined' && hqCard) { var hc = hqCard.change; %>
    <a class="card" href="/app/hq<%= hqCard.logged ? '' : '?w=' + hqCard.week %>" style="display:block;text-decoration:none" data-hq-card>
      <div class="card-title" style="margin-bottom:8px"><div class="eyebrow">HQ · Week of <%= hqCard.weekLabel %></div><span class="small link">Open HQ</span></div>
      <% if (hqCard.logged) { %>
      <div class="small muted"><%= hqCard.label %></div>
      <div class="stat"><div class="v" style="margin:8px 0 10px"><%= hqCard.value %></div></div>
      <% if (hc.text !== '–') { %><span class="chip <%= hc.dir === 'up' ? 'win' : 'line' %>"<%- hc.dir === 'down' ? ' style="color:var(--danger)"' : '' %>><%= hc.text === 'new' ? 'New this week' : hc.text === '0%' ? 'Same as the week before' : hc.text + ' vs the week before' %></span><% } %>
      <% } else { %>
      <h3 style="font-family:var(--display);font-weight:700;letter-spacing:-.04em;font-size:24px;margin:6px 0 6px">Log last week. 2 minutes.</h3>
      <p class="small muted" style="margin:0">Your numbers, where it leaks, and your call for the week.</p>
      <% } %>
    </a>
    <% } %>
    <div class="card">
      <div class="eyebrow">Level <%= level.index %> of <%= level.total %></div>
      <div class="stat"><div class="v"><%= level.name %></div></div>
      <div style="display:flex;justify-content:space-between;font-size:13px;margin:10px 0 8px"><span><%= user.xp || 0 %> XP</span><span class="muted"><%= level.next ? (level.next.min - (user.xp||0)) + ' to ' + level.next.name : 'Top level' %></span></div>
      <div class="bar"><span style="width:<%= level.pct %>%"></span></div>
      <div class="badges">
        <% Object.keys(badges).forEach(function(k){ var on = (user.badges||[]).indexOf(k) > -1; if (badges[k].earnedOnly && !on) return; %>
          <span class="badge <%= on ? 'on' : '' %>" title="<%= badges[k].desc %>"><%= badges[k].label %><%= k === 'founding' && user.foundingNumber ? ' · #' + user.foundingNumber : '' %></span>
        <% }) %>
      </div>
    </div>

    <div class="card" id="progress">
      <div class="card-title"><div><div class="eyebrow">Idea to first revenue</div><h3 style="margin-top:6px">Your progress map</h3></div><span class="tiny muted mono"><%= MILESTONES.filter(function(m){ return m.auto ? !!user.roadmap : (user.milestones||{})[m.id]; }).length %>/<%= MILESTONES.length %></span></div>
      <ol class="pmap">
        <% var nextFound = false; MILESTONES.forEach(function(m){ var on = m.auto ? !!user.roadmap : !!(user.milestones||{})[m.id]; var isNext = !on && !nextFound; if (isNext) nextFound = true; %>
        <li class="<%= on ? 'on' : '' %> <%= isNext ? 'next' : '' %>">
          <% if (m.auto) { %><span class="pm-dot"></span><% } else { %><form method="post" action="/app/milestone/<%= m.id %>"><button class="pm-dot" aria-label="<%= on ? 'Undo' : 'Mark reached' %>: <%= m.label %>"></button></form><% } %>
          <div><div class="pm-label"><%= m.label %><% if (!on && m.xp) { %> <span class="mono tiny muted">+<%= m.xp %></span><% } %></div>
          <% if (isNext) { %><div class="tiny muted"><%= m.hint %><% if (m.resource && bySlug[m.resource]) { %> <a class="link" href="/app/library/<%= m.resource %>"><%= bySlug[m.resource].title %></a><% } %></div><% } %></div>
        </li>
        <% }) %>
      </ol>
    </div>

    <div class="card">
      <div class="card-title"><h3>Recommended for you</h3><a href="/app/library" class="small link">Library</a></div>
      <% recommended.forEach(function(r){ %>
        <a href="/app/library/<%= r.slug %>" style="display:block;text-decoration:none;padding:12px 0;border-top:1px solid var(--line)">
          <div class="tiny muted" style="text-transform:uppercase;letter-spacing:.08em"><%= r.type %> · <%= r.minutes %> min <%= canOpen(r) ? '' : '· Builder' %></div>
          <div style="font-weight:500;margin-top:2px"><%= r.title %></div>
        </a>
      <% }) %>
    </div>

    <div class="card">
      <div class="card-title"><h3>Eli's Playbook</h3><span class="tiny muted"><%= aiLeft %> messages left</span></div>
      <a href="/app/tools/ask" class="btn sm block" style="margin-bottom:8px;justify-content:space-between">Ask a question <span class="arrow"></span></a>
      <a href="/app/tools/offer-validator" class="btn ghost sm block" style="justify-content:space-between">Run the Idea &amp; Offer Validator <span class="arrow"></span></a>
    </div>

    <div class="card">
      <div class="card-title"><h3>Member wins</h3><a href="/app/wins" class="small link">Share yours</a></div>
      <% if (!wins.length) { %><p class="small muted" style="margin:0">No wins posted yet. Be the first to share one.</p><% } %>
      <% wins.forEach(function(w){ %><div class="win-item"><div class="avatar"><%= w.name[0] %></div><div><div class="small" style="font-weight:500"><%= w.name %></div><div class="small" style="color:var(--ink-2)"><%= w.text %></div></div></div><% }) %>
    </div>

    <% if (userPlan.key !== 'circle' && user.answers && (user.answers.circle_interest === 'yes' || user.answers.circle_interest === 'later')) { %>
    <div class="card dark">
      <div class="eyebrow" style="color:var(--gold)">Founder's Circle</div>
      <h3 style="font-family:var(--display);font-weight:700;letter-spacing:-.045em;font-size:26px;margin:8px 0">You said weekly calls would help.</h3>
      <p class="small muted" style="margin:0 0 16px"><%= circleSeatsLeft %> of <%= circleCapacity %> seats open.</p>
      <a href="/app/circle" class="btn light sm">Learn more</a>
    </div>
    <% } %>
  </div>
</div>
<% if (upgradeScreen) { %><%- include('../partials/upgrade-screen') %><% } %>
<%- include('../partials/app-foot') %>

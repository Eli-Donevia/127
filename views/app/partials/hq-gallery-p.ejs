<%# The Connections gallery as a switchboard (HQ_PREMIUM): the apps a member can use now wired to 127, and the
    ones still waiting folded into one line each. Same data, search and filters as hq-gallery.ejs. %>
<%
  var all = [];
  apps.categories.forEach(function (cat) { cat.apps.forEach(function (a) { all.push(a); }); });
  var LIVE = ['connected', 'broken', 'connect'];
  var live = all.filter(function (a) { return LIVE.indexOf(a.status) !== -1; });
  live.sort(function (x, y) { return LIVE.indexOf(x.status) - LIVE.indexOf(y.status); });
  var held = [['legal', 'Waiting on Legal'], ['coming', 'Coming']].map(function (h) { return { id: h[0], label: h[1], apps: all.filter(function (a) { return a.status === h[0]; }) }; }).filter(function (h) { return h.apps.length; });
  // The switchboard: 127 in the middle, the live apps alternating left and right on a shallow arc.
  var m = Math.ceil(live.length / 2), gap = 62, H = Math.max(300, m * gap + 56), cy = H / 2;
  var nodes = live.map(function (a, i) {
    var side = i % 2 ? 1 : -1, k = Math.floor(i / 2), per = side < 0 ? Math.ceil(live.length / 2) : Math.floor(live.length / 2);
    var dk = k - (per - 1) / 2, y = cy + dk * gap, x = 500 + side * (270 + Math.abs(dk) * 34);
    var hx = 500 + side * 48, ex = x - side * 92, mx = (hx + ex) / 2;
    return { a: a, x: x, y: y, side: side, i: i, d: 'M' + hx + ' ' + cy + ' C' + mx + ' ' + cy + ' ' + mx + ' ' + y + ' ' + ex + ' ' + y };
  });
  var on = live.filter(function (a) { return a.status === 'connected'; }).length;
%>
<section class="ap-gallery hqp-sb" id="apps" aria-labelledby="ap-h">
  <div class="ap-top">
    <div>
      <span class="eyebrow">Every app</span>
      <h2 id="ap-h" class="h2" style="margin:6px 0 4px">Your accounts, in one place</h2>
      <p class="ap-count"><b><%= apps.counts.connected %></b> connected · <b><%= apps.counts.ready %></b> ready to connect · <%= apps.counts.total %> in all</p>
    </div>
    <% if (typeof boardsOn !== 'undefined' && boardsOn) { %><a class="hq-btn" href="/app/hq/boards">Build a dashboard</a><% } %>
    <input class="ap-search" type="search" placeholder="Find an app" aria-label="Find an app" data-ap-search>
  </div>

  <% if (nodes.length) { %>
  <figure class="hqp-board">
    <svg viewBox="0 0 1000 <%= H %>" aria-hidden="true" focusable="false">
      <% nodes.forEach(function (n) { var a = n.a; %>
      <a class="hqp-node is-<%= a.status %>" href="<%= a.href || '#apps' %>" style="--i:<%= n.i %>" tabindex="-1">
        <path class="w" d="<%= n.d %>" pathLength="100"/>
        <path class="w-run" d="<%= n.d %>" pathLength="100"/>
        <g transform="translate(<%= n.x - 92 %> <%= n.y - 21 %>)">
          <rect width="184" height="42" rx="21"/>
          <% if (a.icon) { %><svg x="14" y="12" width="18" height="18" viewBox="0 0 24 24"><path class="mk" d="<%= a.icon %>"/></svg><% } else { %><text class="mono" x="23" y="25.5" text-anchor="middle"><%= a.name.replace(/[^A-Za-z0-9]/g, '').slice(0, 2) %></text><% } %>
          <text class="nm" x="42" y="26"><%= a.name.length > 13 ? a.name.slice(0, 12) + '…' : a.name %></text>
          <circle class="st" cx="166" cy="21" r="3.5"/>
        </g>
      </a>
      <% }) %>
      <g class="hqp-hub" transform="translate(500 <%= cy %>)">
        <circle r="46"/>
        <text class="t" y="7" text-anchor="middle">127</text>
      </g>
    </svg>
    <figcaption><%= on ? on + ' live' : 'Nothing connected yet' %> · <%= live.length - on %> ready now<% held.forEach(function (h) { %> · <%= h.apps.length %> <%= h.id === 'legal' ? 'waiting on Legal' : 'coming' %><% }) %></figcaption>
  </figure>
  <% } %>

  <div class="ap-filters" role="group" aria-label="Show">
    <button type="button" class="ap-filter" aria-pressed="true" data-ap-filter="all">All</button>
    <button type="button" class="ap-filter" aria-pressed="false" data-ap-filter="connected">Connected</button>
    <button type="button" class="ap-filter" aria-pressed="false" data-ap-filter="connect">Ready now</button>
  </div>

  <% if (live.length) { %>
  <div class="ap-cat" data-ap-cat>
    <h3>Use now</h3>
    <div class="ap-grid hqp-live">
      <% live.forEach(function (a) { %><%- include('hq-gallery-tile', { a: a, full: true }) %><% }) %>
    </div>
  </div>
  <% } %>

  <% held.forEach(function (h) { %>
  <details class="hqp-held" data-held>
    <summary>
      <span class="k"><%= h.label %></span>
      <b><%= h.apps.length %> app<%= h.apps.length === 1 ? '' : 's' %></b>
      <span class="ico" aria-hidden="true"><% h.apps.slice(0, 12).forEach(function (a) { %><i><% if (a.icon) { %><svg viewBox="0 0 24 24"><path d="<%= a.icon %>"/></svg><% } else { %><%= a.name.charAt(0) %><% } %></i><% }) %></span>
      <span class="names"><%= h.apps.slice(0, 5).map(function (a) { return a.name; }).join(', ') %><%= h.apps.length > 5 ? ' and ' + (h.apps.length - 5) + ' more' : '' %></span>
    </summary>
    <div class="ap-cat" data-ap-cat>
      <div class="ap-grid">
        <% h.apps.forEach(function (a) { %><%- include('hq-gallery-tile', { a: a, full: false }) %><% }) %>
      </div>
    </div>
  </details>
  <% }) %>
  <p class="ap-note">Coming means 127 is finishing its app with that company. Waiting on Legal means our lawyer is adding it to the Privacy Policy first. Anything that changes or sends in your accounts waits for your OK and shows in your activity.</p>
</section>

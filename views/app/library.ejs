<%- include('../partials/app-head') %>
<div class="page-head">
  <div><div class="eyebrow">Playbooks · Templates · Worksheets</div><h1>Library</h1></div>
  <% if (userPlan.key === 'free') { %><form method="post" action="/app/billing/checkout/builder" class="small muted lib-note" data-upgrade="library" data-price="<%= builderOffer.price %>">Free: the starter library and everything weeks 1 and 2 use. <%= builderOffer.founding ? 'Founding price until ' + builderOffer.closesDate + ':' : '' %> <button class="link-btn"><%= builderOffer.founding ? 'Lock $' + builderOffer.price + '/month' : 'Unlock the full library' %></button><%- include('../partials/renewal-line', { rlClass: 'tiny' }) %></form><% } %>
</div>
<%- include('../partials/library-switch', { section: 'playbooks', tplCount: tplCount }) %>
<div class="tabs">
  <a href="/app/library" class="<%= !track ? 'on' : '' %>">All</a>
  <% Object.keys(TRACK_NAMES).forEach(function(k){ %><a href="/app/library?track=<%= k %>" class="<%= track===k ? 'on' : '' %>"><%= TRACK_NAMES[k] %></a><% }) %>
</div>
<div class="res-list">
  <% items.forEach(function(r){ var open = canOpen(r); var via = open && !canAccess(user, r.tier); var done = (user.resourcesDone||{})[r.slug]; %>
  <a href="/app/library/<%= r.slug %>" class="res <%= open ? '' : 'locked' %>">
    <div class="meta"><span><%= TRACK_NAMES[r.track] %> · <%= r.type %></span><% if (done) { %><span class="chip win">Done</span><% } else if (!open) { %><span class="chip">Builder</span><% } else if (via) { %><span class="chip win">In your roadmap</span><% } else if (r.tier==='free') { %><span class="chip line">Free</span><% } %></div>
    <h4><%= r.title %></h4>
    <p><%= r.summary %></p>
    <div class="foot-row"><span><%= r.minutes %> min<%= r.calc ? ' · calculator' : (r.worksheet && r.worksheet.length ? ' · worksheet' : '') %></span><span class="arrow"></span></div>
  </a>
  <% }) %>
</div>
<%- include('../partials/app-foot') %>

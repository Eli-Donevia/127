<%- include('../partials/app-head') %>
<%# Cancel screen (offer.md section 8, O16; Membership Terms section 10 and Appendix C2-C4).
    Screen 1 is a cancel screen: one tap on Cancel cancels, the reason is optional, and no save option
    shows until the member taps "See other options first" (Minnesota). Screen 2 shows the options with
    Cancel beside them at the same size (California). No "are you sure?", no discounts. The Circle's
    optional call with Eli is offered only after the cancellation, on the billing page (C4). %>
<% var circle = userPlan.key === 'circle'; var until = accessEnds || 'the end of the month you paid for';
   var foundingP = launch.foundingPrice || 19; var planName = circle ? 'the Circle' : 'Builder';
   var order = { price: ['pause', 'switch'], unused: ['restart', 'pause'], busy: ['pause'], job: ['pause', 'switch'], done: ['switch'] }[reason] || ['pause', 'switch'];
   order = order.filter(function (o) { return o !== 'pause' || pauseAvailable; });
   if (!order.length) order = ['switch'];
   var q = reason ? '&reason=' + reason : ''; %>
<div class="cancel-page">
  <div class="eyebrow">Membership</div>
  <h1>Cancel <%= planName %></h1>
  <% if (circle) { %>
    <p class="lede">Your seat goes back to the waitlist at the end of this month. You keep the Circle until <%= until %>.</p>
  <% } else { %>
    <p class="lede">You keep Builder until <%= until %>. Then you move to the free plan, with your roadmap's weeks 1 and 2 and your wins.</p>
    <% if (user.foundingPrice) { %><p class="cancel-fact">Cancelling ends your $<%= foundingP %> founding price. If you come back later, Builder is $<%= PLANS.builder.price %>.</p><% } %>
    <% if (!options) { %>
    <div class="cancel-reasons">
      <p class="small" style="margin:0 0 10px">What's the main reason? <span class="muted">Optional.</span></p>
      <div class="reason-chips">
        <% CANCEL_REASONS.forEach(function(r){ %><a class="btn pill <%= reason === r[0] ? 'is-on' : '' %>" href="/app/billing/cancel?reason=<%= r[0] %>" <%= reason === r[0] ? 'aria-current="true"' : '' %>><%= r[1] %></a><% }) %>
        <% if (reason) { %><a class="small link skip-link" href="/app/billing/cancel">Clear</a><% } %>
      </div>
    </div>
    <% } %>
  <% } %>

  <% if (!options) { %>
  <div class="cancel-first">
    <form method="post" action="/app/billing/cancel">
      <input type="hidden" name="intent" value="cancel">
      <input type="hidden" name="reason" value="<%= reason || '' %>">
      <button class="btn light">Cancel <%= planName %></button>
    </form>
    <a class="btn ghost" href="/app/billing/cancel?options=1<%= q %>">See other options first</a>
  </div>
  <% } else { %>
  <% if (!circle && user.foundingPrice && pauseAvailable) { %><p class="cancel-fact">Pausing keeps your $<%= foundingP %> founding price. Cancelling ends it.</p><% } %>
  <div class="cancel-options">
    <% if (circle) { %>
      <form method="post" action="/app/billing/checkout/builder" class="cancel-opt">
        <input type="hidden" name="from" value="/app/billing">
        <h3>Switch to Builder</h3>
        <p>Keeps everything but the calls and gatherings.<%= foundingKept ? ' Your $' + foundingP + ' founding price comes with you.' : '' %> The change happens now, and the unused part of this month becomes a credit.</p>
        <button class="btn ghost block">Switch to Builder</button>
      </form>
    <% } else { order.forEach(function (o) { %>
      <% if (o === 'restart') { %>
      <div class="cancel-opt">
        <h3>Restart my roadmap</h3>
        <p>Life changed? Your roadmap can too. Retake the 3-minute assessment and get a fresh week 1.</p>
        <a class="btn ghost block" href="/start?retake=1">Restart my roadmap</a>
      </div>
      <% } else if (o === 'pause') { %>
      <form method="post" action="/app/billing/pause" class="cancel-opt">
        <input type="hidden" name="reason" value="<%= reason || '' %>">
        <h3>Pause for a month</h3>
        <p><%= reason === 'busy' ? 'Exams or holidays? Pause and come back to the same price. ' : '' %>Your pause starts when your paid month ends on <%= until %>, so you keep every day you paid for. Then no charge for 30 days. Your roadmap, saved work and price stay; Builder tools are locked until you're back. We'll email you before it restarts.</p>
        <button class="btn ghost block">Pause for a month</button>
      </form>
      <% } else { %>
      <form method="post" action="/app/billing/cancel" class="cancel-opt">
        <input type="hidden" name="intent" value="switch_free">
        <input type="hidden" name="reason" value="<%= reason || '' %>">
        <h3>Switch to Free</h3>
        <p>Keep your roadmap, weeks 1 and 2, and your wins. Builder ends at the end of this month<%= accessEnds ? ', on ' + accessEnds : '' %>.</p>
        <button class="btn ghost block">Switch to Free</button>
      </form>
      <% } %>
    <% }) } %>
    <form method="post" action="/app/billing/cancel" class="cancel-opt">
      <input type="hidden" name="intent" value="cancel">
      <input type="hidden" name="reason" value="<%= reason || '' %>">
      <h3>Cancel <%= planName %></h3>
      <p>You keep access until <%= until %>. No more charges.</p>
      <button class="btn ghost block">Cancel <%= planName %></button>
    </form>
  </div>
  <% if (!circle && reason === 'done' && referralLink) { %><p class="small muted">Know someone starting? Your link gives them a head start: <span class="mono" style="overflow-wrap:anywhere"><%= referralLink %></span></p><% } %>
  <% } %>

  <p class="small muted">Cancel online anytime from Billing. No call or email needed.</p>
  <a href="/app/billing" class="small link">← Back to Membership</a>
</div>
<%- include('../partials/app-foot') %>

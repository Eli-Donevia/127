<%- include('../partials/app-head') %>
<div class="page-head"><div><div class="eyebrow">By application · $299/month</div><h1>Founder's Circle</h1></div><span class="small muted"><%= circleSeatsLeft %> of <%= circleCapacity %> seats open</span></div>

<% if (userPlan.key === 'circle') { %>
  <div class="grid g-2">
    <div class="next-card">
      <div class="eyebrow">Weekly call</div>
      <h2><%= callTime %></h2>
      <p>Submit your question before the call so it can be grouped into the agenda.</p>
      <% if (callUrl) { %><a class="btn light" href="<%= callUrl %>" target="_blank" rel="noopener">Join or add to calendar <span class="arrow"></span></a><% } else { %><span class="small" style="color:var(--on-dark-2)">Call link coming soon.</span><% } %>
    </div>
    <div class="card pad-lg">
      <h3>Private group</h3>
      <p class="small muted">Where Circle members share progress between calls.</p>
      <% if (communityUrl) { %><a class="btn" href="<%= communityUrl %>" target="_blank" rel="noopener">Open the group</a><% } else { %><span class="small muted">Invite link coming soon.</span><% } %>
      <hr class="rule" style="margin:24px 0">
      <h3>Format</h3>
      <p class="small muted" style="margin:0">5 min wins · 30 min hot seats · 10 min commitments. Notes and action items follow every call.</p>
    </div>
  </div>
<% } else if (application && application.status === 'approved') { %>
  <div class="next-card">
    <div class="eyebrow">Accepted</div>
    <h2>Your seat is ready.</h2>
    <p>Join to unlock the weekly call, the private group and everything in Builder.</p>
    <form method="post" action="/app/billing/checkout/circle"><button class="btn light">Claim my seat · $299/month</button></form>
  </div>
<% } else if (application) { %>
  <div class="card pad-lg" style="max-width:640px">
    <span class="chip"><%= application.status === 'declined' ? 'Not this round' : 'Application received' %></span>
    <h3 style="font-family:var(--serif);font-weight:700;letter-spacing:-.045em;font-size:30px;margin:14px 0 8px"><%= application.status === 'declined' ? "It's not the right fit yet." : "Thanks. We'll be in touch by email." %></h3>
    <p class="muted" style="margin:0"><%= application.status === 'declined' ? 'Keep working your roadmap as a Builder. You can apply again later.' : 'Applications are reviewed personally. Meanwhile, keep working your roadmap.' %></p>
  </div>
<% } else { %>
  <div class="grid g-main">
    <form method="post" action="/app/circle/apply" class="card pad-lg">
      <h3 style="font-family:var(--serif);font-weight:700;letter-spacing:-.045em;font-size:30px;margin:0 0 6px">Apply for a seat</h3>
      <p class="small muted" style="margin:0 0 24px">Five questions. Honest answers beat polished ones.</p>
      <label class="field"><span>What are you building, and for whom?</span><textarea class="input" name="business" required></textarea></label>
      <label class="field"><span>Where is it today? (revenue, customers, audience)</span><input class="input" name="revenue" required></label>
      <label class="field"><span>What's the biggest thing you need help with right now?</span><textarea class="input" name="challenge" required></textarea></label>
      <label class="field"><span>Can you commit to a weekly 45-minute call and the work between calls?</span><input class="input" name="commitment" required placeholder="Yes / mostly / tell us more"></label>
      <label class="field"><span>Link to your business or profile (optional)</span><input class="input" name="link" type="url" placeholder="https://"></label>
      <button class="btn">Submit application</button>
    </form>
    <div class="card dark pad-lg">
      <div class="eyebrow" style="color:var(--gold)">What you get</div>
      <ul class="check-list" style="margin-top:8px">
        <% PLANS.circle.features.forEach(function(f){ %><li style="border-color:var(--dark-line)"><span class="tick on" style="background:var(--gold);border-color:var(--gold)"></span><%= f %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>
<%- include('../partials/app-foot') %>

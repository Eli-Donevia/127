<%- include('../partials/app-head') %>
<%
  var seatNo = membership && membership.seat ? circle.seatLabel(membership.seat) : null;
  var founding = !!(membership && membership.founding);
  var v = values || {};
%>
<div class="page-head">
  <div><div class="eyebrow">By application · $299/month</div><h1>Founder's Circle</h1></div>
  <% if (isMember && seatNo) { %>
    <div class="circle-marks"><span class="seat-badge">Seat <b><%= seatNo %></b></span><% if (founding) { %><span class="founding-mark">Founding Seat</span><% } %></div>
  <% } else if (former) { %>
    <div class="circle-marks"><span class="alumni-mark">Circle alumni<% if (seatNo) { %> · Seat <%= seatNo %><% } %></span><span class="small muted"><%= circleSeatsLeft %> of <%= circleCapacity %> seats open</span></div>
  <% } else { %>
    <span class="small muted"><%= circleSeatsLeft %> of <%= circleCapacity %> seats open</span>
  <% } %>
</div>

<% if (errors && errors.length) { %>
  <div class="alert error"><% errors.forEach(function(e){ %><div><%= e %></div><% }) %></div>
<% } %>

<% if (isMember) { %>
  <% var sc = scorecard; %>
  <div class="grid g-main">
    <div class="grid">
      <div class="next-card circle-call">
        <div class="eyebrow">Next call</div>
        <h2><%= nextCall || callTime %></h2>
        <p>45 minutes, live, in The Room. Scorecards are due at midnight ET the night before.</p>
        <div class="circle-actions">
          <% if (sc && sc.state !== 'not_open') { %><a class="btn gold" href="/app/circle/scorecard"><%= sc.existing ? 'Edit my Scorecard' : 'Fill in my Scorecard' %> <span class="arrow"></span></a><% } %>
          <% if (callUrl) { %><a class="btn ghost" href="<%= callUrl %>" target="_blank" rel="noopener">Open The Room</a><% } else { %><span class="small" style="color:var(--on-dark-2)">Call link coming soon.</span><% } %>
        </div>
      </div>
      <% if (sc) { %>
        <div class="card pad-lg circle-sc">
          <div class="card-title"><h3>Scorecard · <%= sc.label %></h3><% if (sc.existing) { %><span class="chip gold"><%= sc.existing.late ? 'Sent, late' : 'Sent' %></span><% } %></div>
          <% if (sc.existing) { %>
            <p class="small muted" style="margin:0">Thanks. You can change it until the call starts.</p>
          <% } else if (sc.state === 'not_open') { %>
            <p class="small muted" style="margin:0">Your Scorecard for <%= sc.label %> opens <%= sc.opens %>. 3 minutes on your phone.</p>
          <% } else if (sc.state === 'late') { %>
            <p class="small muted" style="margin:0">It was due at midnight ET. Late Scorecards still save, marked late. <a class="link" href="/app/circle/scorecard">Send it now</a>.</p>
          <% } else { %>
            <p class="small muted" style="margin:0">Your Scorecard for <%= sc.label %> is open. 3 minutes. Due at midnight ET the night before the call.</p>
          <% } %>
        </div>
      <% } %>
    </div>
    <div class="seat-card<%= founding ? ' founding' : '' %>">
      <div class="eyebrow"><%= founding ? 'Founding Seat' : "Founder's Circle" %></div>
      <div class="seat-num"><%= seatNo || '··' %></div>
      <div class="seat-title"><span>Your</span> seat.</div>
      <p><%= founding ? 'One of the first four. Yours for good.' : 'Four seats. One room.' %></p>
      <% if (firstCall) { %><div class="tiny seat-foot">Your first call: <%= firstCall %></div><% } %>
    </div>
  </div>

  <div class="card pad-lg circle-profile" id="profile">
    <div class="card-title"><div><h3>Founder Profile</h3><p class="small muted" style="margin:0">10 minutes. It feeds the prep brief, the recap and Eli's notes.</p></div><a class="link small" href="<%= handbookPath %>#your-build-target-and-north-number">How to pick them</a></div>
    <div class="grid g-2 profile-key">
      <div class="profile-tile"><div class="eyebrow">Build Target · 13 weeks</div><div class="pv"><%= profile.buildTarget || 'Not set yet' %></div></div>
      <div class="profile-tile"><div class="eyebrow">North Number</div><div class="pv"><% if (profile.northLabel) { %><%= profile.northLabel %>: <span class="mono gold-num"><%= profile.northToday || '–' %></span><% } else { %>Not set yet<% } %></div></div>
    </div>
    <details <%= profileMissing.length ? 'open' : '' %>>
      <summary class="small"><%= profileMissing.length ? 'Fill in your profile' : 'Edit your profile' %></summary>
      <form method="post" action="/app/circle/profile" class="profile-form">
        <% circle.PROFILE_FIELDS.forEach(function(f){ var val = profile[f.id] || ''; %>
          <label class="field"><span><%= f.label %><% if (!f.required) { %> (optional)<% } %></span>
            <% if (f.options) { %>
              <select class="input" name="<%= f.id %>" <%= f.required ? 'required' : '' %>>
                <% if (f.required) { %><option value="">Choose one</option><% } %>
                <% Object.keys(f.options).forEach(function(k){ %><option value="<%= k %>" <%= val === k ? 'selected' : '' %>><%= f.options[k] %></option><% }) %>
              </select>
            <% } else if (f.id === 'buildTarget') { %>
              <textarea class="input" name="<%= f.id %>" maxlength="<%= f.max %>" required placeholder="A number by a date: 10 paying customers by Feb 18"><%= val %></textarea>
            <% } else { %>
              <input class="input" name="<%= f.id %>" value="<%= val %>" maxlength="<%= f.max %>" <%= f.required ? 'required' : '' %> placeholder="<%= f.id === 'northLabel' ? 'Paying customers to date' : f.id === 'northToday' ? '3' : '' %>">
            <% } %>
          </label>
        <% }) %>
        <button class="btn">Save my profile</button>
      </form>
    </details>
  </div>

  <div class="grid g-2">
    <div class="card pad-lg">
      <h3>Call notes</h3>
      <% if (!recaps.length) { %><p class="small muted" style="margin:0">The recap lands here and in your inbox the morning after each call.</p><% } %>
      <% recaps.forEach(function(r, i){ var mine = (r.members && r.members[user.id] && r.members[user.id].commitments) || []; %>
        <details class="recap" <%= i === 0 ? 'open' : '' %>>
          <summary class="small">Recap · <%= circle.fmtShort(circle.ms(r.callAt)) %></summary>
          <% if (mine.length) { %><p class="small" style="margin:10px 0 0"><b style="font-weight:600">Your commitments:</b> <%= mine.join('; ') %></p><% } %>
          <div class="recap-text"><%= r.post %></div>
        </details>
      <% }) %>
    </div>
    <div class="card pad-lg">
      <h3>Private group</h3>
      <p class="small muted">The Circle's Discord: wins, questions for each other, and every recap in #call-notes.</p>
      <% if (communityUrl) { %><a class="btn" href="<%= communityUrl %>" target="_blank" rel="noopener">Open the group</a><% } else { %><span class="small muted">Invite link coming soon.</span><% } %>
      <hr class="rule" style="margin:24px 0">
      <h3>Format</h3>
      <p class="small muted" style="margin:0">45 minutes: 2 min open · 8 min Scorecards · two 13-minute hot seats · 5 min rapid round · 4 min commitments. A recap with everyone's commitments follows every call.</p>
      <p class="small" style="margin:14px 0 0"><a class="link" href="<%= handbookPath %>">Read the handbook</a></p>
    </div>
  </div>

<% } else if (state === 'offered') { %>
  <div class="next-card circle-call" style="max-width:720px">
    <div class="eyebrow">Approved</div>
    <h2>Seat <%= circle.seatLabel(offer.seat) %> is yours to claim.</h2>
    <p>It's held for you until <%= offer.until %>. After that it goes to the next person in line.</p>
    <div class="circle-actions">
      <form method="post" action="/app/billing/checkout/circle"><input type="hidden" name="from" value="/app/circle"><button class="btn gold">Claim my seat · $<%= PLANS.circle.price %>/month</button></form>
      <a class="btn ghost" href="<%= handbookPath %>">Read the handbook</a>
    </div>
    <%- include('../partials/renewal-line', { rlPrice: PLANS.circle.price, rlFree: false }) %>
  </div>

<% } else if (state === 'waiting') { %>
  <div class="card pad-lg circle-state">
    <span class="chip gold">Approved</span>
    <h3 class="circle-h">You're approved. The table is full right now.</h3>
    <p class="muted">You're number <%= position %> in line. When a seat opens, you'll get it first, with 72 hours to claim it. Your approval stands until <%= approvalUntil %>.</p>
    <a class="link small" href="<%= handbookPath %>">Read the handbook while you wait</a>
  </div>

<% } else if (state === 'passed') { %>
  <div class="card pad-lg circle-state">
    <span class="chip gold">Approved</span>
    <h3 class="circle-h">Your claim window ended.</h3>
    <p class="muted">No problem, timing matters. You're still approved until <%= approvalUntil %>. When you're ready, you go back in line in your original place.</p>
    <form method="post" action="/app/circle/ready"><button class="btn">I'm ready: put me back in line</button></form>
  </div>

<% } else if (state === 'pending') { %>
  <div class="card pad-lg circle-state">
    <span class="chip">Application received</span>
    <h3 class="circle-h">Got it. Eli reads every application himself.</h3>
    <p class="muted">You'll hear back within 2 weekdays. While you wait, keep going on your roadmap: it's the same work the Circle builds on.</p>
  </div>

<% } else if (state === 'fit_call') { %>
  <div class="card pad-lg circle-state">
    <span class="chip">Fit call</span>
    <h3 class="circle-h">10 minutes with Eli?</h3>
    <p class="muted">Before deciding, Eli would like 10 minutes on video. It's a conversation, not a pitch.</p>
    <% if (application.fitCall && application.fitCall.url) { %><a class="btn" href="<%= application.fitCall.url %>" target="_blank" rel="noopener">Pick a time <span class="arrow"></span></a><% } %>
  </div>

<% } else if (state === 'declined') { %>
  <div class="card pad-lg circle-state">
    <span class="chip line">Application</span>
    <h3 class="circle-h">The Circle isn't the right fit for what you're looking for.</h3>
    <p class="muted">Thanks for applying. Your roadmap, the library and the AI tools are all still here for what you're building.</p>
  </div>

<% } else { %>
  <% if (state === 'not_yet') { %>
    <div class="card pad-lg circle-state" style="margin-bottom:16px">
      <span class="chip line">Not yet</span>
      <% if (application.notYet) { %>
        <h3 class="circle-h">Not yet, and here's why.</h3>
        <p class="muted"><%= application.notYet.reason %></p>
        <p class="small" style="margin:0"><b style="font-weight:600">What would change the answer:</b> <%= application.notYet.change %></p>
      <% } else { %>
        <h3 class="circle-h">It's not the right fit yet.</h3>
        <p class="muted" style="margin:0">Keep working your roadmap. You can apply again whenever you're ready.</p>
      <% } %>
      <p class="small muted" style="margin:12px 0 0">When that's true, apply again below. Your answers carry over.</p>
    </div>
  <% } else if (state === 'lapsed') { %>
    <div class="alert info">Your approval was more than 6 months ago, so it has expired. Apply again below; your answers carry over.</div>
  <% } %>

  <% if (returning) { %>
    <div class="card pad-lg circle-state circle-return" style="margin-bottom:16px">
      <span class="alumni-mark">Circle alumni<% if (seatNo) { %> · Seat <%= seatNo %><% } %></span>
      <h3 class="circle-h">Welcome back.</h3>
      <p class="muted">You left in good standing, so you can take a seat again without applying, until <%= circle.fmtDate(circle.addMonths(circle.ms(membership.leftAt), circle.RETURN_MONTHS)) %>. If someone approved is already waiting, they go first.</p>
      <form method="post" action="/app/circle/rejoin"><button class="btn gold">Take a seat again</button></form>
    </div>
  <% } else if (canApply) { %>
    <div class="grid g-main">
      <form method="post" action="/app/circle/apply" class="card pad-lg circle-apply">
        <h3 class="circle-h" style="margin-top:0">Apply for a seat.</h3>
        <p class="small muted" style="margin:0 0 24px">Six questions. Honest answers beat polished ones. Eli reads every one.</p>
        <label class="field"><span>1. What are you building, and for whom?</span><textarea class="input" name="business" required maxlength="1500"><%= v.business || '' %></textarea></label>
        <label class="field"><span>2. Where is it today? <em class="muted">Revenue, customers, or customer conversations so far. Small numbers are fine.</em></span><textarea class="input" name="revenue" required maxlength="1500"><%= v.revenue || '' %></textarea></label>
        <label class="field"><span>3. What's the biggest thing you need help with in the next 90 days?</span><textarea class="input" name="challenge" required maxlength="1500"><%= v.challenge || '' %></textarea></label>
        <label class="field"><span>4. If the Circle works, what will be true 13 weeks from now? <em class="muted">One result you can measure.</em></span><textarea class="input" name="result13" required maxlength="1500" placeholder="10 paying customers"><%= v.result13 || '' %></textarea></label>
        <fieldset class="field circle-choice">
          <legend>5. The call is live every Thursday at 8pm ET for 45 minutes, plus 2-3 hours of work between calls. Can you do that most weeks?</legend>
          <div class="seg">
            <% Object.keys(circle.TIME_ANSWERS).forEach(function(k){ %><label><input type="radio" name="time" value="<%= k %>" required <%= v.time === k ? 'checked' : '' %>><span><%= circle.TIME_ANSWERS[k] %></span></label><% }) %>
          </div>
          <input class="input time-note" name="timeNote" maxlength="500" value="<%= v.timeNote || '' %>" placeholder="Tell us more (optional unless you picked it)">
        </fieldset>
        <label class="field"><span>6. Link to your business or profile (optional)</span><input class="input" name="link" type="url" placeholder="https://" value="<%= v.link || '' %>"></label>
        <label class="check" style="margin:6px 0 22px"><input type="checkbox" name="agree" required><span>I've read <a class="link" href="<%= handbookPath %>" target="_blank" rel="noopener">how the Circle works</a> and I'm 18 or older.</span></label>
        <button class="btn">Send my application</button>
      </form>
      <div class="card dark pad-lg">
        <div class="eyebrow" style="color:var(--gold)">What you get</div>
        <ul class="check-list" style="margin-top:8px">
          <% PLANS.circle.features.forEach(function(f){ %><li style="border-color:var(--dark-line)"><span class="tick on" style="background:var(--gold);border-color:var(--gold)"></span><%= f %></li><% }) %>
        </ul>
        <p class="small muted" style="margin:18px 0 0"><a class="link" href="<%= handbookPath %>">How the Circle works</a></p>
      </div>
    </div>
  <% } %>
<% } %>
<%- include('../partials/app-foot') %>

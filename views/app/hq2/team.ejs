<%- include('../../partials/app-head') %>
<%# HQ v2 AI team (lib/harness/team.js): AI employees hired in one tap. Each card says "AI employee", what it does today, its plan, connections and budget (Legal L76 R1, L83 R3 and R4). Locals: mine, gallery. %>
<div class="hq h2">
  <%- include('../../partials/hq2-nav') %>
  <div class="hq-head" style="margin-bottom:8px">
    <div>
      <span class="eyebrow">AI team</span>
      <h1 class="hq-title"><span class="dim">Hire your first</span><span class="steel">AI employee.</span></h1>
      <p class="hq-lede">Each one has a job, the skills it runs, a monthly credit budget and a weekly report. It follows your house rules, and everything it drafts waits for your OK. You send every message yourself.</p>
    </div>
  </div>
  <% if (mine.length) { %>
  <h2 class="h2-h" style="font-size:18px;margin:8px 0 12px">Your team</h2>
  <div class="h2-stack">
    <% mine.forEach(function (t) { %>
    <a class="hq-card h2-hit" href="/app/hq/team/<%= t.id %>">
      <span class="h2-row"><span class="h2-h" style="font-size:17px"><%= t.name %></span><span class="h2-tag"><%= t.status === 'paused' ? 'Paused' : 'Working' %></span></span>
      <span class="hq-small" style="margin:0">AI employee · <%= t.plan %></span>
      <span class="h2-sub" style="margin:0"><%= t.job %></span>
      <span class="hq-small" style="margin:0">Uses: <%= t.uses.length ? t.uses.join(', ') + ' (reads only)' : 'nothing connected' %> · Budget: <%= t.budget %> credits a month</span>
      <span class="h2-hit-t"><%= t.report.done %> done this week<%= t.report.waiting ? ', ' + t.report.waiting + ' waiting on you' : '' %> · <%= t.report.spentMonth %> of <%= t.budget %> credits this month</span>
    </a>
    <% }) %>
  </div>
  <% } %>
  <h2 class="h2-h" style="font-size:18px;margin:24px 0 12px">AI employees you can hire</h2>
  <div class="h2-stack<%= typeof ws !== 'undefined' && ws && ws.premium ? ' hqp-team' : '' %>">
    <% gallery.forEach(function (r) { %>
    <section class="hq-card" aria-labelledby="role-<%= r.id %>">
      <% if (typeof ws !== 'undefined' && ws && ws.premium) { %><span class="hqp-orbit" aria-hidden="true"><b><%= (r.first || r.title).charAt(0) %></b><i></i></span><% } %>
      <h3 class="h2-h" id="role-<%= r.id %>" style="font-size:17px"><%= r.name %></h3>
      <p class="hq-small" style="margin:2px 0 6px">AI employee · <%= r.plan %></p>
      <p class="h2-sub"><%= r.job %></p>
      <p class="hq-small">Uses: <%= r.uses.length ? r.uses.join(', ') + ' (reads only)' : 'nothing connected' %> · Budget: <%= r.budget %> credits a month</p>
      <p class="hq-small"><%= r.can %> workflow<%= r.can === 1 ? '' : 's' %><%= r.skills.length ? ' · runs ' + r.skills.join(', ') : '' %> · always asks you before: <%= (r.needsOk || []).join('; ').toLowerCase() %></p>
      <% if (r.ready) { %>
      <form method="post" action="/app/hq/team/hire/<%= r.id %>" class="h2-row" style="margin-top:12px;justify-content:flex-start;align-items:flex-end">
        <label class="field" style="margin:0;width:160px"><span>Credits a month</span><input class="input" name="budget" type="number" inputmode="numeric" min="10" max="5000" value="<%= r.budget %>"></label>
        <button class="btn">Hire <%= r.first || 'them' %> <span class="arrow"></span></button>
      </form>
      <% } else { %><p class="h2-empty">Not on your plan yet.</p><% } %>
    </section>
    <% }) %>
  </div>
</div>
<script src="/js/hq2.js" defer></script>
<%- include('../../partials/app-foot') %>

<%- include('../../partials/app-head') %>
<%# HQ v2 Briefs (lib/harness/briefs.js, content/briefs). Locals: kinds. %>
<div class="hq h2">
  <%- include('../../partials/hq2-nav') %>
  <div class="hq-head" style="margin-bottom:8px">
    <div>
      <span class="eyebrow">Briefs</span>
      <h1 class="hq-title"><span class="dim">Fewer rounds.</span><span class="steel">Right the first time.</span></h1>
      <p class="hq-lede">Answer a few questions and tap a few chips. You get one brief that tells any AI the look, the motion, what to avoid and how to check its own work before it shows you.</p>
    </div>
  </div>
  <section class="hq-card">
    <ul class="h2-list">
      <% kinds.forEach(function (k, i) { %>
      <li style="padding:12px 0;<%= i ? 'border-top:1px solid var(--line)' : '' %>">
        <div class="h2-row"><a class="link" href="/app/hq/briefs/<%= k.id %>"><%= k.title %></a><% if (k.locked) { %><span class="h2-tag">Builder</span><% } %></div>
        <div class="hq-small" style="margin:2px 0 0"><%= k.when %></div>
      </li>
      <% }) %>
    </ul>
  </section>
  <p class="hq-small">Got something that's close but not right? Use Ask for changes and send every change at once.</p>
</div>
<script src="/js/hq2.js" defer></script>
<%- include('../../partials/app-foot') %>

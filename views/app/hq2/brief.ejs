<%- include('../../partials/app-head') %>
<%# One brief: a guided form (sections, text and chips) that code turns into one build-ready brief. Locals: k, B (lib/harness/briefs), locked, answers, out, build, agentOn. %>
<div class="hq h2">
  <%- include('../../partials/hq2-nav') %>
  <p class="hq-small" style="margin:0 0 8px"><a href="/app/hq/scripts">AI scripts</a> · <a href="/app/hq/briefs">Briefs</a></p>
  <section class="hq-card">
    <h1 class="h2-h"><%= k.title %></h1>
    <p class="h2-sub"><%= k.when %></p>
    <p class="hq-small">Fill in what you know. Blank answers use the default shown, and anything marked needed comes back as a question. Chips already on are the lessons most first drafts miss.</p>
  </section>
  <% if (locked) { %>
  <section class="hq-card" style="margin-top:16px"><p class="h2-sub" style="margin:0">This brief is part of Builder.</p><a class="btn" style="margin-top:12px" href="/app/billing">See Builder <span class="arrow"></span></a></section>
  <% } else { %>
  <% if (out) { %>
  <section class="hq-card blk-copy" style="margin-top:16px" aria-labelledby="brief-h">
    <div class="h2-row"><h2 class="h2-h" id="brief-h" style="font-size:18px">Your brief</h2><button type="button" class="hq-pill" data-copy>Copy</button></div>
    <p class="hq-small br-ready" style="margin:10px 14px 0"><% if (out.ready) { %>Ready to build.<% } else { %>Still needed: <%= out.missing.join(', ') %>. The AI will ask for these.<% } %><% if (out.helps.length) { %> Would help: <%= out.helps.join(', ') %>.<% } %></p>
    <pre class="h2-doc" style="margin-top:12px"><%= out.text %></pre>
  </section>
  <% if (build) { %><a class="btn" style="margin-top:16px" href="<%= build %>">Build it with Site in a night <span class="arrow"></span></a><% } %>
  <p class="hq-small">Paste it into any AI with your files attached<%= agentOn ? ', or send it to Ask 127 below' : '' %>. Change an answer and tap Make my brief again to update it.</p>
  <% } %>
  <form method="post" action="/app/hq/briefs/<%= k.id %>" class="h2-stack" style="margin-top:16px">
    <% k.sections.forEach(function (s) { %>
    <fieldset class="hq-card br-sec">
      <legend class="h2-h" style="font-size:16px"><%= s.title %></legend>
      <% s.fields.forEach(function (f) { var v = answers[f.key]; %>
      <% if (f.chips) { var on = v === undefined ? B.preset(f) : (v.length || f.chips === 'avoid' ? v : B.preset(f)); %>
      <div class="field" role="group" aria-label="<%= f.label %>">
        <span><%= f.label %><%= f.one ? ' (pick one)' : '' %></span>
        <div class="br-chips">
          <% B.options(f).forEach(function (o) { %><label title="<%= o.says %>"><input type="<%= f.one ? 'radio' : 'checkbox' %>" name="v_<%= f.key %>" value="<%= o.id %>"<%= on.indexOf(o.id) > -1 ? ' checked' : '' %>><span><%= o.label %></span></label><% }) %>
        </div>
      </div>
      <% } else { %>
      <label class="field">
        <span><%= f.label %><%= f.need ? '' : ' (optional)' %></span>
        <% if (f.long) { %><textarea class="input" name="v_<%= f.key %>" rows="3" maxlength="4000" placeholder="<%= f.example || '' %>"><%= v || '' %></textarea>
        <% } else { %><input class="input" name="v_<%= f.key %>" maxlength="4000" placeholder="<%= f.example || '' %>" value="<%= v || '' %>"><% } %>
        <% if (f.default && typeof f.default === 'string') { %><small class="hq-small">If blank: <%= f.default %></small><% } %>
      </label>
      <% } %>
      <% }) %>
    </fieldset>
    <% }) %>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" name="make" value="1">Make my brief <span class="arrow"></span></button>
      <% if (agentOn) { %><button class="hq-pill" name="ask" value="1">Send to Ask 127</button><% } %>
    </div>
  </form>
  <% } %>
</div>
<script src="/js/hq2.js" defer></script>
<%- include('../../partials/app-foot') %>

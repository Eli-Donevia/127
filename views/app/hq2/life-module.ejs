<%- include('../../partials/app-head') %>
<%# One Life module (lib/life, HQ_LIFE). The page is drawn by public/js/life/<id>.js over what the member keeps in
    their own browser (public/js/life/kit.js); 127 receives none of it. A held module that Legal hasn't cleared shows
    the waiting card and no script; admins see it as a preview. %>
<div class="hq h2 lf">
  <%- include('../../partials/hq2-nav') %>
  <header class="lf-head">
    <a class="lf-back" href="/app/hq/life">Life</a>
    <h1 class="hq-title lf-title"><%= mod.title %></h1>
    <p class="hq-lede"><%= mod.line %></p>
  </header>
  <% if (!open) { %>
  <div class="lf-wait">
    <p class="lf-wait-q">On the way.</p>
    <p>We're finishing the privacy side of <%= mod.title.toLowerCase() %> before it opens. Until then, the prompt below builds a private version in your own Claude.</p>
  </div>
  <% } else { %>
  <% if (preview) { %><div class="lf-note">Preview for admins. Members see this once Legal clears it (LIFE_CLEARED=<%= mod.id %>).</div><% } %>
  <% if (!plan) { %><div class="lf-note">This comes with Builder. Below is an example you can play with; nothing is kept. <a class="link" href="/app/billing">See Builder</a></div><% } %>
  <div class="lf-app" id="life" data-mod="<%= mod.id %>">
    <noscript><p class="h2-sub">This needs JavaScript turned on.</p></noscript>
  </div>
  <% if (plan) { %>
  <footer class="lf-bar">
    <span class="lf-saved" id="life-saved" role="status" aria-live="polite">Kept on this device only</span>
    <button type="button" class="lf-act" data-life="export">Export</button>
    <label class="lf-act lf-file">Import<input type="file" accept="application/json,.json" data-life="import"></label>
    <button type="button" class="lf-act" data-life="erase">Delete from this device</button>
  </footer>
  <% } %>
  <% } %>
  <% if (bring.length) { %>
  <section class="lf-bring" aria-labelledby="bring-h">
    <h2 class="lf-h" id="bring-h">Bring your own</h2>
    <p class="lf-sub">Apps you run on your own account. 127 links to them and holds nothing.</p>
    <div class="lf-bring-list">
      <% bring.forEach(function (b) { %>
      <a class="lf-app-card" href="<%= b.url %>" target="_blank" rel="noopener noreferrer">
        <span class="lf-app-n"><%= b.name %></span>
        <span class="lf-app-l"><%= b.line %></span>
        <span class="lf-app-m"><span><%= b.license %></span><span><%= b.cost %></span></span>
      </a>
      <% }) %>
    </div>
  </section>
  <% } %>
  <% if (prompt) { %>
  <section class="lf-prompt" aria-labelledby="prompt-h">
    <h2 class="lf-h" id="prompt-h">Build a bigger one in your own Claude</h2>
    <p class="lf-sub">Paste this into Claude. It builds a version shaped around you, kept in your own account.</p>
    <pre class="lf-prompt-t" id="life-prompt"><%= prompt %></pre>
    <button type="button" class="lf-act" data-copy="life-prompt">Copy prompt</button>
  </section>
  <% } %>
  <% if (open && (mod.id === 'train' || mod.id === 'food' || mod.id === 'body')) { %>
  <p class="lf-foot">General wellness ideas, not medical advice. Check with a doctor before you change how you eat or train, especially with an injury or a health condition.</p>
  <% } %>
  <% if (others.length) { %>
  <nav class="lf-more" aria-label="Other Life modules">
    <% others.forEach(function (o) { %><a href="/app/hq/life/<%= o.id %>"><%= o.title %></a><% }) %>
  </nav>
  <% } %>
</div>
<% if (open) { %>
<script type="application/json" id="life-state"><%- JSON.stringify(state).replace(/</g, '\\u003c') %></script>
<script src="/js/life/kit.js" defer></script>
<script src="/js/life/<%= mod.id %>.js" defer></script>
<% } else { %>
<script src="/js/life/kit.js" defer></script>
<% } %>
<script src="/js/hq2.js" defer></script>
<%- include('../../partials/app-foot') %>

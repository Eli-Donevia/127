<%- include('../../partials/app-head') %>
<%# HQ v2 Start: the member's business first as one numbered path, then every tool grouped by the job it does (their bottleneck first; each job is one row to swipe on a phone, its best row with "Show all" on a wider screen), then the other business types folded (harness.start). %>
<div class="hq h2">
  <%- include('../../partials/hq2-nav') %>
  <div class="hq-head" style="margin-bottom:8px">
    <div>
      <span class="eyebrow">Start</span>
      <h1 class="hq-title"><span class="dim">Pick a job.</span><span class="steel">127 does it.</span></h1>
      <p class="hq-lede">Each one runs in the background and stops for your OK before anything goes out. <% if (mine) { %>Your business comes first, then your bottleneck right now: <b><%= bottleneck.title.toLowerCase() %></b>.<% } else { %>Your bottleneck right now is <b><%= bottleneck.title.toLowerCase() %></b>, so those come first.<% } %></p>
    </div>
  </div>
  <% if (ws && ws.premium) { var inRail = ws.groups.reduce(function (a, g) { return a.concat(g.items.map(function (i) { return i.id; })); }, []); var KEYS = [['workflows', 'workflows', '/app/hq/start'], ['prompts', 'prompts', '/app/hq/prompts'], ['store', 'templates', '/app/hq/store'], ['connections', 'apps', '/app/hq/connect#apps']].filter(function (k) { return inRail.indexOf(k[0]) !== -1; }); %>
  <figure class="hqp-map" data-map>
    <canvas aria-hidden="true"></canvas>
    <p class="hqp-map-tip" data-map-tip aria-hidden="true"></p>
    <figcaption>
      <span class="hqp-map-k">Map of everything</span>
      <% KEYS.forEach(function (k) { %><a href="<%= k[2] %>" data-k="<%= k[0] %>"><i></i><b><%= ws.shelf[k[0]] || 0 %></b> <%= k[1] %></a><% }) %>
      <span class="hqp-map-brain"><i></i>your Brain in the middle</span>
    </figcaption>
  </figure>
  <% } %>
  <input class="h2-search" type="search" id="wf-search" placeholder="Search workflows" aria-label="Search workflows" value="<%= q %>">
  <% if (mine) { %>
  <section class="h2-group" id="mine" aria-labelledby="g-mine">
    <div class="h2-row"><div><span class="eyebrow">Your business</span><h2 class="h2-h" id="g-mine"><%= mine.title %></h2><p class="h2-sub" style="margin-top:2px"><%= mine.summary %><% if (types.length) { %> <a class="link" href="#types">Not yours? Pick another.</a><% } %></p></div><span class="h2-tag<%= mine.done ? ' win' : '' %>"><%= mine.done ? mine.done + ' of ' + mine.items.length + ' done' : mine.items.length + (mine.items.length === 1 ? ' step' : ' steps') %></span></div>
    <%- include('../../partials/hq2-path', { items: mine.items, next: mine.next }) %>
  </section>
  <% } %>
  <% if (pickFirst) { %><%- include('../../partials/hq2-types', { types: types, heading: 'Pick a business', blurb: 'Each one is a path of steps 127 does with you, from your first 25 and your offer to answering replies and delivering the work. Open one to see its steps, then make it yours.' }) %><% } %>
  <% var order = groups.slice().sort(function (a, b) { return (b.id === bottleneck.job) - (a.id === bottleneck.job); }); %>
  <% order.forEach(function (g) { %>
  <section class="h2-group" id="<%= g.id %>" aria-labelledby="g-<%= g.id %>">
    <div class="h2-row"><div><h2 class="h2-h" id="g-<%= g.id %>"><%= g.title %><% if (g.id === bottleneck.job) { %> <span class="h2-tag dfy" style="vertical-align:middle">Your bottleneck</span><% } %></h2><p class="h2-sub" style="margin-top:2px"><%= g.blurb %></p></div><% if (g.items.length > 1) { %><span class="h2-swipe" aria-hidden="true"><%= g.items.length %> &rarr;</span><% } %></div>
    <div class="h2-cards three rail"><% g.items.forEach(function (w) { %><%- include('../../partials/hq2-card', { w: w, fitJob: bottleneck.job }) %><% }) %></div>
    <% if (g.items.length > 3) { %><button type="button" class="h2-showall">Show all <%= g.items.length %></button><% } %>
  </section>
  <% }) %>
  <% if (!pickFirst && types.length) { %><%- include('../../partials/hq2-types', { types: types, heading: mine ? 'Start a different business' : 'Start a business', blurb: 'Each one is a path of steps 127 does with you, from your first 25 and your offer to answering replies and delivering the work. Open one to see its steps.' }) %><% } %>
  <p class="h2-empty" id="wf-none" hidden>Nothing matches. Try fewer words, or tell 127 what you want done above.</p>
</div>
<script src="/js/hq2.js" defer></script>
<%- include('../../partials/app-foot') %>

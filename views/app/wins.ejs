<%- include('../partials/app-head') %>
<%# Wins board (ops/members/site-changes/SPEC.md section 3 and R19). Live posts, plus the viewer's own held
    posts marked "waiting for a check". Report on every post that isn't yours; replies and cheers behind WIN_REPLIES=1. %>
<div class="page-head"><div><div class="eyebrow">Community</div><h1>Wins</h1></div></div>
<div class="grid g-main">
  <div class="card pad-lg">
    <% if (!wins.length) { %><p class="muted" style="margin:0">Nothing here yet. Wins can be small: a first interview, a published page, a first sale.</p><% } %>
    <% wins.forEach(function(w){ var mine = w.userId === user.id; var waiting = w.status === 'held' || w.status === 'reported'; var replies = winReplies ? visibleReplies(user, w) : []; %>
      <div class="win-item" id="win-<%= w.id %>">
        <div class="avatar"><%= (w.name || '?')[0] %></div>
        <div style="flex:1;min-width:0">
          <div class="small"><b style="font-weight:500"><%= w.name %></b> <span class="muted">· <%= PLANS[w.tier] ? PLANS[w.tier].name : '' %> · <%= new Date(w.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></span><% if (waiting) { %> <span class="chip">Waiting for a check</span><% } %></div>
          <div style="color:var(--ink-2);overflow-wrap:anywhere"><%= w.text %></div>
          <% if (winReplies && !waiting) { %>
            <div class="win-actions tiny">
              <% if (!mine) { %><form method="post" action="/app/wins/<%= w.id %>/cheer" style="display:inline"><button class="link tiny" style="background:none;border:0;padding:0;cursor:pointer"><%= (w.cheers || []).includes(user.id) ? 'Cheered' : 'Cheer' %></button></form><% } %>
              <% if ((w.cheers || []).length) { %><span class="muted"> · <%= w.cheers.length %> cheer<%= w.cheers.length === 1 ? '' : 's' %></span><% } %>
            </div>
            <% replies.forEach(function(r){ %>
              <div class="win-reply small"><b style="font-weight:500"><%= r.name %></b><% if (r.status === 'held') { %> <span class="chip">Waiting for a check</span><% } %> <span style="color:var(--ink-2);overflow-wrap:anywhere"><%= r.text %></span></div>
            <% }) %>
            <% if (canPost) { %>
            <form method="post" action="/app/wins/<%= w.id %>/reply" class="win-reply-form">
              <label class="sr-only" for="reply-<%= w.id %>">Reply to <%= w.name %></label>
              <input class="input" id="reply-<%= w.id %>" name="text" maxlength="500" placeholder="Reply" required>
              <button class="btn ghost sm">Reply</button>
            </form>
            <% } %>
          <% } %>
          <% if (!mine && !waiting) { %>
          <details class="win-report tiny">
            <summary class="muted">Report</summary>
            <form method="post" action="/app/wins/<%= w.id %>/report">
              <% REPORT_REASONS.forEach(function(r, i){ %><label class="check tiny"><input type="radio" name="reason" value="<%= r[0] %>" <%= i === 0 ? 'required' : '' %>> <%= r[1] %></label><% }) %>
              <button class="btn ghost sm" style="margin-top:6px">Send report</button>
            </form>
          </details>
          <% } %>
        </div>
        <% if (mine || isAdmin) { %><form method="post" action="/app/wins/<%= w.id %>/delete"><button class="tiny muted" style="background:none;border:0;cursor:pointer">Remove</button></form><% } %>
      </div>
    <% }) %>
  </div>
  <div class="card">
    <h3>Share a win</h3>
    <% if (canPost) { %>
    <p class="small muted">Progress, a lesson, or this week's commitment. First names only. +15 XP.</p>
    <form method="post" action="/app/wins">
      <textarea class="input" name="text" maxlength="500" placeholder="I booked my first three customer interviews." required></textarea>
      <button class="btn block" style="margin-top:12px">Post</button>
    </form>
    <% } else { %>
    <p class="small muted"><%= pausedNote %></p>
    <% } %>
    <p class="tiny muted" style="margin-top:14px">Keep it kind and real. Posts that break that are removed. <a class="link" href="/guidelines">Community guidelines</a></p>
  </div>
</div>
<%- include('../partials/app-foot') %>

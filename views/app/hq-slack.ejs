<%- include('../partials/app-head') %>
<%# HQ in Slack (lib/harness/slack.js): add 127's app, link the member's Slack account with a one-time code
    (Legal L93 SL1), OK cards on or off, remove. %>
<% var inWs = typeof ws !== 'undefined' && ws; %>
<div class="hq<%= inWs ? ' h2' : '' %>">
<% if (inWs) { %><%- include('../partials/hq2-nav') %><% } %>
  <a class="hq-back" href="/app/hq/connect"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>Connections</a>
  <header class="pc-top">
    <h1 class="pc-h1">Slack</h1>
    <p class="pc-sum"><%= s.added ? (s.linked ? 'Linked to ' + s.team + '.' : 'Added to ' + s.team + '. One step left.') : 'OK cards and your morning pulse, in a direct message from HQ.' %></p>
  </header>

  <ol class="sl-steps">
    <li class="<%= s.added ? 'done' : 'now' %>">
      <h2 class="pc-h2">Add HQ to your Slack</h2>
      <% if (!s.added) { %>
        <p class="pc-mute">HQ asks to send you messages and to answer <code>/127</code>. It doesn't read your channels or messages.</p>
        <form method="post" action="/app/hq/slack/install"><button class="pc-go"<%= s.ready ? '' : ' disabled' %>>Add to Slack</button></form>
        <% if (!s.ready) { %><p class="pc-mute">Not set up on this server yet.</p><% } %>
      <% } else { %><p class="pc-mute">Added to <%= s.team %>.</p><% } %>
    </li>
    <li class="<%= s.linked ? 'done' : s.added ? 'now' : '' %>">
      <h2 class="pc-h2">Link your Slack account</h2>
      <% if (s.linked) { %><p class="pc-mute">Linked. Only you can OK a card, and cards only go to your direct messages.</p>
      <% } else if (s.added) { %>
        <% if (code) { %>
          <p>In Slack, type this. It works once, for 10 minutes.</p>
          <p class="sl-code"><code>/127 link <%= code %></code></p>
        <% } else { %>
          <form method="post" action="/app/hq/slack/code"><button class="pc-go">Get a link code</button></form>
        <% } %>
      <% } %>
    </li>
  </ol>

  <% if (s.added) { %>
  <section class="sl-set">
    <form method="post" action="/app/hq/slack/cards" class="sl-cards">
      <label class="pc-check"><input type="checkbox" name="cards"<%= s.cards ? ' checked' : '' %>><span>Send me OK cards in Slack</span></label>
      <button class="pc-quiet">Save</button>
    </form>
    <p class="pc-mute">Money, deletes, publishing and ad budgets are always OK'd here in HQ. The morning pulse in Slack is in <a class="pc-link" href="/app/hq/you#out">You</a>.</p>
    <form method="post" action="/app/hq/slack/disconnect" data-confirm="Remove HQ from Slack? HQ deletes what it kept for it."><button class="pc-quiet danger">Remove from Slack</button></form>
  </section>
  <% } %>
</div>
<script src="/js/hq.js" defer></script>
<% if (inWs) { %><script src="/js/hq2.js" defer></script><% } %>
<%- include('../partials/app-foot') %>

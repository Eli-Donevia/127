<%- include('../partials/app-head') %>
<div class="page-head"><div><div class="eyebrow">Account</div><h1>Settings</h1></div></div>
<% if (saved) { %><div class="alert win">Saved.</div><% } %>
<div class="grid g-2">
  <form method="post" action="/app/settings" class="card pad-lg">
    <h3>Profile</h3>
    <label class="field" style="margin-top:18px"><span>First name</span><input class="input" name="name" value="<%= user.name || '' %>"></label>
    <label class="field"><span>Email</span><input class="input" value="<%= user.email %>" disabled></label>
    <label class="check" style="margin-bottom:20px"><input type="checkbox" name="optin" <%= user.marketingOptIn ? 'checked' : '' %>> Founder emails and the weekly digest</label>
    <button class="btn">Save</button>
  </form>
  <% if (winAiOn) { %>
  <%# Legal L99 WA5: on unless the member turns it off. Off means nothing from their posts goes to AI. %>
  <form method="post" action="/app/wins/ai-replies" class="card pad-lg">
    <input type="hidden" name="from" value="settings"><input type="hidden" name="on" value="<%= user.winAiReplies === false ? '1' : '0' %>">
    <h3>AI replies to my wins posts</h3>
    <p class="small muted">If nobody replies to your win in about 12 hours, Eli's Playbook (AI) may write one short reply, labeled as AI. It reads only that post. <%= user.winAiReplies === false ? 'Off.' : 'On.' %></p>
    <button class="btn ghost sm"><%= user.winAiReplies === false ? 'Turn on' : 'Turn off' %></button>
  </form>
  <% } %>
  <div class="card pad-lg">
    <h3>Help</h3>
    <p class="small muted">A question about your account, billing, a refund or anything else? A person answers within one business day.</p>
    <a href="/app/help" class="btn ghost sm">Get help</a>
    <hr class="rule" style="margin:28px 0">
    <h3>Your assessment</h3>
    <p class="small muted">Your roadmap is built from your answers. Retake it when your stage or goal changes.</p>
    <a href="/start?retake=1" class="btn ghost sm">Retake assessment</a>
    <hr class="rule" style="margin:28px 0">
    <h3>Delete account</h3>
    <p class="small muted">Permanently deletes your account, answers, progress and posts.<%= userPlan.key !== 'free' || pauseInfo ? ' Deleting ends your paid membership right away, without a refund for the rest of the month' + (user.foundingPrice ? ', and ends your founding price' : '') + '.' : '' %></p>
    <% if (userPlan.key !== 'free' && !user.cancelAt) { %>
      <form method="post" action="/app/billing/cancel" class="delete-instead">
        <input type="hidden" name="intent" value="cancel">
        <button class="btn sm">Cancel instead and keep access until <%= fmtDate(user.periodEnd) || 'the end of the month you paid for' %></button>
      </form>
    <% } else if (userPlan.key !== 'free' && user.cancelAt) { %>
      <p class="small muted">Your plan is cancelled and access runs until <%= fmtDate(user.cancelAt) %>. To use that time, delete your account after then.</p>
    <% } %>
    <form method="post" action="/app/settings/delete" onsubmit="return confirm('Delete your account and all data? This cannot be undone.')"><button class="btn ghost sm" style="color:#8a3a2a;border-color:#e7c6bf">Delete my account</button></form>
  </div>
</div>
<%- include('../partials/app-foot') %>

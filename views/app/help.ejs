<%- include('../partials/app-head') %>
<%# Help form (ops/members/site-changes/SPEC.md sections 3 and 7). Creates a ticket for Eli's outbox and emails a receipt. %>
<div class="page-head"><div><div class="eyebrow">Account</div><h1>Help</h1></div></div>
<div class="grid g-main">
  <div class="card pad-lg">
    <% if (done) { %>
      <h3>Thanks. We've got it.</h3>
      <p><%= done.receipt %></p>
      <% if (done.crisis) { %><div class="alert info" role="status"><%= done.crisis %></div><% } %>
      <p class="small muted">A copy is in your inbox. To add something, just reply to that email.</p>
      <a class="btn ghost sm" href="/app">Back to the dashboard</a>
    <% } else { %>
      <% if (errors && errors.length) { %><div class="alert error"><%= errors.join(' ') %></div><% } %>
      <form method="post" action="/app/help">
        <label class="field"><span>What is it about?</span>
          <select class="input" name="category" required>
            <option value="">Choose one</option>
            <% HELP_CATEGORIES.forEach(function(c){ %><option value="<%= c[0] %>" <%= values.category === c[0] ? 'selected' : '' %>><%= c[1] %></option><% }) %>
          </select>
        </label>
        <label class="field"><span>Subject</span><input class="input" name="subject" maxlength="140" required value="<%= values.subject || '' %>"></label>
        <label class="field"><span>Message</span><textarea class="input" name="message" maxlength="2000" rows="7" required><%= values.message || '' %></textarea></label>
        <button class="btn">Send</button>
      </form>
    <% } %>
  </div>
  <div class="card">
    <h3>Quick answers</h3>
    <p class="small muted">Cancel any time from <a class="link" href="/app/billing">Membership</a> with one tap. No call or email needed.</p>
    <p class="small muted">Or email <a class="link" href="mailto:hello@127group.io">hello@127group.io</a>.</p>
  </div>
</div>
<%- include('../partials/app-foot') %>

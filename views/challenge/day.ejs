<%- include('../partials/head') %>
<%
  var split = function (h) { var i = h.indexOf('. '); return i > 0 ? [h.slice(0, i + 1), h.slice(i + 2)] : ['', h]; };
  var hl = split(d.headline);
  var fields = d.checkin.fields.filter(function (f) { return f.id !== 'show_idea' && f.id !== 'show_offer'; });
  // The card's line toggle follows content: Day 1 shows the idea, Day 4 and the finisher card the offer.
  var cardToggle = d.card && d.card.show ? { label: d.card.show === 'show_idea' ? 'Add my idea to my card' : 'Add my offer to my card' } : null;
  var finisher = me && me.finished;
  var unfinished = me ? me.days.filter(function (r) { return !r.done && r.unlocked; }) : [];
%>
<main class="chp">
  <%- include('partials/top') %>

  <% if (preview) { %><div class="wrap"><div class="alert info">Preview for admins: this is Day <%= n %> as it looks once it unlocks. Check-ins are off in preview.</div></div><% } %>

  <% if (state === 'locked') { %>
  <section class="ch-hero">
    <div class="wrap">
      <div class="lbl">Day <%= n %> of 5</div>
      <h1><span class="dim">Unlocks</span> <span class="grad"><%= chx.etWeekday(chx.startAt + (n - 1) * 864e5) %> at <%= chx.etClock(chx.startAt + (n - 1) * 864e5) %> ET.</span></h1>
      <p class="lede"><b><%= d.move %>.</b> <%= d.date %>.</p>
      <%- include('../partials/countdown', { cdTarget: chx.startAt + (n - 1) * 864e5 }) %>
      <% if (unfinished.length) { %><div class="ch-block"><span class="lbl">Catching up?</span><div class="ch-catchup">
        <% me.days.forEach(function (r) { if (!r.unlocked) return; %><a class="btn <%= r.done ? 'ghost' : 'light' %> sm" href="/challenge/day/<%= r.n %>"><%= r.done ? '✓ ' : '' %>Day <%= r.n %><% if (!r.done) { %> <span class="arrow"></span><% } %></a><% }) %>
      </div></div><% } %>
    </div>
  </section>

  <% } else if (state === 'done' || state === 'closed') { %>
  <section class="ch-done-hero" id="done">
    <div class="wrap">
      <% if (state === 'closed') { %>
        <div class="lbl">Day <%= n %> of 5 · <%= d.move %></div>
        <h1><span class="dim">Check-ins are</span> <span class="grad">closed.</span></h1>
        <p class="lede">You finished <b><%= me.daysDone %> of 5</b>. Doors open <%= chx.etLong(chx.launchAt) %> at <%= chx.etClock(chx.launchAt) %> ET<%= finisher ? ', and at ' + chx.etClock(chx.earlyAt) + ' for you' : '' %>. Your week carries over.</p>
      <% } else if (n === 5 && finisher) { %>
        <img class="badge" src="/challenge-assets/img/day-one-badge.svg" alt="Day One badge" width="120" height="120" style="width:120px;height:120px;margin-bottom:6px">
        <h1><span class="grad"><%= d.after.title %></span></h1>
        <div class="ch-intro"><% d.after.lines.forEach(function (l) { %><p><%- md(l) %></p><% }) %></div>
      <% } else if (n === 5 && d.after_partial) { %>
        <div class="ch-tick" aria-hidden="true">✓</div>
        <h1><span class="grad"><%= d.after_partial.title %></span></h1>
        <div class="ch-intro"><% d.after_partial.lines.forEach(function (l) { %><p><%- md(l.replace('{{days_done}}', me.daysDone)) %></p><% }) %></div>
        <div class="ch-catchup"><% unfinished.forEach(function (r) { %><a class="btn light sm" href="/challenge/day/<%= r.n %>">Day <%= r.n %>: <%= r.move %> <span class="arrow"></span></a><% }) %></div>
      <% } else { %>
        <div class="ch-tick" aria-hidden="true">✓</div>
        <h1><span class="grad"><%= d.after.title %></span></h1>
        <div class="ch-intro"><% d.after.lines.forEach(function (l) { %><p><%- md(l) %></p><% }) %></div>
      <% } %>
    </div>
  </section>

  <% if (card && me.days[n - 1].done) { %>
  <section class="ch-block">
    <div class="wrap">
      <div class="ch-share" data-card data-day="<%= card.day %>" data-first-name="<%= card.firstName %>" data-line="" data-line-option="<%= card.lineOption %>" data-done="<%= card.done %>" data-today="<%= card.today %>">
        <div data-card-preview aria-label="Your share card"></div>
        <div>
          <span class="lbl">Your card</span>
          <h2 style="margin-top:10px"><span class="dim">Post it.</span> <span class="grad">Saying it makes it real.</span></h2>
          <% if (cardToggle && card.lineOption) { %><label class="ch-check"><input type="checkbox" data-card-line-toggle> <%= cardToggle.label %></label><% } %>
          <div class="btns"><button type="button" class="btn light" data-card-share>Share my card <span class="arrow"></span></button><button type="button" class="btn ghost" data-card-save>Save image</button></div>
          <% if (count) { %><p class="ch-count" style="margin-top:22px"><b><%= count %></b> founders checked in on Day <%= n %>.</p><% } %>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <% if (state === 'done' && next) { %>
  <section class="ch-block">
    <div class="wrap">
      <div class="ch-next">
        <div><span class="lbl"><%= next.unlocked ? 'Day ' + next.n + ' is open' : 'Tomorrow at ' + chx.etClock(next.at) %></span><h3><%= next.unlocked ? next.move : (next.teaser ? next.teaser.charAt(0).toUpperCase() + next.teaser.slice(1) : next.move) %></h3></div>
        <% if (next.unlocked) { %><a class="btn light" href="/challenge/day/<%= next.n %>">Start Day <%= next.n %> <span class="arrow"></span></a><% } else { %><%- include('../partials/countdown', { cdTarget: next.at }) %><% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (me && me.days[n - 1].done) { %>
  <section class="ch-block">
    <div class="wrap">
      <span class="lbl">Your check-in</span>
      <dl class="answers">
        <% fields.forEach(function (f) { var v = values[f.id]; if (v === undefined || v === '' || v === null) return; if (f.options) { var o = f.options.filter(function (x) { return x.value === v; })[0]; if (o) v = o.label; } %>
        <div><dt><%= f.label %></dt><dd><%= v %></dd></div>
        <% }) %>
        <% if (d.checkin.feature) { %><div><dt>Feature my check-in</dt><dd><%= values.feature_ok ? 'Yes' + (values.feature_idea ? ' · idea' : '') + (values.feature_offer ? ' · offer' : '') : 'No' %><%= values.guest_ok ? ' · Up for joining as a guest' : '' %></dd></div><% } %>
      </dl>
      <% if (state === 'done') { %><p style="margin-top:16px"><a href="/challenge/day/<%= n %>?edit=1#checkin">Edit my answers</a></p><% } %>
    </div>
  </section>
  <% } %>
  <% } %>

  <% if (state === 'open') { %>
  <section class="ch-hero">
    <div class="wrap">
      <div class="lbl"><%= d.label %></div>
      <h1><% if (hl[0]) { %><span class="dim"><%= hl[0] %></span> <% } %><span class="grad"><%= hl[1] %></span></h1>
      <p class="ch-line"><%= d.line %></p>
      <div class="ch-line-by">Eli · <%= d.date %></div>
      <% if (video) { %>
        <% if (video.inline) { %><div class="ch-video"><video src="<%= video.src %>" controls playsinline preload="metadata"<% if (video.poster) { %> poster="<%= video.poster %>"<% } %>><% if (video.captions) { %><track kind="captions" src="<%= video.captions %>" srclang="en" label="English" default><% } %></video></div>
        <% } else { %><div class="ch-video-link"><a class="btn ghost" href="<%= video.src %>" target="_blank" rel="noopener">Watch Eli's Day <%= n %> video <span class="arrow"></span></a></div><% } %>
      <% } %>
    </div>
  </section>

  <section class="ch-block">
    <div class="wrap ch-intro">
      <% d.intro.forEach(function (l) { %><p><%- md(l) %></p><% }) %>
      <% if (d.intro_small) { %><p class="small-print"><%- md(d.intro_small) %></p><% } %>
    </div>
  </section>

  <section class="ch-block">
    <div class="wrap">
      <span class="lbl">The move · <%= d.move_time %></span>
      <ol class="steps">
        <% d.steps.forEach(function (s) { %><li><div><b><%- md(s.title) %></b> <%- md(s.body) %></div><% if (s.sub && s.sub.length) { %><ul><% s.sub.forEach(function (x) { %><li><%- md(x) %></li><% }) %></ul><% } %></li><% }) %>
      </ol>
      <% if (d.after_steps && d.after_steps.length) { %><div class="ch-prose" style="margin-top:20px"><%- include('partials/blocks', { blocks: d.after_steps }) %></div><% } %>
    </div>
  </section>

  <section class="ch-block">
    <div class="wrap">
      <div class="ch-tool ch-prose">
        <span class="lbl">The tool</span>
        <h3 style="margin-top:8px"><%= d.tool.title %></h3>
        <%- include('partials/blocks', { blocks: d.tool.blocks }) %>
      </div>
    </div>
  </section>

  <section class="ch-block ch-example">
    <div class="wrap ch-prose">
      <span class="lbl"><%= d.example.title %></span>
      <%- include('partials/blocks', { blocks: d.example.blocks }) %>
    </div>
  </section>

  <section class="ch-block">
    <div class="wrap">
      <span class="lbl">If you're stuck</span>
      <div class="ch-stuck"><% d.stuck.forEach(function (s) { %><details><summary>“<%= s.q %>”</summary><p><%- md(s.a) %></p><% if (s.a_first25 && first25Real) { %><p><%- md(s.a_first25) %></p><% } %></details><% }) %></div>
    </div>
  </section>

  <section class="wrap">
    <form class="ch-checkin" id="checkin" method="post" action="/challenge/day/<%= n %>" data-checkin novalidate>
      <span class="lbl">Check in</span>
      <h2><span class="dim">Done?</span> <span class="grad">Check in.</span></h2>
      <p style="margin:0 0 22px">One or two lines. You can edit them until Sunday, November 15 at 11:59pm ET.</p>
      <% if (Object.keys(errors).length) { %><div class="alert error" role="alert">A couple of answers need a look.</div><% } %>
      <% fields.forEach(function (f) { var v = values[f.id]; var err = errors[f.id]; var opt = !f.required && !f.required_if; var id = 'f_' + f.id; %>
        <div class="ch-field" <% if (f.required_if) { %>data-required-if="<%= f.required_if.field %>=<%= f.required_if.equals %>"<% } %>>
          <% if (f.type === 'choice') { %>
            <div class="flabel" id="<%= id %>"><%= f.label %></div>
            <div class="choices" role="radiogroup" aria-labelledby="<%= id %>"><% f.options.forEach(function (o) { %><label><input type="radio" name="<%= f.id %>" value="<%= o.value %>" <%= v === o.value ? 'checked' : '' %> <%= f.required ? 'required' : '' %>><span><%= o.label %></span></label><% }) %></div>
          <% } else { %>
            <label for="<%= id %>"><%= f.label %><% if (opt) { %> <span class="opt">(optional)</span><% } %></label>
            <% if (f.type === 'textarea') { %><textarea class="input" id="<%= id %>" name="<%= f.id %>" maxlength="500" rows="3" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>><%= v || '' %></textarea>
            <% } else if (f.type === 'select') { %><select class="input" id="<%= id %>" name="<%= f.id %>"><option value="">Choose one</option><% f.options.forEach(function (o) { %><option value="<%= o.value %>" <%= v === o.value ? 'selected' : '' %>><%= o.label %></option><% }) %></select>
            <% } else if (f.type === 'number') { %><input class="input" id="<%= id %>" type="number" inputmode="numeric" name="<%= f.id %>" min="<%= f.min != null ? f.min : 0 %>" max="<%= f.max != null ? f.max : '' %>" step="1" value="<%= v != null ? v : '' %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>>
            <% } else { %><input class="input" id="<%= id %>" type="text" name="<%= f.id %>" maxlength="500" value="<%= v || '' %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>><% } %>
          <% } %>
          <% if (f.help) { %><div class="help"><%= f.help %></div><% } %>
          <% if (err) { %><div class="err" role="alert"><%= err %></div><% } %>
        </div>
      <% }) %>
      <% if (d.checkin.feature) { %>
        <div class="ch-feature">
          <label class="ch-check"><input type="checkbox" name="feature_ok" value="on" <%= values.feature_ok ? 'checked' : '' %> data-feature-ok> <span><%- md(feature.feature_ok) %></span></label>
          <div class="sub">
            <label class="ch-check"><input type="checkbox" name="feature_idea" value="on" <%= values.feature_idea ? 'checked' : '' %>> <%= feature.feature_idea %></label>
            <label class="ch-check"><input type="checkbox" name="feature_offer" value="on" <%= values.feature_offer ? 'checked' : '' %>> <%= feature.feature_offer %></label>
          </div>
          <label class="ch-check"><input type="checkbox" name="guest_ok" value="on" <%= values.guest_ok ? 'checked' : '' %>> <span><%- md(feature.guest_ok) %></span></label>
          <p class="small-print" style="margin:6px 0 0"><%- md(feature.small) %></p>
        </div>
      <% } %>
      <div class="ch-submit">
        <button class="btn light big" <%= preview ? 'disabled' : '' %>><%= d.checkin.button %> <span class="arrow"></span></button>
        <% if (me && me.days[n - 1].done) { %><a href="/challenge/day/<%= n %>" class="small">Cancel</a><% } %>
      </div>
    </form>
  </section>
  <% } %>
</main>
<script>window.C127CardLabels = <%- JSON.stringify(cardLabels).replace(/</g, '\\u003c') %>;</script>
<script src="/challenge-assets/card.js" defer></script>
<%- include('partials/page-script') %>
<%- include('../partials/foot') %>

<%
  // Day One Challenge landing (/challenge): phases 'open' and 'live'. Copy: conversion/challenge/landing-page.md §1.
  var C = (typeof ch !== 'undefined' && ch) || {};
  var live = C.phase === 'live';
  var consent = C.consent || {};
  var cBox = consent.box || "Also send me launch news, founding-price reminders, and Eli's founder emails and weekly digest.";
  var cLine = consent.line || "You'll get the challenge: one email a day from November 9 to 13, reminders for the two lives, your wrap-up and, if you finish, your early-access link. Unsubscribe anytime.";
  var cVersion = consent.version || 'challenge-off-v1';
  var F = C.form || {};
  var optin = F.optin === true || F.optin === 'on' || F.optin === 'true';
  var me = C.me && C.me.firstName ? C.me : null;
  var pNum = parseFloat(C.foundingPrice);
  var price = C.foundingPrice !== null && C.foundingPrice !== undefined && C.foundingPrice !== '' && isFinite(pNum) ? pNum : null;
  var dayLive = null;
  if (live) {
    dayLive = parseInt(C.dayLive, 10);
    if (!(dayLive >= 1 && dayLive <= 5)) dayLive = C.startAt ? Math.min(5, Math.max(1, Math.floor(((C.now || Date.now()) - C.startAt) / 864e5) + 1)) : null;
  }
  var btnLabel = live ? 'Join and catch up' : 'Join the free challenge';
  var showCd = !live && !!C.startAt && C.startAt > Date.now();

  var days = [
    { iso: '2026-11-09', date: 'Mon 9 Nov', move: 'Pick one.', what: "Score your ideas on Eli's 5 questions and choose.", have: "One idea and the problem in your customer's words" },
    { iso: '2026-11-10', date: 'Tue 10 Nov', move: 'Find 10 people.', what: 'Real names who have the problem.', have: 'A list of 10 and 3 messages sent' },
    { iso: '2026-11-11', date: 'Wed 11 Nov', move: 'Have the conversation.', what: 'Ask how they solve it today.', have: 'Their exact words, which beat any idea you had' },
    { iso: '2026-11-12', date: 'Thu 12 Nov', move: 'Write the offer.', what: 'One line. Their words. A price.', have: 'An offer you could say yes to' },
    { iso: '2026-11-13', date: 'Fri 13 Nov', move: 'Ask for a yes.', what: 'Three asks. Count every answer.', have: 'Real answers, and your Day One posted' }
  ];
  var finisherTerms = "Everyone who checks in all five days by Sunday, November 15 at 11:59pm ET gets the finisher perks: doors open for you at 9am ET on Tuesday, November 17, an hour before everyone else; a Day One badge in your account; and your week's work carried into your roadmap. There's no drawing, judging or prize, and nothing is awarded by chance. The founding price is the same for everyone, and early access doesn't hold one of the 100 founding spots for you.";
  var faqs = [
    ['Is it really free?', 'Yes. No card, nothing to cancel.'],
    ['Do I need an idea?', "No. Day 1 starts from problems you've noticed. You'll leave Monday with one."],
    ['How much time does it take?', "About 20 minutes a day. Day 3 needs one conversation, which you'll book on Day 2."],
    ['What if I miss a day?', 'Catch up. Every day stays open until Sunday, November 15 at 11:59pm ET.'],
    ['Do I need Instagram?', 'No. Everything comes by email and on your day page. The lives are on Instagram, with replays.'],
    ["I've already launched. Is it too basic?", 'Run it on your next offer or a new customer group. The five moves work at any stage.'],
    ['What happens after Friday?', 'On Tuesday, November 17, 127 opens. Your week carries into a free 30-day roadmap. Builder, the paid plan, is optional.'],
    ['What do finishers get?', finisherTerms],
    ['Is this financial advice?', "No. 127 teaches how to start and grow a business. It doesn't give financial, legal or tax advice."],
    ['How old do I need to be?', '18 or older, the same as any 127 account.'],
    ['Is this a contest?', "No. There's no drawing, judging or prize. Everyone who checks in all five days by Sunday, November 15 at 11:59pm ET gets the finisher perks, and the founding price is the same for everyone."]
  ];
  var wall = [
    ['eli-stage-full', 'morning-coffee', 'eli-popup-02', 'still-timer', 'eli-headphones', 'desk-overhead'],
    ['eli-award-night', 'desk-flatlay', 'eli-stockroom-square', 'eli-plane', 'still-watch', 'eli-popup-01'],
    ['eli-stage-portrait', 'hotel-desk', 'eli-gym-portrait', 'bible-open', 'eli-hotel-corner', 'eli-headphones']
  ];
  var reel = ['eli-popup-01', 'desk-overhead', 'eli-stage-full', 'still-timer', 'eli-stockroom-square', 'morning-coffee', 'eli-award-night', 'eli-plane', 'eli-popup-02', 'desk-flatlay', 'eli-headphones', 'eli-hotel-corner'];
  // One word per span so the headline can stagger in.
  function words(text, start) {
    return text.split(' ').map(function (w, i) { return '<span style="--i:' + (start + i) + '">' + w.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</span>'; }).join(' ');
  }
%>
<% // The join form (hero and final CTA). Order is Legal's: fields, box, small line, then the age line directly above the button.
function joinForm(id, withError) { %>
<form method="post" action="/challenge" class="chl-form" id="<%= id %>" data-ch-form>
  <input type="hidden" name="cv" value="<%= cVersion %>">
  <input type="hidden" name="ref" value="<%= C.ref || '' %>">
  <input type="hidden" name="from" value="<%= C.from || '' %>">
  <div class="chl-hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
  <div class="chl-fields">
    <label class="chl-field"><span class="chl-sr">First name</span><input class="input" type="text" name="first_name" placeholder="First name" autocomplete="given-name" required maxlength="60" value="<%= F.first_name || '' %>"></label>
    <label class="chl-field"><span class="chl-sr">Email</span><input class="input" type="email" name="email" placeholder="Email" autocomplete="email" required maxlength="200" value="<%= F.email || '' %>"></label>
  </div>
  <label class="chl-box"><input type="checkbox" name="optin" value="on"<%= optin ? ' checked' : '' %>><span><%= cBox %></span></label>
  <p class="chl-small"><%= cLine %></p>
  <% if (withError && F.error) { %><p class="alert error chl-error" role="alert"><%= F.error %></p><% } %>
  <p class="chl-small chl-age">By joining, you confirm you're 18 or older and agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
  <button type="submit" class="btn light big"><%= btnLabel %> <span class="arrow"></span></button>
</form>
<% } %>
<%- include('../partials/head') %>
<main class="v4 chl" data-phase="<%= live ? 'live' : 'open' %>">

  <!-- HERO: drifting wall of Eli's photos under a heavy scrim; the form is the brightest thing on screen -->
  <section class="hx chl-hero" aria-labelledby="chl-h1">
    <div class="hx-wall" aria-hidden="true">
      <% wall.forEach(function (col, ci) { %>
      <div class="hx-col c<%= ci %>"><div class="hx-track">
        <% col.concat(col).forEach(function (n) { %><img src="/img/wall/<%= n %>.jpg" alt="" width="480" height="600"<%- ci ? ' loading="lazy"' : '' %>><% }) %>
      </div></div>
      <% }) %>
    </div>
    <div class="wrap chl-hero-grid">
      <div class="chl-hero-copy">
        <% if (me) { %><p class="chl-me">You're in, <%= me.firstName %>. <a href="/challenge/me">Open your challenge page</a></p><% } %>
        <p class="chl-label">Free 5-day challenge · Nov 9 to 13</p>
        <h1 class="kin chl-stagger" id="chl-h1"><span class="dim"><%- words('Make this week', 0) %></span><br><span><%- words('day one.', 3) %></span></h1>
        <p class="hx-value">Five days. One move a day, about 20 minutes. By Friday you'll have an idea picked on purpose, real conversations with people who have the problem, and an offer you've put in front of someone.</p>
      </div>

      <div class="chl-hero-join">
        <div class="chl-card chl-glow"><% joinForm('join', true) %></div>
      </div>

      <% if (live || showCd) { %>
      <div class="chl-hero-when">
        <% if (live) { %>
        <div class="chl-now">
          <p class="chl-now-k"><span class="chl-dot" aria-hidden="true"></span><span><%= dayLive ? 'Day ' + dayLive + ' is live' : 'Live now' %></span></p>
          <p class="chl-now-t">Join now and catch up. Every day stays open until Sunday night.</p>
        </div>
        <% } else if (showCd) { %>
        <p class="chl-cd-k" id="chl-cd-k">Starts in</p>
        <%- include('../partials/countdown', { cdTarget: C.startAt }) %>
        <% } %>
      </div>
      <% } %>

      <p class="chl-meta"><span>Free</span><span>No card</span><span>Live with Eli on Instagram, Mon Nov 9 and Mon Nov 16 at 8pm ET</span></p>
    </div>

    <div class="ticker chl-ticker" aria-hidden="true">
      <div class="ticker-track"><% days.concat(days).forEach(function (d, i) { %><span><b>Day 0<%= (i % 5) + 1 %></b><%= d.move %></span><% }) %></div>
    </div>
  </section>

  <!-- THE HOOK: lines light up as they pass the middle of the screen -->
  <section class="pain chl-hook">
    <div class="wrap">
      <p class="lit">You've had the idea for months.</p>
      <p class="lit">You've told three friends about it.</p>
      <p class="lit">You've watched someone else launch it.</p>
      <p class="lit">You haven't asked one customer.</p>
      <p class="lit punch">Five days fixes that.<br><span>Not a course. Five moves, done for real.</span></p>
    </div>
  </section>

  <!-- THE WEEK: a rail of five days (a row on desktop, a timeline on phones) -->
  <section class="chl-week" aria-labelledby="chl-week-h">
    <div class="wrap">
      <div class="chl-head" data-reveal>
        <p class="eyebrow">The week</p>
        <h2 class="chl-h2" id="chl-week-h"><span class="chl-dim">One move a day.</span><br><span class="chl-steel">Each one ends with proof.</span></h2>
      </div>
      <ol class="chl-days">
        <% days.forEach(function (d, i) {
             var n = i + 1;
             var st = !live || !dayLive ? '' : n < dayLive ? 'unlocked' : n === dayLive ? 'live' : 'upcoming'; %>
        <li class="chl-day<%= st ? ' is-' + st : '' %>" data-reveal>
          <span class="chl-node" aria-hidden="true"></span>
          <div class="chl-day-when">
            <time class="chl-date" datetime="<%= d.iso %>"><%= d.date %></time>
            <% if (st === 'live') { %><span class="chl-state is-live"><span class="chl-dot" aria-hidden="true"></span>Live now</span><% } else if (st === 'unlocked') { %><span class="chl-state">Unlocked</span><% } else if (st === 'upcoming') { %><span class="chl-state">Upcoming</span><% } %>
          </div>
          <div class="chl-day-card">
            <p class="chl-day-k"><span>Day</span> <b>0<%= n %></b></p>
            <h3><%= d.move %></h3>
            <p class="chl-day-what"><%= d.what %></p>
            <div class="chl-day-have"><span>By tonight you'll have</span><p><%= d.have %></p></div>
          </div>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <!-- FRIDAY: proof, not a plan -->
  <section class="chl-fri" aria-labelledby="chl-fri-h">
    <div class="wrap chl-fri-grid">
      <figure class="chl-fri-photo" data-reveal>
        <img src="/img/wall/eli-popup-02.jpg" alt="Eli talking with a customer at his apparel pop-up" width="480" height="600" loading="lazy">
      </figure>
      <div class="chl-fri-body">
        <h2 class="chl-h2 chl-xl" id="chl-fri-h" data-reveal>Friday night, you'll have proof. <span class="chl-dim">Not a plan.</span></h2>
        <ul class="chl-checks" data-reveal>
          <li><span class="chl-tick" aria-hidden="true"></span>One idea, picked on purpose</li>
          <li><span class="chl-tick" aria-hidden="true"></span>10 real people who have the problem</li>
          <li><span class="chl-tick" aria-hidden="true"></span>A real conversation, in their words</li>
          <li><span class="chl-tick" aria-hidden="true"></span>A one-line offer with a price</li>
          <li><span class="chl-tick" aria-hidden="true"></span>Real answers: yes, no, or "what would make it a yes"</li>
        </ul>
        <p class="chl-fri-note" data-reveal>Or you'll know it's time to switch ideas. That counts as a win too. It's a week instead of a year.</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="chl-how" aria-labelledby="chl-how-h">
    <div class="wrap">
      <h2 class="eyebrow chl-how-h" id="chl-how-h">How it works</h2>
      <div class="chl-how-grid">
        <article class="chl-how-card" data-reveal>
          <figure><img src="/img/wall/morning-coffee.jpg" alt="" width="480" height="600" loading="lazy"></figure>
          <div class="chl-how-body"><h3>Every morning, 8am ET.</h3><p>One email and your own day page: the move, the template and a short video from Eli. About 20 minutes.</p></div>
        </article>
        <article class="chl-how-card" data-reveal>
          <figure><img src="/img/wall/desk-overhead.jpg" alt="" width="480" height="600" loading="lazy"></figure>
          <div class="chl-how-body"><h3>Check in when you're done.</h3><p>One or two lines. Miss a day? Catch up anytime until Sunday night.</p></div>
        </article>
        <article class="chl-how-card" data-reveal>
          <figure><img src="/img/wall/eli-stage-full.jpg" alt="" width="480" height="600" loading="lazy"></figure>
          <div class="chl-how-body"><h3>Two lives with Eli.</h3><p>Kickoff on Monday, November 9, and the debrief on Monday, November 16, the night before doors open. Both at 8pm ET on Instagram <span class="mono">@elichristiansen_</span>. Replays if you can't make it.</p></div>
        </article>
      </div>
    </div>
  </section>

  <!-- FINISHERS -->
  <section class="chl-fin" aria-labelledby="chl-fin-h">
    <div class="wrap chl-fin-grid">
      <div class="chl-badge-wrap" data-reveal>
        <div class="chl-badge" data-tilt>
          <span class="chl-badge-ring" aria-hidden="true"></span>
          <img src="/challenge-assets/img/day-one-badge.svg" alt="The Day One finisher badge" width="240" height="240" loading="lazy">
        </div>
      </div>
      <div class="chl-fin-body">
        <div class="chl-head" data-reveal>
          <p class="eyebrow">Finishers</p>
          <h2 class="chl-h2" id="chl-fin-h"><span class="chl-dim">Finish all five.</span> <span class="chl-steel">Get in first.</span></h2>
        </div>
        <dl class="chl-perks" data-reveal>
          <div><dt>Doors open for you an hour early.</dt><dd>127 opens Tuesday, November 17 at 10am ET. Finishers get in at 9am.</dd></div>
          <div><dt>The Day One badge.</dt><dd>It's waiting in your account, and it's only for people who finished.</dd></div>
          <div><dt>Your week carries over.</dt><dd>Week 1 of your 127 roadmap starts ticked off, and everything you wrote stays on your page. You start at day 6, not day 1.</dd></div>
        </dl>
        <p class="chl-nocatch" data-reveal><b>No catch, no contest.</b> <%= finisherTerms %></p>
      </div>
    </div>
  </section>

  <!-- STRAIGHT ANSWER -->
  <section class="chl-deal" aria-labelledby="chl-deal-h">
    <div class="wrap chl-deal-grid">
      <div class="chl-head chl-deal-head" data-reveal>
        <p class="eyebrow">No catch</p>
        <h2 class="chl-h2" id="chl-deal-h">Here's the whole deal.</h2>
      </div>
      <figure class="chl-mark" aria-hidden="true" data-reveal><img src="/challenge-assets/img/mark-chrome-3d.jpg" alt="" width="1330" height="880" loading="lazy"></figure>
      <div class="chl-letter" data-reveal>
        <p class="chl-letter-lead">The challenge is free, and everything you make is yours.</p>
        <p>On Tuesday, November 17, I'm opening 127: a free roadmap and a membership called Builder with the rest of the playbooks and tools. I'll walk through it in my last challenge email and once on the debrief live, Monday, November 16. <%= price !== null ? 'Founding members get Builder for $' + price + ' a month, locked for as long as they stay.' : 'Founding members get Builder at a lower price, locked for as long as they stay.' %> It's $29 after November 24.</p>
        <p>You don't need to buy anything to do the challenge. You'll get just as much out of the five days either way.</p>
        <p class="signature">Eli</p>
      </div>
    </div>
  </section>

  <!-- WHO'S RUNNING IT -->
  <section class="fx chl-eli" aria-labelledby="chl-eli-h">
    <div class="wrap fx-grid">
      <div class="collage" aria-hidden="true">
        <figure class="cc c1" data-tilt><img src="/img/eli-founder.jpg" alt="" width="800" height="1000" loading="lazy"></figure>
        <figure class="cc c2" data-tilt><img src="/img/wall/eli-finovate-wide.jpg" alt="" width="720" height="480" loading="lazy"><figcaption>Finovate Fall</figcaption></figure>
        <figure class="cc c3" data-tilt><img src="/img/wall/eli-award-night.jpg" alt="" width="480" height="600" loading="lazy"><figcaption>“Most Improved”</figcaption></figure>
        <figure class="cc c4" data-tilt><img src="/img/wall/eli-popup-01.jpg" alt="" width="480" height="600" loading="lazy"><figcaption>Apparel pop-up</figcaption></figure>
      </div>
      <div class="fx-body">
        <h2 class="h2" id="chl-eli-h" data-reveal>I started with $2,000 of sneakers.</h2>
        <ul class="chl-proof" data-reveal>
          <li>2x founder (e-commerce and technology).</li>
          <li>$50K in sales from a part-time e-commerce brand; first drop sold out.</li>
          <li>#3 in the country on a national vendor sales list of 6,000+ agents.</li>
          <li>Left a multiple six-figure corporate job to build full time.</li>
          <li>Won the fintech category at Best of the Midwest (Iowa Startup Week).</li>
          <li>Spoke on stage at Finovate Fall.</li>
        </ul>
        <p class="chl-monday" data-reveal>None of that started with a big moment. It started with a Monday.</p>
        <p class="chl-byline">Eli Christiansen · <span class="mono">@elichristiansen_</span></p>
        <p class="chl-disclaim">Eli's results are his own. They aren't typical or a prediction of yours. <a href="/earnings-disclaimer">Earnings disclaimer</a></p>
      </div>
    </div>
  </section>

  <!-- FOR YOU / NOT FOR YOU -->
  <section class="chl-fit" aria-label="Who it's for">
    <div class="wrap chl-fit-grid">
      <div class="chl-fit-col is-yes" data-reveal>
        <h2 class="chl-fit-h">This is for you if</h2>
        <ul>
          <li>You have an idea (or ten) and haven't talked to one customer.</li>
          <li>You've launched something and nobody's buying yet.</li>
          <li>You want a push and a plan, not another video to save.</li>
        </ul>
      </div>
      <div class="chl-fit-col is-no" data-reveal>
        <h2 class="chl-fit-h">This isn't for you if</h2>
        <ul>
          <li>You want a shortcut to money. There isn't one here.</li>
          <li>You won't give it 20 minutes a day for five days.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="chl-faq" aria-labelledby="chl-faq-h">
    <div class="wrap chl-faq-grid">
      <h2 class="chl-h2" id="chl-faq-h" data-reveal>Good to know.</h2>
      <div class="faq">
        <% faqs.forEach(function (q, i) { %><details<%= i === 0 ? ' open' : '' %>><summary><%= q[0] %></summary><p><%= q[1] %></p></details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="chl-final" aria-labelledby="chl-final-h">
    <div class="chl-reel" aria-hidden="true">
      <div class="reel-row r1"><div class="reel-track"><% reel.concat(reel).forEach(function (n) { %><img src="/img/wall/<%= n %>.jpg" alt="" width="480" height="600" loading="lazy"><% }) %></div></div>
      <div class="reel-row r2"><div class="reel-track"><% reel.slice().reverse().concat(reel.slice().reverse()).forEach(function (n) { %><img src="/img/wall/<%= n %>.jpg" alt="" width="480" height="600" loading="lazy"><% }) %></div></div>
    </div>
    <div class="wrap chl-final-in">
      <% if (live) { %>
      <h2 class="kin chl-stagger chl-final-h" id="chl-final-h" data-reveal><span class="dim"><%- words('Make today', 0) %></span> <span><%- words('day one.', 2) %></span></h2>
      <% } else { %>
      <h2 class="kin chl-stagger chl-final-h" id="chl-final-h" data-reveal><span class="dim"><%- words('Monday is', 0) %></span> <span><%- words('day one.', 2) %></span></h2>
      <% } %>
      <div class="chl-card chl-final-card"><% joinForm('join-final', false) %></div>
      <p class="chl-final-meta"><span>Free</span><span>5 days</span><span>Nov 9 to 13</span></p>
      <p class="chl-verse">Build with purpose. · Psalm 127:1</p>
    </div>
  </section>

  <!-- Phone sticky bar: shows once the hero form is off screen, hides at the final form -->
  <div class="chl-sticky" data-ch-sticky aria-hidden="true">
    <% if (live && dayLive) { %>
    <span class="chl-sticky-k"><span class="chl-dot" aria-hidden="true"></span>Day <%= dayLive %> is live</span>
    <% } else { %>
    <span class="chl-sticky-k">Free · Nov 9 to 13</span>
    <% } %>
    <a href="#join" class="btn light" data-ch-jump tabindex="-1">Join the challenge</a>
  </div>
</main>
<script src="/js/home.js" defer></script>
<script src="/challenge-assets/landing.js" defer></script>
<%- include('../partials/foot') %>

<%- include('../partials/head') %>
<main class="chp">
  <section class="ch-confirm">
    <div class="wrap">
      <div class="lbl">Free 5-day challenge · Nov 9 to 13</div>
      <h1><span class="dim">Join the Day One Challenge<%= firstName ? ',' : '?' %></span><% if (firstName) { %> <span class="grad"><%= firstName %>?</span><% } %></h1>
      <p class="lede">Five days. One move a day, about 20 minutes. By Friday you'll have an idea picked on purpose, real conversations with people who have the problem, and an offer you've put in front of someone.</p>
      <form method="post" action="/challenge/join" style="margin-top:28px;max-width:520px">
        <p class="small-print" style="margin:0 0 6px">Joining as <b><%= email %></b>. You'll get one email a day, Nov 9 to 13.</p>
        <p class="small-print" style="margin:0 0 16px">By joining, you confirm you're 18 or older and agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
        <button class="btn light big">Join the free challenge <span class="arrow"></span></button>
      </form>
      <p class="small-print" style="margin-top:28px">Not you? <a href="/challenge">Join with a different email</a>.</p>
    </div>
  </section>
</main>
<%- include('../partials/foot') %>

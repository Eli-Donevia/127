<%# Invite block (same component as the founding status page). Locals: me, chx %>
<% if (me && me.referral) { var ref = me.referral; var shareText = "I'm doing the Day One Challenge with Eli Christiansen, Nov 9 to 13. 5 days to test a business idea for real. It's free, do it with me: " + ref.link.replace(/^https?:\/\//, ''); %>
<div class="card pad-lg share-card">
  <div class="eyebrow">Do it with a friend</div>
  <p style="margin:10px 0 0">It's easier to show up when someone's counting on you. Send them your link:</p>
  <div class="share-link"><code><%= ref.link.replace(/^https?:\/\//, '') %></code><button type="button" class="btn sm" data-copy-text="<%= ref.link %>" data-track="Challenge Invite" data-channel="copy">Copy</button></div>
  <div class="share-row">
    <a class="btn ghost sm" href="sms:?&body=<%= encodeURIComponent(shareText) %>" data-track="Challenge Invite" data-channel="messages">Messages</a>
    <a class="btn ghost sm" href="https://wa.me/?text=<%= encodeURIComponent(shareText) %>" target="_blank" rel="noopener" data-track="Challenge Invite" data-channel="whatsapp">WhatsApp</a>
    <button type="button" class="btn ghost sm" data-copy-text="<%= ref.link %>" data-open="instagram://story-camera" data-track="Challenge Invite" data-channel="instagram">Instagram story</button>
    <a class="btn ghost sm" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(shareText) %>" target="_blank" rel="noopener" data-track="Challenge Invite" data-channel="x">X</a>
  </div>
  <div class="ref-progress">
    <div class="dots"><% for (var i = 0; i < chx.referralsForReward; i++) { %><span class="<%= i < ref.count ? 'on' : '' %>"></span><% } %></div>
    <div>When <%= chx.referralsForReward %> friends confirm with your link by November 24, you get a free month of Builder. <b><%= Math.min(ref.count, chx.referralsForReward) %> of <%= chx.referralsForReward %></b></div>
  </div>
</div>
<% } %>

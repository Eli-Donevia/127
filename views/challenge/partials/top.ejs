<%# Progress row, one dot a day (v2's 14 sit in two rows of 7, one per week). Locals: me, chx, n (current day or null), preview %>
<% var total = (typeof chx !== 'undefined' && chx.total) || 5; %>
<div class="wrap ch-top">
  <ol class="ch-dots<%= total > 7 ? ' is-weeks' : '' %>" aria-label="Your <%= total === 5 ? 'five' : total %> days">
    <% for (var i = 1; i <= total; i++) { var row = me ? me.days[i - 1] : null; var isDone = row && row.done; var unlocked = (row && row.unlocked) || (typeof preview !== 'undefined' && preview); var cls = (isDone ? 'done' : '') + (typeof n !== 'undefined' && n === i ? ' now' : '') + (!unlocked && !isDone ? ' locked' : ''); var num = (i < 10 ? '0' : '') + i; %>
      <li><% if (me) { %><a href="/challenge/day/<%= i %>" class="<%= cls %>" aria-label="Day <%= i %><%= isDone ? ', done' : !unlocked ? ', locked' : '' %>"<%- typeof n !== 'undefined' && n === i ? ' aria-current="page"' : '' %>><%= isDone ? '✓' : num %></a><% } else { %><span class="<%= cls %>"><%= num %></span><% } %></li>
    <% } %>
  </ol>
  <% if (me) { %><a class="me-link" href="/challenge/me">Your page <span class="arrow"></span></a><% } %>
</div>

<style>
/* Day One Challenge cross-promo (founding pages, homepage bar). Brand: near-black, thin borders, lavender-white, signal green for live only. */
.chpr-card{display:block;margin:28px 0 0;padding:22px 24px;border:1px solid var(--line-2,rgba(255,255,255,.12));border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.01));color:var(--ink-2,#c9c9d1);text-decoration:none;text-align:left;transition:border-color .2s,transform .2s}
a.chpr-card:hover{border-color:rgba(232,234,255,.35);transform:translateY(-1px)}
.chpr-lbl{display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted,#8b8b96);margin-bottom:10px}
.chpr-dot{width:7px;height:7px;border-radius:50%;background:#e8eaff;box-shadow:0 0 0 3px rgba(232,234,255,.12);flex:none}
.chpr-live .chpr-dot{background:#3ddc84;box-shadow:0 0 0 3px rgba(61,220,132,.18);animation:chprPulse 1.6s ease-in-out infinite}
@keyframes chprPulse{50%{box-shadow:0 0 0 6px rgba(61,220,132,0)}}
.chpr-card h3{margin:0 0 6px;font-size:20px;line-height:1.25;font-weight:600;letter-spacing:-.01em;color:var(--ink,#f4f4f6)}
.chpr-card p{margin:0;font-size:15px;line-height:1.55}
.chpr-go{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-size:14px;font-weight:500;color:#e8eaff}
.chpr-card form{margin-top:16px}
.chpr-card .chpr-small{font-size:13px;line-height:1.5;color:var(--muted,#8b8b96);margin:0 0 8px}
.chpr-card .chpr-small a{color:inherit;text-decoration:underline}
.chpr-bar{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;padding:10px 16px;border-bottom:1px solid rgba(232,234,255,.12);background:linear-gradient(90deg,rgba(232,234,255,.03),rgba(232,234,255,.08),rgba(232,234,255,.03));color:var(--ink,#f4f4f6);font-size:14px;line-height:1.35;text-decoration:none;text-align:center}
.chpr-bar b{font-weight:500}
.chpr-bar .chpr-go{margin:0;color:#e8eaff}
.chpr-bar:hover .chpr-go{text-decoration:underline}
@media (prefers-reduced-motion:reduce){.chpr-live .chpr-dot{animation:none}a.chpr-card:hover{transform:none}}
@media (max-width:480px){.chpr-card{padding:18px}.chpr-card h3{font-size:18px}.chpr-bar{font-size:13px;gap:6px}}
</style>

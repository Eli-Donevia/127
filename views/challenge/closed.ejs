<%
  // /challenge after registration closes: 'closed' (Fri 13 Nov noon ET to doors open) and 'after' (doors open).
  // Copy: conversion/challenge/landing-page.md §5.
  var C = (typeof ch !== 'undefined' && ch) || {};
  var after = C.phase === 'after';
  var pNum = parseFloat(C.foundingPrice);
  var price = C.foundingPrice !== null && C.foundingPrice !== undefined && C.foundingPrice !== '' && isFinite(pNum) ? pNum : null;
  // Make sure the challenge stylesheet is on the page even if the route didn't pass it.
  var chCss = [].concat(typeof css !== 'undefined' && css ? css : []);
  if (chCss.indexOf('/challenge-assets/landing.css') === -1) chCss.push('/challenge-assets/landing.css');
  var moves = C.copy ? C.copy.days.map(function (d) { return d.move; }) : ['Pick one.', 'Find 10 people.', 'Have the conversation.', 'Write the offer.', 'Ask for a yes.'];
  var etFmt = function (t, o) { return new Date(t).toLocaleString('en-US', Object.assign({ timeZone: 'America/New_York' }, o)); };
  var wall = [
    ['eli-stage-full', 'morning-coffee', 'eli-popup-02', 'still-timer', 'eli-headphones', 'desk-overhead'],
    // O23: no still-watch (reads as luxury) or eli-plane (travel next to money messaging).
    ['eli-award-night', 'desk-flatlay', 'eli-stockroom-square', 'morning-coffee', 'eli-stage-portrait', 'eli-popup-01'],
    ['eli-stage-portrait', 'hotel-desk', 'eli-gym-portrait', 'bible-open', 'eli-hotel-corner', 'eli-headphones']
  ];
  function words(text, start) {
    return text.split(' ').map(function (w, i) { return '<span style="--i:' + (start + i) + '">' + w.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</span>'; }).join(' ');
  }
%>
<%- include('../partials/head', { css: chCss }) %>
<main class="v4 chl chl-over" data-phase="<%= after ? 'after' : 'closed' %>">
  <section class="hx chl-hero chl-over-hero" aria-labelledby="chl-h1">
    <div class="hx-wall" aria-hidden="true">
      <% wall.forEach(function (col, ci) { %>
      <div class="hx-col c<%= ci %>"><div class="hx-track">
        <% col.concat(col).forEach(function (n) { %><img src="/img/wall/<%= n %>.jpg" alt="" width="480" height="600"<%- ci ? ' loading="lazy"' : '' %>><% }) %>
      </div></div>
      <% }) %>
    </div>
    <div class="wrap chl-over-in">
      <% if (!after) { %>
      <p class="chl-label">The Day One Challenge</p>
      <h1 class="kin chl-stagger" id="chl-h1"><span class="dim"><%- words("This week's challenge", 0) %></span><br><span><%- words('is underway.', 3) %></span></h1>
      <p class="hx-value">Registration closed <%= C.regClosesAt ? etFmt(C.regClosesAt, { weekday: 'long' }) : 'Friday' %> at noon. 127 opens Tuesday, November 17 at 10am ET. If you're at the idea stage, your 30-day roadmap starts where the challenge did.</p>
      <p class="chl-over-live">Watch the <%= C.copy ? 'demo night' : 'debrief' %> live on <%= C.live2At ? etFmt(C.live2At, { weekday: 'long', month: 'long', day: 'numeric' }) : 'Monday, November 16' %> at 8pm ET on Instagram <span class="mono">@elichristiansen_</span>. It's public.</p>
      <div class="hx-ctas"><a href="/founding" class="btn light big">Join the founding list <span class="arrow"></span></a></div>
      <p class="chl-over-note"><%= price !== null ? 'Founding members get Builder at $' + price + '/month, locked for as long as they stay.' : 'Founding members get Builder at a lower price, locked for as long as they stay.' %> $29 after November 24.</p>
      <% } else { %>
      <h1 class="kin chl-stagger" id="chl-h1"><span class="dim"><%- words('The challenge is over.', 0) %></span><br><span><%- words('Your roadmap starts today.', 4) %></span></h1>
      <p class="hx-value">Take the 3-minute assessment and get weeks 1 and 2 of your 30-day roadmap free. If you're at the idea stage, it starts where the challenge did.</p>
      <div class="hx-ctas"><a href="/start?ref=challenge" class="btn light big">Build my free roadmap <span class="arrow"></span></a></div>
      <% } %>

      <ol class="chl-moves<%= after ? ' plus' : '' %>">
        <% moves.forEach(function (m, i) { %><li><b>Day <%= i < 9 ? '0' : '' %><%= i + 1 %></b><span><%= m %></span></li><% }) %>
      </ol>
    </div>
  </section>
</main>
<%- include('../partials/foot') %>

# Copy to .env for local dev. On Replit, add these in the Secrets tab instead.
# Everything is optional: with nothing set, the site runs in demo mode.

# Required in production: 32+ random characters (the server won't start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_EMAILS=you@example.com           # comma-separated; these accounts see /admin once their email is confirmed
JOINS_EXPORT_TOKEN=                    # optional, 24+ random characters. Opens /admin/joins.csv only (counts, no personal data) with header: Authorization: Bearer <token>
BASE_URL=https://127group.io           # used in emails and Stripe redirects
NODE_ENV=                              # set to production on the live deployment (needs SESSION_SECRET)
SHOW_DRAFT_FLAGS=false                 # true shows "draft" labels to everyone (admins always see them)
DEMO_BILLING=false                     # true = free simulated upgrades for testing; ignored in production

# Database (Replit: Tools > Database > create Postgres; it adds DATABASE_URL for you)
DATABASE_URL=

# Stripe. Run `npm run stripe:setup` once (it creates products, prices, coupon, portal
# and prints what to add here). Use a restricted key (rk_) in production if you can.
STRIPE_SECRET_KEY=                     # sk_test_/rk_test_ while testing; NEVER commit a real key
STRIPE_WEBHOOK_SECRET=                 # whsec_ from the endpoint https://127group.io/billing/webhook
STRIPE_AUTOMATIC_TAX=false             # true only after a tax registration is active in Stripe
STRIPE_PORTAL_CONFIGURATION=           # only if the setup script printed one (not needed for the current account)
STRIPE_TERMS_CONSENT=false             # true = Checkout requires the Terms checkbox and shows the renewal wording next to it.
                                       # Set the Terms of Service URL in Stripe Dashboard > Settings > Public details FIRST,
                                       # or Stripe rejects every checkout. Membership Terms Appendix A2.
MEMBERSHIP_TERMS_VERSION=              # version of /membership-terms recorded with each consent (default draft-2026-10-16)
STRIPE_COUPON_WINBACK=                 # optional; default is the winback-first-month coupon (npm run stripe:setup creates it)
# Optional overrides: the app finds prices by lookup key, so these can stay empty.
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_CIRCLE=

# Claude powers the AI tools
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional (lib/ai.js; leave unset for the defaults):
# ANTHROPIC_MODEL_FREE= / ANTHROPIC_MODEL_BUILDER= / ANTHROPIC_MODEL_CIRCLE=   model per plan
# AI_EFFORT_CHAT=low / AI_EFFORT_TOOLS=low / AI_EFFORT_REVIEW=low
# AI_FAIR_USE_FREE=1.5 / AI_FAIR_USE_BUILDER=10 / AI_FAIR_USE_CIRCLE=20       monthly USD before compact mode; 0 turns it off
# AI_FALLBACKS=off                       turns off the server-side retry on a fallback model
# AI_CACHE_TTL=5m                        system prompt cache (default 1h)
# AI_EXCERPTS=0                          send playbook titles only, no playbook text
# IDEA_TEST_MODEL=                       model for the public Idea Test (defaults to ANTHROPIC_MODEL)

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=127 <hello@127group.io>
EMAIL_REPLY_TO=hello@127group.io        # Reply-To on Eli's approved notes and Help receipts (default hello@127group.io)

# Member operations (lib/member-ops.js, ops/members/site-changes/SPEC.md)
OPS_FEED_TOKEN=                         # random 48+ characters; same value in the members heartbeat's cloud environment. Blank = /ops API off (404)
POSTAL_ADDRESS=                         # 127 Group LLC's postal address; commercial notes from Eli refuse to send without it (CAN-SPAM)
WIN_REPLIES=                            # 1 = replies and cheers on wins, plus "First wins" with Reply as Eli in /admin/ops (R19)
# WIN_AI_REPLIES is reserved: AI replies on wins are not built until Eli says yes (members-20261016-ai-win-replies)

# Klaviyo: launch metrics + profile sync; lists only for people who ticked the email box
KLAVIYO_PRIVATE_KEY=
KLAVIYO_WAITLIST_LIST_ID=
KLAVIYO_MEMBERS_LIST_ID=
KLAVIYO_LIST_ID=                        # funnel leads (Founder Score, Day One Stack, Idea Test)

# Launch (all dates ISO). Approved by Eli 2026-10-16: $19/mo locked, doors Tue Nov 17 10am ET,
# founding closes end of Tue Nov 24 ET. Cap and referral reward are still unconfirmed defaults.
PRELAUNCH=true                          # waitlist mode until LAUNCH_AT; set false after doors open
PRELAUNCH_INVITE=                       # /start?invite=this lets testers in during pre-launch
LAUNCH_AT=2026-11-17T15:00:00Z           # Tue Nov 17, 10:00am ET
FOUNDING_CLOSES_AT=2026-11-25T05:00:00Z  # end of Tue Nov 24 ET (pages show Nov 24)
FOUNDING_CAP=100
FOUNDING_PRICE=19                       # shown on pages and used by stripe:setup for the founding price
REFERRALS_FOR_REWARD=3
JOIN_IS_LAUNCH_CONSENT=false             # true = joining the waitlist or a lead magnet counts as consent to launch emails until
                                        # FOUNDING_CLOSES_AT (Legal's wording in lib/consent.js). false = only a ticked box. Eli decides.
CONFIRM_EMAIL_TO_ALL=false               # D15, Eli's call: true = with Klaviyo on, unticked joiners also get the founding confirm link (so their referrals count); the form line switches back to founding-off-v1
FOUNDING_CALL_AT=2026-12-02T01:00:00Z   # founding members' call, Tue Dec 1, 8pm ET: /founding/call.ics and the welcome screen (blank hides it)
FOUNDING_CALL_URL=                      # Zoom/Meet link for that call (sent to Klaviyo as founding_call_url)
MEMBERSHIP_TERMS_LIVE=false                # true once Legal finalizes /membership-terms (adds the footer link, drops the draft banner)
CIRCLE_AGREEMENT_LIVE=false               # true once Legal finalizes /circle-agreement (drops the draft banner)
TRUST_PROXY=1                           # proxy hops in front of the app; see REPLIT-SETUP.md step 5
STRIPE_PRICE_BUILDER_FOUNDING=          # optional; default is the builder_founding_monthly lookup key
STRIPE_COUPON_FOUNDING_REFERRAL=        # optional; default is the founding-referral coupon

# Day One Challenge (all ISO UTC; conversion/challenge/site-spec.md). CHALLENGE_START_AT blank = every challenge
# route 404s and the cross-promo cards hide (kill switch).
CHALLENGE_START_AT=                     # 2026-11-09T13:00:00Z = Day 1 unlocks Mon Nov 9, 8am ET. Leave blank until the /challenge pages ship.
CHALLENGE_REG_CLOSES_AT=2026-11-13T17:00:00Z # sign-ups close, Fri Nov 13, 12pm ET (quiz results switch from A1 to A2)
EARLY_ACCESS_AT=2026-11-17T14:00:00Z        # finishers' early door, Tue Nov 17, 9am ET
CHALLENGE_LIVE_1_AT=2026-11-10T01:00:00Z    # Kickoff live, Mon Nov 9, 8pm ET
CHALLENGE_LIVE_2_AT=2026-11-17T01:00:00Z    # Debrief live, Mon Nov 16, 8pm ET
CHALLENGE_REPLAY_1_URL=                 # Kickoff replay link, blank until it airs; set by Tue Nov 10, 8am ET (before the D2 email).
                                        # /challenge/replay/1 redirects here once set, to /challenge/me until then.
CHALLENGE_REPLAY_2_URL=                 # Debrief replay link; set by Mon Nov 16, 9:15pm ET. /challenge/replay/2 works the same way.

# Demo member for Eli's screen share on the Debrief live (npm run seed:demo; ready by Mon Nov 16, noon ET).
DEMO_EMAIL=demo@example.com             # sign-in email for the demo; must not be a real member's email
DEMO_PASSWORD=                          # optional, 12+ characters; blank = a random one printed once by the script. NEVER commit it.
DEMO_TIER=builder                       # builder shows all 4 weeks and the Library with no upgrade prompts or prices

# Legal pages still in draft (shown with a "Draft for review" banner until Eli approves the text)
COOKIE_NOTICE_LIVE=false                # /cookies (legal/08 Part A; rebuild: node scripts/build-membership-terms.js --cookies)
PRIVACY_LIVE=false                      # /privacy (legal/02; rebuild: --privacy). Ad pixels and Meta server events stay off until PRIVACY_LIVE and COOKIE_NOTICE_LIVE are both true (Legal L43)
TERMS_LIVE=false                        # /terms (legal/01; rebuild: --terms)
EARNINGS_DISCLAIMER_LIVE=false          # /earnings-disclaimer (legal/05 Part A; rebuild: node scripts/build-membership-terms.js --earnings)

# Ad pixels load only after the visitor taps "Accept" in the cookie banner (public/js/consent.js, Legal L7).
# Setting any of these three turns the banner on. Global Privacy Control / Do Not Track count as "Reject".
COOKIE_DOMAIN=.127group.io              # one cookie choice for 127group.io and app.127group.io (leave blank on localhost)
KLAVIYO_PUBLIC_KEY=                     # Klaviyo onsite tracking (6-character public key), also only after Accept

# Day One Challenge (lib/challenge.js). Blank CHALLENGE_START_AT switches the whole challenge off (404s),
# here and in lib/launch.js. lib/challenge.js defaults the other times to the Nov 2026 dates, but
# lib/launch.js and the quiz result pages (lib/funnels.js) don't, so set the five uncommented times.
CHALLENGE_START_AT=2026-11-09T13:00:00Z       # Day 1 unlocks, Mon Nov 9, 8am ET
CHALLENGE_REG_CLOSES_AT=2026-11-13T17:00:00Z  # sign-ups close, Fri Nov 13, 12pm ET
EARLY_ACCESS_AT=2026-11-17T14:00:00Z          # finishers get in, Tue Nov 17, 9am ET
# CHALLENGE_CLOSES_AT=2026-11-16T04:59:59Z    # check-ins close, Sun Nov 15, 11:59pm ET
CHALLENGE_LIVE_1_AT=2026-11-10T01:00:00Z      # kickoff live, Mon Nov 9, 8pm ET
CHALLENGE_LIVE_2_AT=2026-11-17T01:00:00Z      # debrief live, Mon Nov 16, 8pm ET
# CHALLENGE_PROMO_AT=2026-10-26T04:00:00Z     # homepage bar starts
KLAVIYO_CHALLENGE_LIST_ID=                    # "127 Day One Challenge" list; every joiner is added
CHALLENGE_IDEA_TEST_CAP=600                   # Idea Test daily cap on challenge days 1 to 3 (Nov 9 to 11)
COMPANY_ADDRESS=                              # postal address for the challenge email footer (blank leaves it out)
# CHALLENGE_VIDEO_1_URL= ... CHALLENGE_VIDEO_5_URL=, CHALLENGE_REPLAY_1_URL=, CHALLENGE_REPLAY_2_URL= (also set in /admin/challenge)

# Funnel pages (optional)
META_PIXEL_ID=                          # Meta Pixel, only after Accept
TIKTOK_PIXEL_ID=                        # TikTok Pixel, only after Accept
META_CAPI_TOKEN=                        # server-side Lead events (needs META_PIXEL_ID); sent only with ad consent
IDEA_TEST_DAILY_CAP=150
IDEA_TEST_PER_IP=4

# Automation: every event is also POSTed here (Zapier, Make, n8n...)
WEBHOOK_URL=

# Founder's Circle (lib/circle.js). Times are Eastern; dates in CIRCLE_CALL_MOVES/SKIPS are ET calendar days.
CIRCLE_CAPACITY=4
CIRCLE_CALL_URL=                        # Discord link to The Room (the weekly call's voice channel)
CIRCLE_CALL_TIME=Thursdays, 8pm ET (holiday weeks move to Tuesday)   # weekday and time are read from this text
CIRCLE_COMMUNITY_URL=                   # the Circle Discord invite Eli makes (also sent to Klaviyo as circle_discord_url)
CIRCLE_KICKOFF_AT=2026-11-25T01:00:00Z   # Tue Nov 24, 8pm ET: the first call (60 minutes); that week has no Thursday call
CIRCLE_KICKOFF_CLAIM_BY=2026-11-24T23:00:00Z  # Tue Nov 24, 6pm ET: seats claimed by then start at the kickoff
CIRCLE_CALL_MOVES=2026-12-24>2026-12-22,2026-12-31>2026-12-29,2027-11-25>2027-11-23   # holiday weeks move to Tuesday
CIRCLE_CALL_SKIPS=2027-04-22,2027-10-21  # Founder Days weeks: no call
CIRCLE_FIT_CALL_URL=                    # Eli's 127 booking link for 10-minute fit calls (https://)
CIRCLE_CALL_NOTES_WEBHOOK_URL=          # Discord webhook for #call-notes; approved recaps post there
# CIRCLE_DISCORD_WEBHOOK_URL=           # the members SPEC's name for the same webhook; used when CIRCLE_CALL_NOTES_WEBHOOK_URL is blank
CIRCLE_FEED_TOKEN=                      # optional, 32+ characters: the members heartbeat reads /admin/circle/feed.json with it

# 127 HQ (lib/hq.js; product/hub/v1-spec.md)
HQ_LIVE=false                           # true shows HQ to Builders and Circle (nav, dashboard card, /app/hq); false = every HQ route 404s
HQ_SECRET=                              # 32+ random characters. Encrypts members' Stripe keys and Shopify signing keys. Never change it after
                                        # members connect (their saved keys stop working and they must reconnect). Blank = Stripe and Shopify can't connect.
HQ_HARNESS=false                        # true (with HQ_LIVE) adds screenshot drop-in, the Monday check-in email and the AI link (127 in Claude and ChatGPT, /hq/ai/<token>)
# Connections and dashboards (lib/harness/connectors). All off by default. "on" means members only while
# TERMS_LIVE and PRIVACY_LIVE are true; until then it acts as "admins". A connector Legal hasn't cleared
# (CLEARED in lib/harness/connectors/index.js) works for admins only, whatever its switch says.
CONNECTORS=                             # admins | on: the gallery of every app on /app/hq/connect
DASHBOARDS=                             # admins | on: custom dashboards at /app/hq/boards
# One switch per connector, e.g. CONNECTOR_STRIPE, CONNECTOR_SHOPIFY, CONNECTOR_NOTION, CONNECTOR_AIRTABLE,
# CONNECTOR_KLAVIYO, CONNECTOR_MAILCHIMP, CONNECTOR_KIT, CONNECTOR_BEEHIIV, CONNECTOR_CALENDLY,
# CONNECTOR_META_ADS, CONNECTOR_GOOGLE_ADS, CONNECTOR_TIKTOK_ADS, CONNECTOR_GMAIL ... (admins | on)
# Sign-in-with needs 127's own app with each provider: OAUTH_<PROVIDER>_ID and OAUTH_<PROVIDER>_SECRET
# (GOOGLE, META, TIKTOK, TIKTOK_ADS, LINKEDIN, PINTEREST, CANVA, FIGMA, QUICKBOOKS, XERO, SQUARE, PAYPAL,
# GUMROAD, ETSY, SLACK, DISCORD, HUBSPOT, DROPBOX, CALCOM, NETLIFY). Redirect: <BASE_URL>/app/hq/connect/<provider>/callback
GOOGLE_ADS_DEV_TOKEN=                   # Google Ads API developer token (Eli applies); without it Google Ads stays off

# Analytics
PLAUSIBLE_DOMAIN=

# Homepage intro video (or drop public/video/intro.mp4)
HOME_VIDEO_URL=
HOME_VIDEO_POSTER=
HERO_MOBILE=loop                       # phone hero (R29): loop = pre-rendered 3D video (default, lighter), 3d = live WebGL mark
HOME_WHY_STORY=false                   # true shows Eli's "Why I built 127" story on the homepage once he approves it (admins always see it, tagged)
HOME_VIDEO_TITLE=                       # heading over the homepage video (default "On stage at Finovate Fall."); set "Why I built 127." when Eli's clip replaces public/video/intro.mp4

# Copy to .env for local dev. On Replit, add these in the Secrets tab instead.
# Everything is optional: with nothing set, the site runs in demo mode.

# Required in production: 32+ random characters (the server won't start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_EMAILS=you@example.com           # comma-separated; these accounts see /admin once their email is confirmed
BASE_URL=https://127group.io           # used in emails and Stripe redirects
NODE_ENV=                              # set to production on the live deployment (needs SESSION_SECRET)
SHOW_DRAFT_FLAGS=false                 # true shows "draft" labels to everyone (admins always see them)
DEMO_BILLING=false                     # true = free simulated upgrades for testing; ignored in production

# Database (Replit: Tools > Database > create Postgres; it adds DATABASE_URL for you)
DATABASE_URL=

# Stripe. Run `npm run stripe:setup` once (it creates products, prices, coupon, portal
# and prints what to add here). Use a restricted key (rk_) in production if you can.
STRIPE_SECRET_KEY=                     # sk_test_/rk_test_ while testing; NEVER commit a real key
STRIPE_WEBHOOK_SECRET=                 # whsec_ from the endpoint https://127group.io/billing/webhook
STRIPE_AUTOMATIC_TAX=false             # true only after a tax registration is active in Stripe
STRIPE_PORTAL_CONFIGURATION=           # only if the setup script printed one (not needed for the current account)
STRIPE_TERMS_CONSENT=false             # true = Checkout requires the Terms checkbox and shows the renewal wording next to it.
                                       # Set the Terms of Service URL in Stripe Dashboard > Settings > Public details FIRST,
                                       # or Stripe rejects every checkout. Membership Terms Appendix A2.
MEMBERSHIP_TERMS_VERSION=              # version of /membership-terms recorded with each consent (default draft-2026-10-16)
STRIPE_COUPON_WINBACK=                 # optional; default is the winback-first-month coupon (npm run stripe:setup creates it)
# Optional overrides: the app finds prices by lookup key, so these can stay empty.
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_CIRCLE=

# Claude powers the AI tools
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=127 <hello@127group.io>

# Klaviyo: launch metrics + profile sync; lists only for people who ticked the email box
KLAVIYO_PRIVATE_KEY=
KLAVIYO_WAITLIST_LIST_ID=
KLAVIYO_MEMBERS_LIST_ID=
KLAVIYO_LIST_ID=                        # funnel leads (Founder Score, Day One Stack, Idea Test)

# Launch (all dates ISO). Approved by Eli 2026-10-16: $19/mo locked, doors Tue Nov 17 10am ET,
# founding closes end of Tue Nov 24 ET. Cap and referral reward are still unconfirmed defaults.
PRELAUNCH=true                          # waitlist mode until LAUNCH_AT; set false after doors open
PRELAUNCH_INVITE=                       # /start?invite=this lets testers in during pre-launch
LAUNCH_AT=2026-11-17T15:00:00Z           # Tue Nov 17, 10:00am ET
FOUNDING_CLOSES_AT=2026-11-25T05:00:00Z  # end of Tue Nov 24 ET (pages show Nov 24)
FOUNDING_CAP=100
FOUNDING_PRICE=19                       # shown on pages and used by stripe:setup for the founding price
REFERRALS_FOR_REWARD=3
JOIN_IS_LAUNCH_CONSENT=false             # true = joining the waitlist or a lead magnet counts as consent to launch emails until
                                        # FOUNDING_CLOSES_AT (Legal's wording in lib/consent.js). false = only a ticked box. Eli decides.
FOUNDING_CALL_AT=2026-12-02T01:00:00Z   # founding members' call, Tue Dec 1, 8pm ET: /founding/call.ics and the welcome screen (blank hides it)
FOUNDING_CALL_URL=                      # Zoom/Meet link for that call (sent to Klaviyo as founding_call_url)
MEMBERSHIP_TERMS_LIVE=false                # true once Legal finalizes /membership-terms (adds the footer link, drops the draft banner)
TRUST_PROXY=1                           # proxy hops in front of the app; see REPLIT-SETUP.md step 5
STRIPE_PRICE_BUILDER_FOUNDING=          # optional; default is the builder_founding_monthly lookup key
STRIPE_COUPON_FOUNDING_REFERRAL=        # optional; default is the founding-referral coupon
FOUNDING_GRACE_UNTIL=                   # optional; founding grace links work until this (default FOUNDING_CLOSES_AT + 48h = Thu Nov 26, 11:59pm ET)

# Funnel pages (optional)
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
META_CAPI_TOKEN=                        # server-side Lead events (needs META_PIXEL_ID)
IDEA_TEST_DAILY_CAP=150
IDEA_TEST_PER_IP=4

# Automation: every event is also POSTed here (Zapier, Make, n8n...)
WEBHOOK_URL=

# Founder's Circle (lib/circle.js). Times are Eastern; dates in CIRCLE_CALL_MOVES/SKIPS are ET calendar days.
CIRCLE_CAPACITY=4
CIRCLE_CALL_URL=                        # Discord link to The Room (the weekly call's voice channel)
CIRCLE_CALL_TIME=Thursdays, 8pm ET (holiday weeks move to Tuesday)   # weekday and time are read from this text
CIRCLE_COMMUNITY_URL=                   # the Circle Discord invite Eli makes (also sent to Klaviyo as circle_discord_url)
CIRCLE_KICKOFF_AT=2026-11-25T01:00:00Z   # Tue Nov 24, 8pm ET: the first call (60 minutes); that week has no Thursday call
CIRCLE_KICKOFF_CLAIM_BY=2026-11-24T23:00:00Z  # Tue Nov 24, 6pm ET: seats claimed by then start at the kickoff
CIRCLE_CALL_MOVES=2026-12-24>2026-12-22,2026-12-31>2026-12-29,2027-11-25>2027-11-23   # holiday weeks move to Tuesday
CIRCLE_CALL_SKIPS=2027-04-22,2027-10-21  # Founder Days weeks: no call
CIRCLE_FIT_CALL_URL=                    # Eli's 127 booking link for 10-minute fit calls (https://)
CIRCLE_CALL_NOTES_WEBHOOK_URL=          # Discord webhook for #call-notes; approved recaps post there
CIRCLE_FEED_TOKEN=                      # optional, 32+ characters: the members heartbeat reads /admin/circle/feed.json with it

# Analytics
PLAUSIBLE_DOMAIN=

# Homepage intro video (or drop public/video/intro.mp4)
HOME_VIDEO_URL=
HOME_VIDEO_POSTER=

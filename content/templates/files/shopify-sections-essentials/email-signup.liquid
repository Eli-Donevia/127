{% comment %}
  Email signup
  A heading, a short line and an email field that adds the shopper to your Shopify customers
  with marketing consent, using Shopify's own customer form. Shows a thank-you line after signup.
  For Online Store 2.0 themes (Dawn and others). All styles are scoped to this section's id.
{% endcomment %}

{%- assign sx_accent_brightness = section.settings.color_accent | color_brightness -%}
{%- if sx_accent_brightness > 160 -%}
  {%- assign sx_on_accent = '#111111' -%}
{%- else -%}
  {%- assign sx_on_accent = '#ffffff' -%}
{%- endif -%}
{%- assign sx_form_id = 'SxSignup-' | append: section.id -%}

{%- style -%}
  #sx-signup-{{ section.id }} {
    --sx-bg: {{ section.settings.color_background }};
    --sx-fg: {{ section.settings.color_text }};
    --sx-accent: {{ section.settings.color_accent }};
    --sx-on-accent: {{ sx_on_accent }};
    background: var(--sx-bg);
    color: var(--sx-fg);
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #sx-signup-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #sx-signup-{{ section.id }} .sx-signup__card {
    max-width: 760px;
    margin: 0 20px;
    padding: 40px 24px;
    border-radius: {{ section.settings.card_radius }}px;
    text-align: center;
    background: color-mix(in srgb, var(--sx-accent) 8%, var(--sx-bg));
    border: 1px solid color-mix(in srgb, var(--sx-accent) 18%, transparent);
  }
  @media screen and (min-width: 800px) {
    #sx-signup-{{ section.id }} .sx-signup__card { margin: 0 auto; padding: 56px 64px; }
  }
  #sx-signup-{{ section.id }} .sx-signup__heading {
    margin: 0 0 12px;
    font-family: var(--font-heading-family, inherit);
    font-weight: var(--font-heading-weight, 600);
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.12;
    letter-spacing: -.02em;
    color: var(--sx-fg);
  }
  #sx-signup-{{ section.id }} .sx-signup__text { margin: 0 auto 28px; max-width: 34em; font-size: 16px; line-height: 1.6; opacity: .82; }
  #sx-signup-{{ section.id }} .sx-signup__text p { margin: 0; }
  #sx-signup-{{ section.id }} .sx-signup__field {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 480px;
    margin: 0 auto;
  }
  @media screen and (min-width: 600px) {
    #sx-signup-{{ section.id }} .sx-signup__field {
      flex-direction: row;
      padding: 6px;
      gap: 6px;
      border-radius: {{ section.settings.button_radius }}px;
      background: #ffffff;
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--sx-fg) 14%, transparent), 0 14px 34px -22px rgba(0, 0, 0, .5);
    }
  }
  #sx-signup-{{ section.id }} .sx-signup__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    padding: 0 18px;
    border: 1px solid color-mix(in srgb, var(--sx-fg) 18%, transparent);
    border-radius: {{ section.settings.button_radius }}px;
    background: #ffffff;
    color: #111111;
    font: inherit;
    font-size: 16px;
  }
  @media screen and (min-width: 600px) {
    #sx-signup-{{ section.id }} .sx-signup__input { border-color: transparent; }
  }
  #sx-signup-{{ section.id }} .sx-signup__input:focus-visible { outline: 2px solid var(--sx-accent); outline-offset: 2px; }
  #sx-signup-{{ section.id }} .sx-signup__button {
    min-height: 48px;
    padding: 0 26px;
    border: 0;
    border-radius: {{ section.settings.button_radius }}px;
    background: var(--sx-accent);
    color: var(--sx-on-accent);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: transform .2s ease, filter .2s ease;
  }
  #sx-signup-{{ section.id }} .sx-signup__button:hover { filter: brightness(1.08); transform: translateY(-1px); }
  #sx-signup-{{ section.id }} .sx-signup__button:focus-visible { outline: 2px solid var(--sx-fg); outline-offset: 3px; }
  #sx-signup-{{ section.id }} .sx-signup__note { margin: 16px auto 0; max-width: 36em; font-size: 13px; line-height: 1.5; opacity: .65; }
  #sx-signup-{{ section.id }} .sx-signup__success { margin: 0; font-size: 17px; font-weight: 600; }
  #sx-signup-{{ section.id }} .sx-signup__error { margin: 12px 0 0; font-size: 14px; color: #b42318; }
  #sx-signup-{{ section.id }} .sx-visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    #sx-signup-{{ section.id }} .sx-signup__button { transition: none; }
    #sx-signup-{{ section.id }} .sx-signup__button:hover { transform: none; }
  }
{%- endstyle -%}

<div id="sx-signup-{{ section.id }}" class="sx-signup">
  <div class="sx-signup__card">
    {%- if section.settings.heading != blank -%}
      <h2 class="sx-signup__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="sx-signup__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- form 'customer', id: sx_form_id, class: 'sx-signup__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="sx-signup__success" role="status">{{ section.settings.success_message }}</p>
      {%- else -%}
        <div class="sx-signup__field">
          <label class="sx-visually-hidden" for="SxSignupEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
          <input
            class="sx-signup__input"
            id="SxSignupEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            required
            placeholder="{{ section.settings.email_label | escape }}"
            {% if form.errors %}aria-invalid="true" aria-describedby="SxSignupError-{{ section.id }}"{% endif %}
          >
          <button class="sx-signup__button" type="submit">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.errors -%}
          <p class="sx-signup__error" id="SxSignupError-{{ section.id }}" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <p class="sx-signup__note">{% if section.settings.note != blank %}{{ section.settings.note }} {% endif %}{{ section.settings.unsubscribe_text | default: 'Unsubscribe anytime.' }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Email signup",
  "tag": "section",
  "class": "sx-section",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get emails from [Your business]" },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Say what people will get and how often.", "default": "<p>New products and notes from the team, only when there's something worth sharing.</p>" },
    { "type": "text", "id": "email_label", "label": "Email field label", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Small print", "default": "By subscribing you agree to get marketing emails from [Your business]." },
    { "type": "text", "id": "unsubscribe_text", "label": "Unsubscribe line", "default": "Unsubscribe anytime.", "info": "Always shown under the form. If you empty it, Unsubscribe anytime. is shown." },
    { "type": "text", "id": "success_message", "label": "Thank-you message", "default": "Thanks for signing up. Check your inbox." },
    { "type": "paragraph", "content": "Signups appear in Customers with email marketing consent and the tag newsletter." },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "button_radius", "label": "Field and button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "color_accent", "label": "Brand color (button and card tint)", "default": "#111111" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Email signup" }
  ]
}
{% endschema %}
